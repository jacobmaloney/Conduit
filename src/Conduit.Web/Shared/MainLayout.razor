@inherits LayoutComponentBase

<PageTitle>Conduit</PageTitle>

<div class="cx-shell">
    <div class="cx-topbar">
        @* Brand lockup — shield + teal "Con" + ink "duit", per the redesign
           canvas. Base-relative href so it stays inside any tenant base path. *@
        <a href="" class="cx-brand">
            <i class="fas fa-shield-alt"></i>
            <span><span class="cx-brand-con">Con</span>duit</span>
        </a>
        <span class="cx-verpill">v1.0.0</span>

        <div class="cx-topbar-spacer"></div>

        <div class="cx-search">
            <i class="fas fa-search"></i>
            <span>Search connections, projects…</span>
        </div>
        <span class="cx-pill cx-pill--ok cx-pill--lg"><span class="cx-pill-dot"></span> Healthy</span>
        <div class="cx-avatar">AD</div>
    </div>

    <div class="cx-body">
        <NavMenu />

        <main class="cx-main">
            @Body
        </main>
    </div>
</div>
