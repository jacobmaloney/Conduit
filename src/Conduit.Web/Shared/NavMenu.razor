@implements IDisposable
@using Conduit.Core.Models
@using Conduit.Core.Services
@using Conduit.DataAccess.Repositories
@using Conduit.Web.Services
@using IdentityCenter.Brand.Components.Navigation
@inject OpenAccessState OpenAccess
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@inject SyncProjectRepository ProjectRepo
@inject TenantRepository TenantRepo

<BrandSidebar PreferenceKey="conduit.sidebar.collapsed">
    @if (ActiveSection == "configure")
    {
        <BrandSidebarHeading Label="Settings" Icon="fas fa-cogs" Section="configure" />
        <div class="ic-nav-group section-configure">
            <BrandNavigationItem Href="configuration" Label="Configuration" Icon="fas fa-gear" Section="configure" Active='@IsActive("configuration")' />
        </div>
    }
    else
    {
        <BrandSidebarHeading Label="Sync" Icon="fas fa-right-left" Section="identity" />
        <div class="ic-nav-group section-identity">
            <BrandNavigationItem Href="" Label="Dashboard" Icon="fas fa-gauge-high" Active='@IsActive("")' />
            <BrandNavigationItem Href="sync-projects" Label="Sync Projects" Icon="fas fa-right-left" Count="@projectCount" Active='@IsActive("sync-projects")' />
            <BrandNavigationItem Href="connected-systems" Label="Connections" Icon="fas fa-plug" Count="@connectionCount" Active='@IsActive("connected-systems")' />
            <BrandNavigationItem Href="schedules" Label="Schedules" Icon="fas fa-calendar-days" Count="@scheduleCount" Active='@IsActive("schedules")' />
            <BrandNavigationItem Href="sync-history" Label="Sync History" Icon="fas fa-clock-rotate-left" Active='@IsActive("sync-history")' />
        </div>
    }
    @if (ShowDevChrome && OpenAccess.IsEnabled)
    {
        <BrandNavigationItem Href="configuration" Label="Open access: portal authentication is off" Icon="fas fa-triangle-exclamation" />
    }
</BrandSidebar>

@code {
    [Parameter] public string ActiveSection { get; set; } = "identity";
    private bool IsActive(string href) {
        var current = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].Trim('/');
        return current.Equals(href, StringComparison.OrdinalIgnoreCase) || (href.Length > 0 && current.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase));
    }

    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => NavigationManager.LocationChanged -= LocationChanged;

    // SCIM-origin chrome (the open-access pill) stays gated to Development.
    private bool ShowDevChrome => Environment.IsDevelopment();

    // Rail count badges. Pulled once on load the same way the dashboard/hub do;
    // any repo failure just leaves the badge off (null) rather than breaking nav.
    private int? projectCount;
    private int? scheduleCount;
    private int? connectionCount;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += LocationChanged;
        try
        {
            var projects = await ProjectRepo.GetAllAsync();
            projectCount = projects.Count;
            scheduleCount = projects.Count(p => !string.IsNullOrWhiteSpace(p.CronSchedule));
        }
        catch { }

        try
        {
            var tenants = await TenantRepo.GetAllAsync(includeInactive: true);
            connectionCount = tenants.Count;
        }
        catch { }
    }
}
