@page "/audit-log"
@attribute [Authorize]
@using Conduit.Web.Services
@using Conduit.Web.Models
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject AuditLogService AuditLogService
@inject NavigationManager Navigation

<PageTitle>Audit Log - Conduit</PageTitle>

<div class="container-fluid">
    <Template1 Title="Audit Log"
               Subtitle="Track all system activities and changes"
               Icon="fas fa-history"
               IconAccent="amber">
        <PrimaryAction>
            <div class="d-flex gap-2">
                <button type="button" class="icb-list-action" @onclick="ToggleFilters">
                    <i class="oi oi-filter"></i> @(showFilters ? "Hide" : "Show") Filters
                </button>
                <button type="button" class="icb-list-action" @onclick="ExportLogs">
                    <i class="oi oi-data-transfer-download"></i> Export
                </button>
            </div>
        </PrimaryAction>
    </Template1>

    @if (statistics != null)
    {
        <BrandStatRow Stats="@StatisticsRow" />
    }

    <BrandListTable TItem="Conduit.Web.Models.AuditLog" Items="@logs" Title="Audit logs"
                    TotalCount="@totalCount" CurrentPage="@currentPage" PageSize="@pageSize"
                    OnPageChanged="LoadLogs" PageSizeOptions="@(new[] { 50 })"
                    State="@(loading ? BrandListState.Loading : BrandListState.Ready)"
                    EmptyMessage="No Audit Logs Found. No audit logs match your current filters."
                    Toolbar="@(showFilters ? AuditFilters : null)">
        <HeaderTemplate>
            <th scope="col">Timestamp</th>
            <th scope="col">Action</th>
            <th scope="col">Resource</th>
            <th scope="col">User</th>
            <th scope="col">IP Address</th>
            <th scope="col">Status</th>
            <th scope="col">Duration</th>
            <th scope="col">Details</th>
        </HeaderTemplate>
        <RowTemplate Context="log">
            <td>
                <small>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss") UTC</small>
            </td>
            <td>
                <BrandBadge Text="@GetActionDisplayName(log.Action)" Tone="@GetActionBadgeClass(log.Action)" Soft="true" />
            </td>
            <td>
                <small>
                    @log.ResourceType
                    @if (!string.IsNullOrEmpty(log.ResourceId))
                    {
                        <br />
                        <code>@log.ResourceId</code>
                    }
                </small>
            </td>
            <td>
                @if (!string.IsNullOrEmpty(log.UserName))
                {
                    <small>@log.UserName</small>
                }
                else if (!string.IsNullOrEmpty(log.UserId))
                {
                    <small><code>@log.UserId</code></small>
                }
                else
                {
                    <small class="text-muted">System</small>
                }
            </td>
            <td>
                <small>@(log.IpAddress ?? "-")</small>
            </td>
            <td>
                @if (log.StatusCode.HasValue)
                {
                    <BrandBadge Text="@log.StatusCode.Value.ToString()" Tone="@GetStatusBadgeClass(log.StatusCode.Value)" Soft="true" />
                }
            </td>
            <td>
                @if (log.Duration.HasValue)
                {
                    <small>@log.Duration.Value.TotalMilliseconds.ToString("F0") ms</small>
                }
            </td>
            <td>
                @if (!string.IsNullOrEmpty(log.Details))
                {
                    <small class="text-muted">@log.Details</small>
                }
            </td>
        </RowTemplate>
    </BrandListTable>
</div>

@code {
    private List<Conduit.Web.Models.AuditLog> logs = new();
    private AuditLogStatistics? statistics;
    private bool loading = true;
    private bool showFilters = false;

    // Pagination
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalCount = 0;
    private int totalPages = 1;

    // Filters
    private DateTime? startDate = DateTime.Today.AddDays(-7);
    private DateTime? endDate = DateTime.Today.AddDays(1);
    private string? selectedAction = "";
    private string? selectedResourceType = "";
    private string? userId = "";

    private IReadOnlyList<BrandStatRow.StatItem> StatisticsRow => new[]
    {
        new BrandStatRow.StatItem("Total Events", statistics!.TotalEvents.ToString("N0"), "text-primary"),
        new BrandStatRow.StatItem("Unique Users", $"{statistics.UniqueUsers}", "text-info"),
        new BrandStatRow.StatItem("Unique IPs", $"{statistics.UniqueIpAddresses}", "text-warning"),
        new BrandStatRow.StatItem("Avg Duration", $"{statistics.AverageDurationMs?.ToString("F0") ?? "0"} ms", "text-success")
    };

    private RenderFragment AuditFilters => @<div class="row g-3">
        <div class="col-md-3">
            <div class="icb-form-field">
                <label class="icb-form-label" for="al-start">Date Range</label>
                <div class="d-flex align-items-center gap-2">
                    <input id="al-start" type="date" class="icb-form-input" @bind="startDate" />
                    <span class="icb-form-help">to</span>
                    <input type="date" class="icb-form-input" @bind="endDate" aria-label="End date" />
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="icb-form-field">
            <label class="icb-form-label" for="al-action">Action</label>
            <select id="al-action" class="icb-form-select" @bind="selectedAction">
                <option value="">All Actions</option>
                <optgroup label="User Actions">
                    <option value="@AuditActions.UserCreated">User Created</option>
                    <option value="@AuditActions.UserUpdated">User Updated</option>
                    <option value="@AuditActions.UserDeleted">User Deleted</option>
                </optgroup>
                <optgroup label="Group Actions">
                    <option value="@AuditActions.GroupCreated">Group Created</option>
                    <option value="@AuditActions.GroupUpdated">Group Updated</option>
                    <option value="@AuditActions.GroupDeleted">Group Deleted</option>
                </optgroup>
                <optgroup label="Authentication">
                    <option value="@AuditActions.LoginSuccess">Login Success</option>
                    <option value="@AuditActions.LoginFailed">Login Failed</option>
                    <option value="@AuditActions.TokenCreated">Token Created</option>
                </optgroup>
            </select>
            </div>
        </div>
        <div class="col-md-2">
            <div class="icb-form-field">
            <label class="icb-form-label" for="al-type">Resource Type</label>
            <select id="al-type" class="icb-form-select" @bind="selectedResourceType">
                <option value="">All Types</option>
                <option value="User">User</option>
                <option value="Group">Group</option>
                <option value="Token">Token</option>
                <option value="System">System</option>
            </select>
            </div>
        </div>
        <div class="col-md-3">
            <div class="icb-form-field">
                <label class="icb-form-label" for="al-user">User ID</label>
                <input id="al-user" type="text" class="icb-form-input" @bind="userId" placeholder="Filter by user ID" />
            </div>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="button" class="icb-list-action icb-list-action-primary w-100" @onclick="ApplyFilters">Apply Filters</button>
        </div>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        await LoadLogs(1);
        await LoadStatistics();
    }

    private async Task LoadLogs(int page)
    {
        loading = true;
        currentPage = page;

        try
        {
            var (loadedLogs, count) = await AuditLogService.GetLogsAsync(
                startDate: startDate,
                endDate: endDate,
                action: string.IsNullOrEmpty(selectedAction) ? null : selectedAction,
                resourceType: string.IsNullOrEmpty(selectedResourceType) ? null : selectedResourceType,
                userId: string.IsNullOrEmpty(userId) ? null : userId,
                page: page,
                pageSize: pageSize
            );

            logs = loadedLogs;
            totalCount = count;
            totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading audit logs: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task LoadStatistics()
    {
        try
        {
            statistics = await AuditLogService.GetStatisticsAsync(startDate, endDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading statistics: {ex.Message}");
        }
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task ApplyFilters()
    {
        await LoadLogs(1);
        await LoadStatistics();
    }

    private async Task ExportLogs()
    {
        // In a real app, this would export to CSV or JSON
        await JSRuntime.InvokeVoidAsync("alert", "Export functionality would be implemented here");
    }

    private BrandBadgeTone GetActionBadgeClass(string action)
    {
        return action switch
        {
            var a when a.StartsWith("SCIM_GET") => BrandBadgeTone.Info,
            var a when a.StartsWith("SCIM_POST") => BrandBadgeTone.Success,
            var a when a.StartsWith("SCIM_PUT") => BrandBadgeTone.Info,
            var a when a.StartsWith("SCIM_PATCH") => BrandBadgeTone.Warning,
            var a when a.StartsWith("SCIM_DELETE") => BrandBadgeTone.Danger,
            var a when a.Contains("CREATED") => BrandBadgeTone.Success,
            var a when a.Contains("UPDATED") => BrandBadgeTone.Info,
            var a when a.Contains("DELETED") => BrandBadgeTone.Danger,
            var a when a.Contains("FAILED") => BrandBadgeTone.Danger,
            var a when a.Contains("SUCCESS") => BrandBadgeTone.Success,
            _ => BrandBadgeTone.Neutral
        };
    }

    private BrandBadgeTone GetStatusBadgeClass(int statusCode)
    {
        return statusCode switch
        {
            >= 200 and < 300 => BrandBadgeTone.Success,
            >= 300 and < 400 => BrandBadgeTone.Info,
            >= 400 and < 500 => BrandBadgeTone.Warning,
            >= 500 => BrandBadgeTone.Danger,
            _ => BrandBadgeTone.Neutral
        };
    }

    private string GetActionDisplayName(string action)
    {
        // Special formatting for SCIM connections
        if (action.StartsWith("SCIM_"))
        {
            var method = action.Replace("SCIM_", "");
            return $"SCIM {method}";
        }
        return action.Replace("_", " ");
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
