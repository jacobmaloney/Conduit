<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Deliberately NOT added to Conduit.sln: this is an on-demand export utility,
         kept out of the default solution build. Invoke explicitly (see Program.cs). -->
  </PropertyGroup>

  <!-- Conduit.Web is the only assembly that references all 18 connector projects, so
       the shared AddConduitConnectors registration lives there. Referencing a Web SDK
       project from a console app requires the ASP.NET shared framework reference. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Conduit.Web\Conduit.Web.csproj" />
    <ProjectReference Include="..\..\src\Conduit.Sync\Conduit.Sync.csproj" />
  </ItemGroup>

</Project>
