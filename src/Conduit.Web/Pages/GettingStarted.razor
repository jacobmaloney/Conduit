@page "/getting-started"
@attribute [Authorize]
@using Conduit.DataAccess.Repositories
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject TenantRepository TenantRepo
@inject SyncProjectRepository ProjectRepo
@inject SyncRunRepository RunRepo
@inject PortalAdminRepository AdminRepo
@inject SystemConfigurationRepository Config
@inject NavigationManager Nav

@*
    Getting Started checklist — the post-install onboarding journey (parity with
    IdentityCenter's /admin/setup). The first-run INSTALL wizard lives at /setup
    (SetupService/SetupMiddleware); this page picks up after login and guides the
    operator through connecting systems and running their first sync.

    Each step is auto-marked done from REAL Conduit state, with a manual "Mark done"
    override. Progress + the dismissed flag persist per-instance in SystemConfiguration.
*@

<PageTitle>Getting Started — Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Icon="fas fa-flag-checkered" IconAccent="cyan"
               Title="Get Conduit moving."
               Subtitle="Five steps to your first sync — connect a system, point it at IdentityCenter, map it, and run. Each step checks itself off as you go." />

    @if (!_loaded)
    {
        <div class="text-center py-5" role="status"><i class="fas fa-spinner fa-spin fa-2x" aria-hidden="true"></i><span class="visually-hidden">Loading…</span></div>
    }
    else
    {
        <div class="row">
            <div class="col-xl-8">
                <div class="ic-card mb-4">
                    <div class="ic-card-body">
                        <div class="icb-progress-head">
                            <span class="icb-progress-count">@DoneCount of @TotalCount complete</span>
                            <span class="icb-progress-note">@(AllDone ? "All set — you're ready to sync." : $"{TotalCount - DoneCount} step(s) to go")</span>
                        </div>
                        <div class="icb-progress-steps" role="progressbar" aria-valuemin="0" aria-valuemax="@TotalCount" aria-valuenow="@DoneCount" aria-label="Getting started progress">
                            @foreach (var s in _steps)
                            {
                                <span class="icb-progress-step @(s.Done ? "is-done" : "")"></span>
                            }
                        </div>
                    </div>
                </div>

                <ul class="icb-step-list icb-step-list-lg mb-4">
                    @foreach (var s in _steps)
                    {
                        <li class="icb-step">
                            <span class="icb-step-num @(s.Done ? "is-done" : "")" aria-hidden="true">
                                @if (s.Done)
                                {
                                    <i class="oi oi-check"></i>
                                }
                                else
                                {
                                    @s.Num
                                }
                            </span>
                            <div class="icb-step-body">
                                <div class="icb-step-title">@s.Title</div>
                                <div class="icb-step-message">@s.Desc</div>
                                <div class="icb-step-actions">
                                    <a href="@s.Href" class="ic-btn ic-btn-primary ic-btn-sm">
                                        <i class="@s.Icon" aria-hidden="true"></i>@s.ActionLabel
                                    </a>
                                    @if (s.Done)
                                    {
                                        <BrandBadge Text="Done" Tone="BrandBadgeTone.Success" Compact="true" Icon="oi oi-circle-check" />
                                    }
                                    else
                                    {
                                        <button type="button" class="ic-btn ic-btn-ghost ic-btn-sm" @onclick="() => MarkDone(s)">Mark as done</button>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>

                <div class="icb-form-actions">
                    <a href="/" class="ic-btn ic-btn-ghost ic-btn-sm">Back to dashboard</a>
                    <button type="button" class="ic-btn ic-btn-ghost ic-btn-sm ms-auto" @onclick="Dismiss">
                        Dismiss this checklist
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _loaded;
    private List<StepVm> _steps = new();

    private int DoneCount => _steps.Count(s => s.Done);
    private int TotalCount => _steps.Count;
    private bool AllDone => TotalCount > 0 && DoneCount == TotalCount;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // Auto-detection from real Conduit state. Each signal is defensive: a fresh /
        // un-migrated DB must never crash the page, so a failed probe just reads "not done".
        bool adminSecured = false, sourceConnected = false, icConnected = false, projectCreated = false, syncRan = false;

        try { var admins = await AdminRepo.GetAllAsync(); adminSecured = admins.Any(a => !string.Equals(a.UserName, "Admin", StringComparison.OrdinalIgnoreCase)); } catch { }
        try { var tenants = await TenantRepo.GetAllAsync(true); sourceConnected = tenants.Any(t => t.Id != TenantRepository.DefaultTenantId); } catch { }
        try { icConnected = await TenantRepo.CountIcEntitlementTenantsAsync() > 0; } catch { }
        try { var projects = await ProjectRepo.GetAllAsync(); projectCreated = projects.Count > 0; } catch { }
        try { var runs = await RunRepo.GetRecentAsync(1); syncRan = runs.Count > 0; } catch { }

        var m1 = await GetFlag("GettingStarted.Step1");
        var m2 = await GetFlag("GettingStarted.Step2");
        var m3 = await GetFlag("GettingStarted.Step3");
        var m4 = await GetFlag("GettingStarted.Step4");
        var m5 = await GetFlag("GettingStarted.Step5");

        _steps = new()
        {
            new StepVm(1, "Secure your admin account",
                "Rename the default administrator and set a strong password so nobody can sign in with the out-of-box credentials.",
                "oi oi-lock-locked", "/configuration", "Review admin", adminSecured, m1),
            new StepVm(2, "Connect your first system",
                "Add a source — Active Directory, Entra ID, Okta, Google, SCIM, or the synthetic emulator. Test the bind, then you're connected.",
                "oi oi-plug", "/quick-connect", "Connect a system", sourceConnected, m2),
            new StepVm(3, "Connect IdentityCenter",
                "Point Conduit at IdentityCenter as a sync target (Base URL and an admin API key) so identities and accounts flow into governance.",
                "oi oi-transfer", "/quick-connect", "Connect IdentityCenter", icConnected, m3),
            new StepVm(4, "Map and schedule a sync",
                "Create a sync project: pick source → target, auto-map attributes per object class, and set a schedule.",
                "oi oi-loop-square", "/sync-projects", "Open sync projects", projectCreated, m4),
            new StepVm(5, "Run your first sync",
                "Kick off the project from the Synchronization Center and watch every object read, created, updated, and skipped in real time.",
                "oi oi-media-play", "/synchronization-center", "Run a sync", syncRan, m5),
        };
        _loaded = true;
    }

    private async Task<bool> GetFlag(string key)
    {
        try { return string.Equals(await Config.GetValueAsync(key), "true", StringComparison.OrdinalIgnoreCase); }
        catch { return false; }
    }

    private async Task MarkDone(StepVm s)
    {
        await Config.UpsertAsync($"GettingStarted.Step{s.Num}", "true", "Boolean",
            "Getting Started step manually marked complete.");
        await LoadAsync();
    }

    private async Task Dismiss()
    {
        await Config.UpsertAsync("GettingStarted.Dismissed", "true", "Boolean",
            "Getting Started checklist dismissed by the operator.");
        Nav.NavigateTo("/");
    }

    private sealed record StepVm(int Num, string Title, string Desc, string Icon, string Href, string ActionLabel, bool AutoDone, bool ManualDone)
    {
        public bool Done => AutoDone || ManualDone;
    }
}
