@page "/admin/portal-admins"
@attribute [Authorize]
@using System.Security.Claims
@using Conduit.DataAccess
@using Conduit.DataAccess.Repositories
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Components.Modals
@using IdentityCenter.Brand.Models
@inject PortalAdminRepository AdminRepo
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JSRuntime

<PageTitle>Portal Admins - Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Icon="oi oi-people" IconAccent="slate"
               Title="Portal Admins"
               Subtitle="Who can sign in to this Conduit portal — locally or via single sign-on.">
        <PrimaryAction>
            <button type="button" class="ic-btn ic-btn-primary" @onclick="OpenCreate">
                <i class="oi oi-plus" aria-hidden="true"></i> Add admin
            </button>
        </PrimaryAction>
    </Template1>

    <div class="icb-notice icb-notice-info mb-3">
        <i class="oi oi-info" aria-hidden="true"></i>
        <div class="icb-notice-body">
            Single sign-on maps to the accounts on this page by <strong>username or email</strong> — it never
            creates accounts, so an admin must exist here before their IdP login works. Providers are managed
            under <a href="/admin/identity-providers">Identity Providers</a>. The last active admin can never
            be deactivated or deleted.
        </div>
    </div>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="icb-notice @(actionOk ? "icb-notice-success" : "icb-notice-danger") mb-3" role="status">
            <i class="oi @(actionOk ? "oi-check" : "oi-warning")" aria-hidden="true"></i>
            <div class="icb-notice-body">@actionMessage</div>
            <button type="button" class="icb-notice-dismiss" aria-label="Dismiss" @onclick="() => actionMessage = null">&times;</button>
        </div>
    }

    <BrandListTable TItem="PortalAdmin" Title="Portal admins" Items="@admins" TotalCount="@admins.Count"
                    PageSize="@Math.Max(1, admins.Count)" State="@(loading ? BrandListState.Loading : BrandListState.Ready)"
                    EmptyMessage="No portal admins.">
        <HeaderTemplate>
            <th scope="col">Username</th><th scope="col">Display name</th><th scope="col">Status</th>
            <th scope="col">Last login</th><th scope="col">Created</th><th scope="col">Actions</th>
        </HeaderTemplate>
        <RowTemplate Context="a">
            <td class="nm-cell">
                <strong>@a.UserName</strong>
                @if (IsSelf(a))
                {
                    <BrandBadge Text="you" Tone="BrandBadgeTone.Info" Soft="true" Compact="true" />
                }
            </td>
            <td>@(a.DisplayName ?? "—")</td>
            <td>
                @if (a.Active)
                {
                    <BrandBadge Text="Active" Tone="BrandBadgeTone.Success" Soft="true" />
                }
                else
                {
                    <BrandBadge Text="Inactive" Tone="BrandBadgeTone.Neutral" Soft="true" />
                }
            </td>
            <td><small class="text-muted">@(a.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "never")</small></td>
            <td><small class="text-muted">@a.Created.ToString("yyyy-MM-dd")</small></td>
            <td>
                <div class="icb-table-actions">
                    <button type="button" class="ic-btn ic-btn-ghost ic-btn-sm" @onclick="() => OpenResetPassword(a)">
                        <i class="oi oi-key" aria-hidden="true"></i> Reset password
                    </button>
                    <button type="button" class="ic-btn icb-btn-caution ic-btn-sm" @onclick="() => ToggleActive(a)"
                            disabled="@(IsSelf(a) && a.Active)"
                            title="@(IsSelf(a) && a.Active ? "You cannot deactivate the account you are signed in with." : null)">
                        @(a.Active ? "Deactivate" : "Activate")
                    </button>
                    <button type="button" class="ic-btn ic-btn-danger ic-btn-sm" @onclick="() => DeleteAdmin(a)"
                            disabled="@IsSelf(a)" aria-label="@($"Delete {a.UserName}")"
                            title="@(IsSelf(a) ? "You cannot delete the account you are signed in with." : "Delete")">
                        <i class="oi oi-trash" aria-hidden="true"></i>
                    </button>
                </div>
            </td>
        </RowTemplate>
    </BrandListTable>

    <BrandConfirmationModal @ref="confirmModal" ConfirmLabel="Delete" />
</div>

@if (showModal)
{
    <BrandEditorDialog Label="@(resetTarget == null ? "Add admin" : $"Reset password — {resetTarget.UserName}")">
        <HeaderContent>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="icb-editor-title mb-1">
                        <i class="oi @(resetTarget == null ? "oi-person" : "oi-key") me-2" aria-hidden="true"></i>
                        <span>@(resetTarget == null ? "Add admin" : $"Reset password — {resetTarget.UserName}")</span>
                    </h1>
                    <p class="icb-editor-subtitle mb-0">@(resetTarget == null ? "A local sign-in for this portal; SSO matches on the username." : "Sets a new local password for this admin.")</p>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <button type="button" class="ic-btn ic-btn-ghost" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="ic-btn ic-btn-primary" @onclick="SaveModal" disabled="@saving">
                        @(resetTarget == null ? "Create admin" : "Set password")
                    </button>
                </div>
            </div>
        </HeaderContent>
        <ChildContent>
            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="icb-notice icb-notice-danger mb-3" role="alert"><div class="icb-notice-body">@formError</div></div>
            }
            <form>
                <div class="icb-settings-grid">
                    @if (resetTarget == null)
                    {
                        <div class="icb-form-field">
                            <label class="icb-form-label" for="adminUserName">Username *</label>
                            <input id="adminUserName" type="text" class="icb-form-input" @bind="formUserName" placeholder="e.g., jane or jane@contoso.com" />
                            <span class="icb-form-help">Or email — SSO matches on this value.</span>
                        </div>
                        <div class="icb-form-field">
                            <label class="icb-form-label" for="adminDisplayName">Display name</label>
                            <input id="adminDisplayName" type="text" class="icb-form-input" @bind="formDisplayName" placeholder="e.g., Jane Doe" />
                        </div>
                    }
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="adminPassword">Password *</label>
                        <input id="adminPassword" type="password" class="icb-form-input" @bind="formPassword" autocomplete="new-password" />
                        <span class="icb-form-help">Minimum 8 characters.</span>
                    </div>
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="adminPasswordConfirm">Confirm password *</label>
                        <input id="adminPasswordConfirm" type="password" class="icb-form-input" @bind="formPasswordConfirm" autocomplete="new-password" />
                    </div>
                </div>
            </form>
        </ChildContent>
    </BrandEditorDialog>
}

@code {
    private List<PortalAdmin> admins = new();
    private bool loading = true;
    private bool saving;
    private bool showModal;
    private string? actionMessage;
    private bool actionOk;
    private string? formError;
    private string formUserName = "";
    private string formDisplayName = "";
    private string formPassword = "";
    private string formPasswordConfirm = "";
    private PortalAdmin? resetTarget;
    private string? currentUserName;
    private BrandConfirmationModal? confirmModal;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        currentUserName = state.User.FindFirst(ClaimTypes.Name)?.Value ?? state.User.Identity?.Name;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        admins = await AdminRepo.GetAllAsync();
        loading = false;
    }

    private bool IsSelf(PortalAdmin a) =>
        !string.IsNullOrEmpty(currentUserName) &&
        string.Equals(a.UserName, currentUserName, StringComparison.OrdinalIgnoreCase);

    private void OpenCreate()
    {
        resetTarget = null;
        formUserName = ""; formDisplayName = ""; formPassword = ""; formPasswordConfirm = "";
        formError = null;
        showModal = true;
    }

    private void OpenResetPassword(PortalAdmin a)
    {
        resetTarget = a;
        formPassword = ""; formPasswordConfirm = "";
        formError = null;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        resetTarget = null;
    }

    private async Task SaveModal()
    {
        formError = null;

        // Same minimum SetupService enforces for the first admin — one password policy, not two.
        if (string.IsNullOrWhiteSpace(formPassword) || formPassword.Length < 8)
        {
            formError = "Password must be at least 8 characters.";
            return;
        }
        if (!string.Equals(formPassword, formPasswordConfirm, StringComparison.Ordinal))
        {
            formError = "Passwords do not match.";
            return;
        }

        saving = true;
        try
        {
            if (resetTarget == null)
            {
                var userName = formUserName.Trim();
                if (string.IsNullOrWhiteSpace(userName))
                {
                    formError = "Username is required.";
                    return;
                }
                if (await AdminRepo.GetByUserNameAsync(userName) != null)
                {
                    formError = $"An admin named '{userName}' already exists.";
                    return;
                }

                var (hash, salt) = PasswordHasher.Hash(formPassword);
                await AdminRepo.CreateAsync(userName,
                    string.IsNullOrWhiteSpace(formDisplayName) ? null : formDisplayName.Trim(),
                    hash, salt);
                ShowResult(true, $"Admin '{userName}' created. They can sign in locally now — and via SSO once a provider matches this username.");
            }
            else
            {
                var (hash, salt) = PasswordHasher.Hash(formPassword);
                await AdminRepo.UpdatePasswordAsync(resetTarget.Id, hash, salt);
                ShowResult(true, $"Password updated for '{resetTarget.UserName}'.");
            }

            CloseModal();
            await LoadAsync();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleActive(PortalAdmin a)
    {
        // The repository refuses to deactivate the last active admin (returns false) — surface
        // the refusal instead of pretending it worked. Lockout recovery needs host access.
        var ok = await AdminRepo.SetActiveAsync(a.Id, !a.Active);
        if (ok)
            ShowResult(true, $"'{a.UserName}' is now {(!a.Active ? "active" : "inactive")}.");
        else
            ShowResult(false, "Refused: that would leave no active admin able to sign in.");
        await LoadAsync();
    }

    private async Task DeleteAdmin(PortalAdmin a)
    {
        if (confirmModal == null || !await confirmModal.ShowAsync("Delete admin",
            $"Delete admin '{a.UserName}'? This cannot be undone.")) return;

        var ok = await AdminRepo.DeleteAsync(a.Id);
        if (ok)
            ShowResult(true, $"Admin '{a.UserName}' deleted.");
        else
            ShowResult(false, "Refused: that would leave no active admin able to sign in.");
        await LoadAsync();
    }

    private void ShowResult(bool ok, string message)
    {
        actionOk = ok;
        actionMessage = message;
    }
}
