@using Conduit.Core.Models
@using Conduit.Core.Services
@using Conduit.DataAccess.Repositories
@using Conduit.Web.Services
@inject OpenAccessState OpenAccess
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@inject SyncProjectRepository ProjectRepo
@inject TenantRepository TenantRepo

<div class="ic-sidebar">
    @* Open-access warning pill (portal authentication is OFF), Development-gated. *@
    @if (ShowDevChrome && OpenAccess.IsEnabled)
    {
        <a class="open-access-pill" href="configuration" title="Portal authentication is OFF — click to manage in Configuration">
            <i class="fas fa-triangle-exclamation"></i>
            <span>Open access</span>
        </a>
    }

    <nav>
        @* Conduit is a directory-sync engine. The rail is the six load-bearing
           destinations; the old Synchronization Center hub, Quick Connect, API
           Explorer and API Tokens stay routable by URL but are off the rail, and
           the former Settings pages are now tabs inside Configuration. *@
        <div class="ic-nav-group section-identity">
            <div class="ic-nav-group-label">Main</div>
            <NavLink class="ic-nav-item" ActiveClass="on-identity" href="" Match="NavLinkMatch.All">
                <i class="fas fa-gauge-high"></i>
                <span>Dashboard</span>
            </NavLink>
        </div>

        <div class="ic-nav-group section-identity">
            <div class="ic-nav-group-label">Sync</div>
            <NavLink class="ic-nav-item" ActiveClass="on-identity" href="sync-projects">
                <i class="fas fa-right-left"></i>
                <span>Sync Projects</span>
                @if (projectCount is int pc)
                {
                    <span class="ic-nav-badge info">@pc</span>
                }
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-identity" href="connected-systems">
                <i class="fas fa-plug"></i>
                <span>Connections</span>
                @if (connectionCount is int cc)
                {
                    <span class="ic-nav-badge info">@cc</span>
                }
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-identity" href="schedules">
                <i class="fas fa-calendar-days"></i>
                <span>Schedules</span>
                @if (scheduleCount is int sc)
                {
                    <span class="ic-nav-badge info">@sc</span>
                }
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-identity" href="sync-history">
                <i class="fas fa-clock-rotate-left"></i>
                <span>History</span>
            </NavLink>
        </div>

        <div class="ic-nav-group section-identity">
            <div class="ic-nav-group-label">Settings</div>
            <NavLink class="ic-nav-item" ActiveClass="on-identity" href="configuration">
                <i class="fas fa-gear"></i>
                <span>Configuration</span>
            </NavLink>
        </div>
    </nav>

    <div class="ic-sidebar-scope">
        <AuthorizeView>
            <Authorized>
                <div class="mb-2">
                    <strong>Signed in as</strong>
                    @context.User.Identity?.Name
                </div>
                <a class="btn btn-sm btn-outline-secondary w-100" href="/logout">Sign out</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-sm btn-outline-primary w-100" href="/login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
        <div class="mt-2">
            <div>Identity synchronization</div>
            <div>Version 1.0.0</div>
        </div>
    </div>
</div>

@code {
    // SCIM-origin chrome (the open-access pill) stays gated to Development.
    private bool ShowDevChrome => Environment.IsDevelopment();

    // Rail count badges. Pulled once on load the same way the dashboard/hub do;
    // any repo failure just leaves the badge off (null) rather than breaking nav.
    private int? projectCount;
    private int? scheduleCount;
    private int? connectionCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var projects = await ProjectRepo.GetAllAsync();
            projectCount = projects.Count;
            scheduleCount = projects.Count(p => !string.IsNullOrWhiteSpace(p.CronSchedule));
        }
        catch { }

        try
        {
            var tenants = await TenantRepo.GetAllAsync(includeInactive: true);
            connectionCount = tenants.Count;
        }
        catch { }
    }
}
