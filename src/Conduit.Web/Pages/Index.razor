@page "/"
@attribute [Authorize]
@using Conduit.Core.SyncModels
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject Conduit.DataAccess.Repositories.UserRepository UserRepository
@inject Conduit.DataAccess.Repositories.TenantRepository TenantRepo
@inject Conduit.DataAccess.Repositories.SyncProjectRepository ProjectRepo
@inject Conduit.DataAccess.Repositories.SyncRunRepository RunRepo
@inject Conduit.DataAccess.Repositories.SystemConfigurationRepository Config
@inject IWebHostEnvironment Environment

<PageTitle>Conduit — move identities across connected systems.</PageTitle>

<div class="container-fluid">
    <Template1 Title="Dashboard"
               Subtitle="Everything that moves identities, at a glance."
               Icon="fas fa-gauge-high"
               IconAccent="cyan">
        <PrimaryAction>
            <div class="d-flex gap-2">
                <a href="/getting-started" class="icb-list-action"><i class="fas fa-list-check"></i> Getting Started</a>
                <a href="/sync-projects" class="icb-list-action icb-list-action-primary"><i class="fas fa-play"></i> Run All Syncs</a>
            </div>
        </PrimaryAction>
    </Template1>

    @if (_showGettingStarted)
    {
        <div class="icb-notice icb-notice-info align-items-center flex-wrap mb-3" role="alert">
            <i class="fas fa-list-check" aria-hidden="true"></i>
            <div class="icb-notice-body">
                <strong>New to Conduit?</strong> Finish setting up — connect a system, point it at IdentityCenter, and run your first sync.
            </div>
            <div class="d-flex gap-2 align-items-center">
                <a href="/getting-started" class="icb-list-action icb-list-action-primary">Getting Started</a>
                <button type="button" class="icb-list-action" aria-label="Dismiss" @onclick="DismissGettingStarted"><i class="fas fa-xmark" aria-hidden="true"></i></button>
            </div>
        </div>
    }

    <BrandStatRow Stats="@DashboardStats" />

    <div class="row">
        <div class="col-lg-7 mb-3">
            <div class="icb-card-toolbar mb-2">
                <div class="icb-action-bar">
                    <a href="/sync-projects" class="icb-list-action">Open Sync Center →</a>
                </div>
            </div>
            <BrandListPanel TItem="SyncProject" Width="BrandListWidth.Fill" Title="Sync projects"
                            Items="@TopProjects" TotalCount="@projectList.Count" ShowSearch="false" ShowPaging="false">
                <EmptyTemplate>
                    <p>No sync projects yet. <a href="/sync-projects">Create one →</a></p>
                </EmptyTemplate>
                <RowTemplate Context="p">
                    <BrandSummaryRow Title="@p.Name" Subtitle="@ProjectSubtitle(p)" Meta="@LastRunMeta(p)">
                        <Badges>
                            <BrandBadge Text="@StatusText(p.LastRunStatus)" Tone="@StatusTone(p.LastRunStatus)" Dot="true" Soft="true" Compact="true" />
                            <BrandBadge Text="@RunsSummary(p)" Tone="BrandBadgeTone.Success" Soft="true" />
                        </Badges>
                    </BrandSummaryRow>
                </RowTemplate>
                <RowActions Context="p">
                    <a href="/sync-projects" class="icb-list-action icb-list-action-primary"><i class="fas fa-play"></i> Run</a>
                </RowActions>
            </BrandListPanel>
        </div>

        <div class="col-lg-5 mb-3">
            <div class="icb-card-toolbar mb-2">
                <div class="icb-action-bar">
                    <a href="/schedules" class="icb-list-action"><i class="fas fa-clock"></i> Schedules</a>
                    <a href="/sync-history" class="icb-list-action"><i class="fas fa-history"></i> Run history</a>
                </div>
            </div>
            <BrandListPanel TItem="SyncRun" Width="BrandListWidth.Fill" Title="Recent activity"
                            Items="@RecentActivity" TotalCount="@recentRuns.Count" ShowSearch="false" ShowPaging="false"
                            EmptyMessage="No runs recorded yet.">
                <RowTemplate Context="r">
                    <BrandSummaryRow Title="@ProjectName(r.SyncProjectId)" Subtitle="@RunSubtitle(r)" Meta="@RelativeTime(r.CompletedAt ?? r.StartedAt)">
                        <Badges>
                            <BrandBadge Text="@StatusText(r.Status)" Tone="@StatusTone(r.Status)" Dot="true" Soft="true" Compact="true" />
                        </Badges>
                    </BrandSummaryRow>
                </RowTemplate>
            </BrandListPanel>
        </div>
    </div>
</div>

@code {
    private int userCount = 0;
    private int connectionCount = 0;
    private int activeConnectionCount = 0;
    private int projectCount = 0;
    private int enabledProjectCount = 0;
    private int scheduledCount = 0;
    private int failingCount = 0;
    private int runsTodayCount = 0;
    private int failedTodayCount = 0;

    private string? lastRunStatus;
    private DateTime? lastRunWhen;
    private DateTime? nextScheduledRun;

    private List<SyncProject> projectList = new();
    private List<SyncRun> recentRuns = new();
    private Dictionary<Guid, string> tenantNames = new();
    private Dictionary<Guid, string> projectNames = new();

    private bool _showGettingStarted;

    private string EnabledProjectsSub =>
        projectCount > 0 && enabledProjectCount == projectCount ? "all enabled" : $"{enabledProjectCount} enabled";

    private string NextRunLabel => nextScheduledRun is { } n ? n.ToLocalTime().ToString("ddd, h:mm tt") : "No schedule";

    private string LastRunShort => lastRunWhen is { } w ? ShortRelative(w) : "—";
    private string LastRunSub => lastRunWhen is null ? "no runs yet" : $"ago · {(lastRunStatus ?? "unknown").ToLowerInvariant()}";
    private string LastRunValueClass => lastRunStatus switch
    {
        "Completed" or "Succeeded" => "text-success",
        "Failed" or "Error" => "text-muted",
        _ => "text-primary"
    };

    private IReadOnlyList<BrandStatRow.StatItem> DashboardStats => new[]
    {
        new BrandStatRow.StatItem("Total Users", userCount.ToString("N0"), Sub: "across systems"),
        new BrandStatRow.StatItem("Connections", connectionCount.ToString("N0"), Sub: $"{activeConnectionCount} active"),
        new BrandStatRow.StatItem("Sync Projects", projectCount.ToString("N0"), Sub: EnabledProjectsSub),
        new BrandStatRow.StatItem("Runs Today", runsTodayCount.ToString("N0"), runsTodayCount > 0 ? "text-success" : "text-primary", Sub: $"{failedTodayCount} failed"),
        new BrandStatRow.StatItem("Last Run", LastRunShort, LastRunValueClass, Sub: LastRunSub),
        new BrandStatRow.StatItem("Next scheduled run", NextRunLabel, Sub: $"{scheduledCount} schedules · {failingCount} failing", Prominent: true)
    };

    private IReadOnlyList<SyncProject> TopProjects => projectList.Take(6).ToList();
    private IReadOnlyList<SyncRun> RecentActivity => recentRuns.Take(6).ToList();

    protected override async Task OnInitializedAsync()
    {
        try { _showGettingStarted = !string.Equals(await Config.GetValueAsync("GettingStarted.Dismissed"), "true", StringComparison.OrdinalIgnoreCase); }
        catch { _showGettingStarted = false; }

        try
        {
            var (_, count) = await UserRepository.GetAllAsync(new Conduit.Core.Models.ScimQueryOptions { Count = 1 });
            userCount = count;
        }
        catch { userCount = 0; }

        try
        {
            var tenants = await TenantRepo.GetAllAsync(includeInactive: true);
            connectionCount = tenants.Count;
            activeConnectionCount = tenants.Count(t => t.IsActive);
            tenantNames = tenants.ToDictionary(t => t.Id, t => t.Name);
        }
        catch { connectionCount = 0; }

        try
        {
            projectList = await ProjectRepo.GetAllAsync();
            projectCount = projectList.Count;
            enabledProjectCount = projectList.Count(p => p.IsEnabled);
            scheduledCount = projectList.Count(p => !string.IsNullOrWhiteSpace(p.CronSchedule));
            failingCount = projectList.Count(p => p.LastRunStatus == "Failed");
            projectNames = projectList.ToDictionary(p => p.Id, p => p.Name);
            nextScheduledRun = projectList
                .Where(p => p.IsEnabled && p.NextScheduledRunAt.HasValue)
                .Select(p => p.NextScheduledRunAt!.Value)
                .DefaultIfEmpty()
                .Min();
            if (nextScheduledRun == default(DateTime)) nextScheduledRun = null;
        }
        catch { projectList = new(); }

        try
        {
            recentRuns = await RunRepo.GetRecentAsync(take: 200);
            var today = DateTime.UtcNow.Date;
            runsTodayCount = recentRuns.Count(r => r.StartedAt.Date == today);
            failedTodayCount = recentRuns.Count(r => r.StartedAt.Date == today && (r.Status == "Failed" || r.Status == "Error"));
            var latest = recentRuns.OrderByDescending(r => r.CompletedAt ?? r.StartedAt).FirstOrDefault();
            if (latest is not null)
            {
                lastRunStatus = latest.Status;
                lastRunWhen = latest.CompletedAt ?? latest.StartedAt;
            }
        }
        catch { recentRuns = new(); }
    }

    private string TenantName(Guid id) => tenantNames.TryGetValue(id, out var n) ? n : "—";
    private string ProjectName(Guid id) => projectNames.TryGetValue(id, out var n) ? n : "Sync project";

    private string ProjectSubtitle(SyncProject p) => $"{TenantName(p.SourceTenantId)} → {TenantName(p.SinkTenantId)} · {p.ObjectClass}";
    private static string RunsSummary(SyncProject p) => $"{p.SuccessfulRuns}/{p.TotalRuns} runs";
    private static string LastRunMeta(SyncProject p) => p.LastRunAt is { } lr ? RelativeTime(lr) : "never";
    private static string RunSubtitle(SyncRun r) => $"{r.ObjectsRead} read, {r.ObjectsCreated} created, {r.ObjectsUpdated} updated";

    private static BrandBadgeTone StatusTone(string? status) => status switch
    {
        "Completed" or "Succeeded" => BrandBadgeTone.Success,
        "Failed" or "Error" => BrandBadgeTone.Danger,
        "Running" => BrandBadgeTone.Info,
        _ => BrandBadgeTone.Neutral
    };

    private static string StatusText(string? status) => status switch
    {
        "Completed" or "Succeeded" => "OK",
        "Failed" or "Error" => "Failed",
        "Running" => "Running",
        _ => "Idle"
    };

    private static string RelativeTime(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    private static string ShortRelative(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        return $"{(int)span.TotalDays}d";
    }

    private async Task DismissGettingStarted()
    {
        try
        {
            await Config.UpsertAsync("GettingStarted.Dismissed", "true", "Boolean",
                "Getting Started checklist dismissed by the operator.");
        }
        catch { }
        _showGettingStarted = false;
    }
}
