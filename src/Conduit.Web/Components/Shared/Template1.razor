@namespace Conduit.Web.Components.Shared
@using IdentityCenter.Brand.Components.Layout
@* Template1 — compatibility adapter for the shared BrandPageHeader (IdentityCenter.Brand). *@

<BrandPageHeader Title="@Title" Subtitle="@Subtitle" Icon="@Icon" IconAccent="@IconAccent" Stats="@Stats" PrimaryAction="@PrimaryAction" />

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string Icon { get; set; } = "fas fa-cube";
    /// <summary>cyan | teal | violet | amber | slate. Defaults to cyan (Identity).</summary>
    [Parameter] public string IconAccent { get; set; } = "cyan";
    [Parameter] public RenderFragment? Stats { get; set; }
    [Parameter] public RenderFragment? PrimaryAction { get; set; }
}
