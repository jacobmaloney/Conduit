@page "/configuration"
@attribute [Authorize]
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.WebUtilities
@using Conduit.DataAccess
@using Conduit.Web.Authentication
@using Conduit.Web.Services
@using Conduit.Connectors.IdentityCenter
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject IConfiguration Config
@inject NavigationManager Navigation
@inject OpenAccessState OpenAccess
@inject IcAgentStatusService IcAgentStatus
@inject EnrollmentService Enrollment

@*
    Configuration — the settings HOME. Same tabbed-hub pattern as
    Pages/Sync/SynchronizationCenter.razor: Template1 header + BrandFilterTabs, with
    the active tab reflected in ?tab=... Each non-General tab RENDERS AN EXISTING
    SETTINGS PAGE AS A CHILD COMPONENT, so those pages keep their own @page routes
    (deep-links still work) and we touch none of their @code blocks. The General
    tab is this page's original content.
*@

<PageTitle>Configuration - Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Title="Configuration"
               Subtitle="Portal security, identity providers, database, provisioning, and logs — everything that governs this server."
               Icon="fas fa-gear"
               IconAccent="slate" />

    <BrandFilterTabs Tabs="@_tabs"
                     ActiveTab="@activeTab"
                     Label="Configuration section"
                     OnTabChanged="HandleTabChanged" />

    <div>
        @if (activeTab == "identity-providers")
        {
            <IdentityProviders />
        }
        else if (activeTab == "database")
        {
            <DatabaseSettings />
        }
        else if (activeTab == "base-dns")
        {
            <ProvisioningBaseDns />
        }
        else if (activeTab == "audit")
        {
            <Conduit.Web.Pages.AuditLog />
        }
        else if (activeTab == "logs")
        {
            <Logs />
        }
        else
        {
            @* ===== GENERAL ===== *@
            <div class="row">
                <div class="col-lg-8">
                    <!-- Portal Security: open-access toggle -->
                    <div class="ic-card mb-3 @(OpenAccess.IsEnabled ? "icb-card-warning" : "")">
                        <div class="ic-card-hdr">
                            <i class="oi oi-lock-locked" aria-hidden="true"></i>
                            <span class="ic-card-hdr-title">Portal Authentication</span>
                        </div>
                        <div class="ic-card-body">
                            <p class="mb-3 text-muted">
                                Controls whether the portal/web UI requires sign-in. The SCIM, generic REST,
                                SQL emulator, and ARS proxy surfaces are <strong>unaffected</strong> — they
                                always require a <code>scim_</code> bearer token regardless of this setting.
                            </p>

                            <div class="icb-form-check mb-2">
                                @* @bind:get/@bind:set, never checked="@x" + @onchange. When SetAsync THROWS,
                                   OpenAccess.IsEnabled never changes, so the bound value is identical to what it
                                   was before the click and Blazor has nothing to diff — the switch keeps showing
                                   the position the user dragged it to while the setting did not move. On a control
                                   that decides whether the portal requires sign-in, that pixel is a security lie.
                                   With a two-way bind the re-render after the setter re-reads IsEnabled, so a
                                   failed save snaps the switch back to the truth beside its error message. *@
                                <input class="icb-form-switch" type="checkbox" role="switch" id="openAccessToggle"
                                       @bind:get="OpenAccess.IsEnabled"
                                       @bind:set="OnToggleOpenAccess"
                                       disabled="@toggling" />
                                <label class="icb-form-check-label" for="openAccessToggle">
                                    <strong>Open access</strong>
                                    — skip portal login (for demos / local testing only)
                                </label>
                            </div>

                            @if (OpenAccess.IsEnabled)
                            {
                                <div class="icb-notice icb-notice-warning mb-0">
                                    <i class="oi oi-warning" aria-hidden="true"></i>
                                    <div class="icb-notice-body">
                                        <strong>Portal authentication is OFF.</strong>
                                        Anyone reaching this server's portal pages is signed in as admin automatically.
                                        Toggle off before exposing the portal to anything but localhost.
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="small text-muted">
                                    Portal sign-in is required. Manage credentials in the <code>PortalAdmins</code> table or via the Setup wizard.
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(toggleError))
                            {
                                <div class="icb-notice icb-notice-danger mt-2 mb-0"><div class="icb-notice-body">@toggleError</div></div>
                            }
                        </div>
                    </div>

                    <!-- IC Agent enrollment status -->
                    <div class="ic-card mb-3">
                        <div class="ic-card-hdr">
                            <i class="oi oi-rss" aria-hidden="true"></i>
                            <span class="ic-card-hdr-title">IC Agent</span>
                        </div>
                        <div class="ic-card-body">
                            <p class="mb-3 text-muted">
                                Enrollment against IdentityCenter's agent command channel. Identity (name,
                                location, agent id) is assigned server-side when an admin registers this
                                agent in IdentityCenter and mints its per-agent API key; it is read-only here.
                                The keys live in the IdentityCenter connection's credential
                                (<a href="/connected-systems">Connected Systems</a>) — the optional
                                Agent API Key field drives this channel; when it is blank the shared
                                API key is used (legacy mode).
                            </p>

                            <div class="ic-field-grid p-0 mb-3">
                                <div class="ic-field">
                                    <span class="ic-field-label">Instance ID</span>
                                    <span class="ic-field-value mono" id="conduitInstanceId">@instanceId</span>
                                    <div>
                                        <button type="button" class="ic-btn ic-btn-ghost ic-btn-sm" @onclick="CopyInstanceId">
                                            <i class="oi oi-clipboard" aria-hidden="true"></i> @copyInstanceLabel
                                        </button>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        Use this when enrolling this agent in IdentityCenter — paste it into the
                                        <strong>Conduit instance ID</strong> field on IC's Agents page so the minted
                                        key is bound to the same id this agent stamps on synced objects.
                                    </div>
                                </div>
                                <div class="ic-field">
                                    <span class="ic-field-label">Auto-enrollment</span>
                                    <span class="ic-field-value">@Enrollment.StateDescription</span>
                                </div>
                            </div>

                            @if (icAgentEndpoints.Count == 0)
                            {
                                <div class="small text-muted">
                                    No IdentityCenter connection with an API key is configured, or the poller
                                    has not completed its first cycle yet.
                                </div>
                            }
                            else
                            {
                                @foreach (var ep in icAgentEndpoints)
                                {
                                    <div class="ic-field-grid p-0 mb-2">
                                        <div class="ic-field">
                                            <span class="ic-field-label">Server</span>
                                            <span class="ic-field-value mono">@ep.BaseUrl</span>
                                        </div>

                                        <div class="ic-field">
                                            <span class="ic-field-label">API key configured</span>
                                            <span class="ic-field-value">
                                                @if (ep.KeyConfigured)
                                                {
                                                    <BrandBadge Text="Yes" Tone="BrandBadgeTone.Success" Compact="true" />
                                                }
                                                else
                                                {
                                                    <BrandBadge Text="No" Tone="BrandBadgeTone.Neutral" Compact="true" />
                                                }
                                            </span>
                                        </div>

                                        <div class="ic-field">
                                            <span class="ic-field-label">Key source</span>
                                            <span class="ic-field-value">
                                                @if (ep.KeySource == "AgentApiKey")
                                                {
                                                    <BrandBadge Text="Agent API key (per-agent)" Tone="BrandBadgeTone.Success" Compact="true" />
                                                }
                                                else if (ep.KeySource == "ApiKey")
                                                {
                                                    <BrandBadge Text="API key (shared, legacy mode)" Tone="BrandBadgeTone.Warning" Compact="true" />
                                                }
                                                else
                                                {
                                                    <BrandBadge Text="Unknown" Tone="BrandBadgeTone.Neutral" Compact="true" />
                                                }
                                            </span>
                                        </div>

                                        <div class="ic-field">
                                            <span class="ic-field-label">Channel mode</span>
                                            <span class="ic-field-value">
                                                @if (ep.Mode == "Claim")
                                                {
                                                    <BrandBadge Text="Per-agent (claim)" Tone="BrandBadgeTone.Success" Compact="true" />
                                                }
                                                else if (ep.Mode == "Legacy")
                                                {
                                                    <BrandBadge Text="Legacy shared key" Tone="BrandBadgeTone.Warning" Compact="true" />
                                                }
                                                else
                                                {
                                                    <BrandBadge Text="Unknown" Tone="BrandBadgeTone.Neutral" Compact="true" />
                                                }
                                            </span>
                                        </div>

                                        <div class="ic-field">
                                            <span class="ic-field-label">Last heartbeat</span>
                                            <span class="ic-field-value">
                                                @if (ep.LastHeartbeatUtc.HasValue)
                                                {
                                                    @if (ep.LastHeartbeatOk)
                                                    {
                                                        <BrandBadge Text="OK" Tone="BrandBadgeTone.Success" Compact="true" />
                                                    }
                                                    else
                                                    {
                                                        <BrandBadge Text="Failed" Tone="BrandBadgeTone.Danger" Compact="true" />
                                                    }
                                                    <span class="text-muted small ms-1">@ep.LastHeartbeatUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</span>
                                                    @if (!ep.LastHeartbeatOk && !string.IsNullOrEmpty(ep.LastHeartbeatError))
                                                    {
                                                        <span class="text-muted small ms-1">(@ep.LastHeartbeatError)</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">none yet</span>
                                                }
                                            </span>
                                        </div>

                                        @if (ep.AgentId.HasValue)
                                        {
                                            <div class="ic-field">
                                                <span class="ic-field-label">Enrolled as</span>
                                                <span class="ic-field-value">
                                                    <strong>@ep.AgentName</strong>
                                                    @if (!string.IsNullOrEmpty(ep.AgentLocation))
                                                    {
                                                        <span class="text-muted"> — @ep.AgentLocation</span>
                                                    }
                                                </span>
                                                <span class="ic-field-value mono">@ep.AgentId</span>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <!-- Database Configuration -->
                    <div class="ic-card mb-3">
                        <div class="ic-card-hdr">
                            <i class="oi oi-hard-drive" aria-hidden="true"></i>
                            <span class="ic-card-hdr-title">Database Configuration</span>
                        </div>
                        <div class="ic-card-body">
                            <div class="ic-field-grid p-0">
                                <div class="ic-field icb-settings-grid-full">
                                    <span class="ic-field-label">Connection String</span>
                                    <code class="icb-code-block">@MaskConnectionString(Config.GetConnectionString("DefaultConnection") ?? "Not configured")</code>
                                </div>

                                <div class="ic-field">
                                    <span class="ic-field-label">Database Provider</span>
                                    <span class="ic-field-value">SQL Server</span>
                                </div>

                                <div class="ic-field">
                                    <span class="ic-field-label">Connection Status</span>
                                    <span class="ic-field-value">
                                        @if (databaseConnected)
                                        {
                                            <BrandBadge Text="Connected" Tone="BrandBadgeTone.Success" Compact="true" />
                                        }
                                        else
                                        {
                                            <BrandBadge Text="Disconnected" Tone="BrandBadgeTone.Danger" Compact="true" />
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- JWT Configuration -->
                    <div class="ic-card mb-3">
                        <div class="ic-card-hdr">
                            <i class="oi oi-lock-locked" aria-hidden="true"></i>
                            <span class="ic-card-hdr-title">JWT Authentication Configuration</span>
                        </div>
                        <div class="ic-card-body">
                            <div class="ic-field-grid p-0">
                                <div class="ic-field"><span class="ic-field-label">Issuer</span><span class="ic-field-value">@(Config["Jwt:Issuer"] ?? "Not configured")</span></div>
                                <div class="ic-field"><span class="ic-field-label">Audience</span><span class="ic-field-value">@(Config["Jwt:Audience"] ?? "Not configured")</span></div>
                                <div class="ic-field"><span class="ic-field-label">Token Expiration</span><span class="ic-field-value">@(Config["Jwt:ExpirationMinutes"] ?? "60") minutes</span></div>
                                <div class="ic-field"><span class="ic-field-label">Validate Issuer</span><span class="ic-field-value">@(Config["Jwt:ValidateIssuer"] ?? "true")</span></div>
                                <div class="ic-field"><span class="ic-field-label">Validate Audience</span><span class="ic-field-value">@(Config["Jwt:ValidateAudience"] ?? "true")</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- SCIM Configuration -->
                    <div class="ic-card mb-3">
                        <div class="ic-card-hdr">
                            <i class="oi oi-share-boxed" aria-hidden="true"></i>
                            <span class="ic-card-hdr-title">SCIM Configuration</span>
                        </div>
                        <div class="ic-card-body">
                            <div class="ic-field-grid p-0">
                                <div class="ic-field"><span class="ic-field-label">SCIM Version</span><span class="ic-field-value">2.0</span></div>
                                <div class="ic-field"><span class="ic-field-label">Base URL</span><span class="ic-field-value mono">@Navigation.BaseUri</span></div>
                                <div class="ic-field"><span class="ic-field-label">Users Endpoint</span><span class="ic-field-value mono">/scim/v2/Users</span></div>
                                <div class="ic-field"><span class="ic-field-label">Groups Endpoint</span><span class="ic-field-value mono">/scim/v2/Groups</span></div>
                                <div class="ic-field"><span class="ic-field-label">Service Provider Config</span><span class="ic-field-value mono">/scim/v2/ServiceProviderConfig</span></div>
                                <div class="ic-field"><span class="ic-field-label">Resource Types</span><span class="ic-field-value mono">/scim/v2/ResourceTypes</span></div>
                                <div class="ic-field"><span class="ic-field-label">Schemas</span><span class="ic-field-value mono">/scim/v2/Schemas</span></div>
                            </div>
                        </div>
                    </div>

                    <!-- Server Configuration -->
                    <div class="ic-card mb-3">
                        <div class="ic-card-hdr">
                            <i class="oi oi-cog" aria-hidden="true"></i>
                            <span class="ic-card-hdr-title">Server Configuration</span>
                        </div>
                        <div class="ic-card-body">
                            <div class="ic-field-grid p-0">
                                <div class="ic-field"><span class="ic-field-label">Environment</span><span class="ic-field-value">@Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT")</span></div>
                                <div class="ic-field"><span class="ic-field-label">Application Name</span><span class="ic-field-value">Conduit</span></div>
                                <div class="ic-field"><span class="ic-field-label">Version</span><span class="ic-field-value">1.0.0</span></div>
                                <div class="ic-field"><span class="ic-field-label">CORS Policy</span><span class="ic-field-value">Enabled (Allow All Origins)</span></div>
                                <div class="ic-field"><span class="ic-field-label">HTTPS Redirection</span><span class="ic-field-value">Enabled</span></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Quick Actions -->
                    <div class="ic-card mb-3">
                        <div class="ic-card-hdr">
                            <span class="ic-card-hdr-title">Quick Actions</span>
                        </div>
                        <div class="ic-card-body">
                            <div class="icb-form-actions icb-form-actions-stack">
                                <button type="button" class="ic-btn ic-btn-ghost" @onclick="TestDatabaseConnection" disabled="@testingConnection">
                                    @if (testingConnection)
                                    {
                                        <i class="fas fa-spinner fa-spin me-2" aria-hidden="true"></i>
                                        <span>Testing...</span>
                                    }
                                    else
                                    {
                                        <i class="oi oi-pulse me-2" aria-hidden="true"></i>
                                        <span>Test Database Connection</span>
                                    }
                                </button>
                                <button type="button" class="ic-btn ic-btn-ghost" @onclick="ExportConfiguration">
                                    <i class="oi oi-data-transfer-download" aria-hidden="true"></i> Export Configuration
                                </button>
                                <a href="/configuration?tab=database" class="ic-btn ic-btn-ghost">
                                    <i class="oi oi-hard-drive" aria-hidden="true"></i> Change SQL Server
                                </a>
                                <a href="/setup" class="ic-btn icb-btn-caution">
                                    <i class="oi oi-wrench" aria-hidden="true"></i> Re-run Setup
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Configuration Tips -->
                    <div class="ic-card">
                        <div class="ic-card-hdr">
                            <span class="ic-card-hdr-title">Configuration Tips</span>
                        </div>
                        <div class="ic-card-body">
                            <h6>Security Best Practices:</h6>
                            <ul class="small">
                                <li>Always use HTTPS in production</li>
                                <li>Use strong JWT secret keys</li>
                                <li>Enable JWT validation</li>
                                <li>Restrict CORS origins in production</li>
                                <li>Use encrypted database connections</li>
                            </ul>

                            <h6 class="mt-3">Performance Tips:</h6>
                            <ul class="small mb-0">
                                <li>Adjust token expiration based on usage</li>
                                <li>Enable database connection pooling</li>
                                <li>Monitor database query performance</li>
                                <li>Use appropriate page sizes for SCIM queries</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Configuration Files -->
            <div class="ic-card mt-3">
                <div class="ic-card-hdr">
                    <i class="oi oi-file" aria-hidden="true"></i>
                    <span class="ic-card-hdr-title">Configuration Files</span>
                </div>
                <div class="ic-card-body">
                    <p>Configuration is loaded from the following sources (in order of precedence):</p>
                    <ol>
                        <li>Environment Variables</li>
                        <li>appsettings.{Environment}.json</li>
                        <li>appsettings.json</li>
                        <li>User Secrets (Development only)</li>
                        <li>Command Line Arguments</li>
                    </ol>

                    <div class="icb-notice icb-notice-info mt-3">
                        <i class="oi oi-info" aria-hidden="true"></i>
                        <div class="icb-notice-body"><strong>Note:</strong> To modify configuration, update the appropriate appsettings.json file or set environment variables. Some changes may require restarting the application.</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string activeTab = "general";

    private static readonly IReadOnlyList<BrandFilterTabs.Tab> _tabs = new List<BrandFilterTabs.Tab>
    {
        new("general", "General", null, "fas fa-sliders"),
        new("identity-providers", "Identity Providers", null, "fas fa-id-card"),
        new("database", "Database", null, "fas fa-database"),
        new("base-dns", "AD Base DNs", null, "fas fa-shield-alt"),
        new("audit", "Audit Log", null, "fas fa-list"),
        new("logs", "Debug Logs", null, "fas fa-bug"),
    };

    private bool databaseConnected = false;
    private bool testingConnection = false;

    // Open-access toggle state
    private bool toggling;
    private string toggleError = "";

    private List<IcAgentStatusService.EndpointStatus> icAgentEndpoints = new();

    // This installation's durable provenance id. It is the value an admin pastes into
    // IdentityCenter's enrollment so the minted key's AgentId == this id.
    private string instanceId = ConduitInstanceIdentity.InstanceId.ToString();
    private string copyInstanceLabel = "Copy";

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tab))
        {
            var requested = tab.ToString().ToLowerInvariant();
            if (_tabs.Any(t => t.Key == requested))
            {
                activeTab = requested;
            }
        }

        icAgentEndpoints = IcAgentStatus.Snapshot();
        await TestDatabaseConnection();
    }

    private void HandleTabChanged(string key)
    {
        activeTab = key;
        Navigation.NavigateTo($"/configuration?tab={key}", forceLoad: false, replace: true);
    }

    private async Task CopyInstanceId()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", instanceId);
            copyInstanceLabel = "Copied!";
        }
        catch
        {
            copyInstanceLabel = "Copy failed";
        }
    }

    private async Task OnToggleOpenAccess(bool enable)
    {
        if (toggling) return;
        toggling = true;
        toggleError = "";
        StateHasChanged();
        try
        {
            await OpenAccess.SetAsync(enable);
        }
        catch (Exception ex)
        {
            toggleError = $"Could not save the setting: {ex.Message}";
        }
        finally
        {
            toggling = false;
        }
    }

    private string MaskConnectionString(string connectionString)
    {
        if (string.IsNullOrEmpty(connectionString))
            return connectionString;

        // Mask password in connection string
        var pattern = @"(Password|Pwd|password|pwd)\s*=\s*([^;]+)";
        return System.Text.RegularExpressions.Regex.Replace(connectionString, pattern, "$1=****");
    }

    private async Task TestDatabaseConnection()
    {
        testingConnection = true;
        StateHasChanged();

        try
        {
            // Try to connect to database
            using var connection = new Microsoft.Data.SqlClient.SqlConnection(Config.GetConnectionString("DefaultConnection"));
            await connection.OpenAsync();
            databaseConnected = true;
        }
        catch
        {
            databaseConnected = false;
        }
        finally
        {
            testingConnection = false;
            StateHasChanged();
        }
    }

    private async Task ExportConfiguration()
    {
        // Create configuration export
        var config = new
        {
            Database = new
            {
                Provider = "SQL Server",
                ConnectionString = MaskConnectionString(Config.GetConnectionString("DefaultConnection") ?? "")
            },
            JWT = new
            {
                Issuer = Config["Jwt:Issuer"],
                Audience = Config["Jwt:Audience"],
                ExpirationMinutes = Config["Jwt:ExpirationMinutes"],
                ValidateIssuer = Config["Jwt:ValidateIssuer"],
                ValidateAudience = Config["Jwt:ValidateAudience"]
            },
            SCIM = new
            {
                Version = "2.0",
                BaseUrl = Navigation.BaseUri,
                Endpoints = new
                {
                    Users = "/scim/v2/Users",
                    Groups = "/scim/v2/Groups",
                    ServiceProviderConfig = "/scim/v2/ServiceProviderConfig",
                    ResourceTypes = "/scim/v2/ResourceTypes",
                    Schemas = "/scim/v2/Schemas"
                }
            },
            Server = new
            {
                Environment = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT"),
                Version = "1.0.0",
                CorsEnabled = true,
                HttpsRedirection = true
            }
        };

        var json = System.Text.Json.JsonSerializer.Serialize(config, new System.Text.Json.JsonSerializerOptions
        {
            WriteIndented = true
        });

        // In a real app, you would download this as a file
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
        await JSRuntime.InvokeVoidAsync("alert", "Configuration exported to clipboard!");
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
