@page "/tokens"
@attribute [Authorize]
@using Conduit.Web.Authentication
@using Conduit.Web.Services
@using Conduit.Core.Models
@using Conduit.DataAccess.Repositories
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Components.Modals
@using IdentityCenter.Brand.Models
@inject ApiTokenService ApiTokenService
@inject TenantRepository TenantRepo
@inject NavigationManager Navigation

<PageTitle>API Tokens - Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Icon="oi oi-key" IconAccent="slate"
               Title="API Tokens"
               Subtitle="Manage bearer tokens used by external apps to call the SCIM and Generic REST endpoints.">
        <PrimaryAction>
            <button type="button" class="ic-btn ic-btn-primary" @onclick="ShowCreateTokenModal">
                <i class="oi oi-plus" aria-hidden="true"></i> Create Token
            </button>
        </PrimaryAction>
    </Template1>

    <div class="icb-notice icb-notice-warning mb-3">
        <i class="oi oi-warning" aria-hidden="true"></i>
        <div class="icb-notice-body"><strong>Security Notice:</strong> Treat API tokens like passwords. Never share them or commit them to source control.</div>
    </div>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="icb-notice @(actionOk ? "icb-notice-success" : "icb-notice-danger") mb-3" role="status">
            <i class="oi @(actionOk ? "oi-check" : "oi-warning")" aria-hidden="true"></i>
            <div class="icb-notice-body">@actionMessage</div>
            <button type="button" class="icb-notice-dismiss" aria-label="Dismiss" @onclick="() => actionMessage = null">&times;</button>
        </div>
    }

    @if (schemaError)
    {
        <div class="icb-notice icb-notice-danger mb-3" role="alert">
            <i class="oi oi-warning" aria-hidden="true"></i>
            <div class="icb-notice-body">
                <span class="icb-notice-title">Database Schema Error</span>
                <p>The API Tokens table is missing or has an incorrect schema. This usually happens when using a database created before this feature was added.</p>
                <p class="mb-0">
                    <strong>To fix this:</strong> restart the application — pending migrations are applied automatically at startup.
                    If that doesn't resolve it, re-run <a href="/setup">Setup</a> against a fresh database.
                </p>
            </div>
        </div>
    }

    @if (loading)
    {
        <div class="text-center py-5" role="status">
            <i class="fas fa-spinner fa-spin fa-2x" aria-hidden="true"></i>
            <span class="visually-hidden">Loading...</span>
        </div>
    }
    else if (!tokens.Any())
    {
        <div class="empty-state">
            <h3>No API Tokens</h3>
            <p>You haven't created any API tokens yet.</p>
            <button type="button" class="ic-btn ic-btn-primary" @onclick="ShowCreateTokenModal">
                <i class="oi oi-plus" aria-hidden="true"></i> Create Your First Token
            </button>
        </div>
    }
    else
    {
        <BrandListTable TItem="Conduit.Web.Services.ApiToken" Title="API tokens" Items="@tokens" TotalCount="@tokens.Count"
                        PageSize="@Math.Max(1, tokens.Count)" State="BrandListState.Ready"
                        EmptyMessage="No API tokens.">
            <HeaderTemplate>
                <th scope="col">Name</th><th scope="col">Connected System</th><th scope="col">Scope</th><th scope="col">Created</th>
                <th scope="col">Last Used</th><th scope="col">Expires</th><th scope="col">Status</th><th scope="col">Actions</th>
            </HeaderTemplate>
            <RowTemplate Context="token">
                <td class="nm-cell">
                    <strong>@token.Name</strong>
                    @if (!string.IsNullOrWhiteSpace(token.Description))
                    {
                        <div><small class="text-muted">@token.Description</small></div>
                    }
                </td>
                <td>
                    @if (token.TenantId == null)
                    {
                        <BrandBadge Text="Admin — all systems" Tone="BrandBadgeTone.Neutral" Soft="true" />
                    }
                    else
                    {
                        <span>@TenantNameFor(token.TenantId)</span>
                    }
                </td>
                <td><BrandBadge Text="@(string.IsNullOrEmpty(token.Scope) ? "Tenant" : token.Scope)" Tone="BrandBadgeTone.Info" Soft="true" /></td>
                <td><small>@token.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                <td>
                    @if (token.LastUsedAt.HasValue)
                    {
                        <small>@token.LastUsedAt.Value.ToString("MMM dd, yyyy")</small>
                    }
                    else
                    {
                        <small class="text-muted">Never</small>
                    }
                </td>
                <td>
                    @if (token.ExpiresAt.HasValue)
                    {
                        <small>@token.ExpiresAt.Value.ToString("MMM dd, yyyy")</small>
                    }
                    else
                    {
                        <small class="text-muted">Never</small>
                    }
                </td>
                <td>
                    @if (!token.IsActive)
                    {
                        <BrandBadge Text="Inactive" Tone="BrandBadgeTone.Neutral" Soft="true" />
                    }
                    else if (token.ExpiresAt.HasValue && token.ExpiresAt.Value < DateTime.UtcNow)
                    {
                        <BrandBadge Text="Expired" Tone="BrandBadgeTone.Danger" Soft="true" />
                    }
                    else
                    {
                        <BrandBadge Text="Active" Tone="BrandBadgeTone.Success" Soft="true" />
                    }
                </td>
                <td>
                    <div class="icb-table-actions">
                        @if (token.IsActive && (!token.ExpiresAt.HasValue || token.ExpiresAt.Value > DateTime.UtcNow))
                        {
                            <button type="button" class="ic-btn icb-btn-caution ic-btn-sm" @onclick="() => ToggleToken(token)">
                                <i class="oi oi-ban" aria-hidden="true"></i> Deactivate
                            </button>
                        }
                        else
                        {
                            <button type="button" class="ic-btn icb-btn-caution ic-btn-sm" @onclick="() => ToggleToken(token)">
                                <i class="oi oi-check" aria-hidden="true"></i> Activate
                            </button>
                        }
                        <button type="button" class="ic-btn ic-btn-danger ic-btn-sm" @onclick="() => DeleteToken(token)" aria-label="@($"Delete {token.Name}")" title="Delete">
                            <i class="oi oi-trash" aria-hidden="true"></i>
                        </button>
                    </div>
                </td>
            </RowTemplate>
        </BrandListTable>
    }

    <BrandConfirmationModal @ref="confirmModal" ConfirmLabel="Delete" />
</div>

@if (showCreateModal)
{
    <BrandEditorDialog Label="Create API Token">
        <HeaderContent>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="icb-editor-title mb-1">
                        <i class="oi oi-key me-2" aria-hidden="true"></i>
                        <span>Create API Token</span>
                    </h1>
                    <p class="icb-editor-subtitle mb-0">The raw value is shown once, right after it is minted.</p>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    @if (string.IsNullOrEmpty(generatedToken))
                    {
                        <button type="button" class="ic-btn ic-btn-ghost" @onclick="CloseCreateModal">Cancel</button>
                        <button type="button" class="ic-btn ic-btn-primary" @onclick="CreateToken" disabled="@string.IsNullOrWhiteSpace(newToken.Name)">
                            Create Token
                        </button>
                    }
                    else
                    {
                        <button type="button" class="ic-btn ic-btn-primary" @onclick="CloseCreateModal" disabled="@(!confirmCopied)" title="@(confirmCopied ? "" : "Tick the checkbox below first.")">
                            Done
                        </button>
                    }
                </div>
            </div>
        </HeaderContent>
        <ChildContent>
            <form>
                <div class="icb-settings-grid">
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="tokenName">Token Name *</label>
                        <input id="tokenName" type="text" class="icb-form-input" @bind="newToken.Name" placeholder="e.g., Production API" />
                        <span class="icb-form-help">A descriptive name to identify this token</span>
                    </div>

                    <div class="icb-form-field">
                        <label class="icb-form-label" for="tokenSystem">Connected System *</label>
                        <select id="tokenSystem" class="icb-form-select" @bind="newTokenSystemSelection">
                            <option value="__admin__">Admin — all systems</option>
                            <option value="__arsproxy__">ARS Proxy (for /ars/v1/ inbound)</option>
                            @foreach (var sys in tenants)
                            {
                                <option value="@sys.Id">@sys.Name @(sys.Domain != null ? $"({sys.Domain})" : "")</option>
                            }
                        </select>
                        <span class="icb-form-help">Scopes the token's read/write reach. Admin = full access. ARS Proxy = inbound /ars/v1/ only.</span>
                    </div>

                    <div class="icb-form-field icb-settings-grid-full">
                        <label class="icb-form-label" for="tokenDescription">Description</label>
                        <textarea id="tokenDescription" class="icb-form-textarea" rows="3" @bind="newToken.Description"
                                  placeholder="What will this token be used for?"></textarea>
                    </div>

                    <div class="icb-form-field">
                        <label class="icb-form-label" for="tokenExpiration">Expiration</label>
                        <select id="tokenExpiration" class="icb-form-select" @bind="expirationOption">
                            <option value="never">Never expires</option>
                            <option value="30">30 days</option>
                            <option value="60">60 days</option>
                            <option value="90">90 days</option>
                            <option value="180">180 days</option>
                            <option value="365">1 year</option>
                        </select>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(createError))
                {
                    <div class="icb-notice icb-notice-danger mt-3" role="alert">
                        <i class="oi oi-warning" aria-hidden="true"></i>
                        <div class="icb-notice-body">@createError</div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(generatedToken))
                {
                    <div class="icb-notice icb-notice-success mt-3" role="status">
                        <i class="oi oi-check" aria-hidden="true"></i>
                        <div class="icb-notice-body">
                            <span class="icb-notice-title">Token created — copy it now.</span>
                            <p class="mb-2">The raw value is shown <strong>once</strong>. After this dialog closes only the hash is kept; lose the value and you have to mint a new token.</p>

                            <div class="icb-form-field mb-2">
                                <span class="icb-form-help">Authorization header (this is the full string your client sends):</span>
                                <div class="icb-form-input-group">
                                    <input type="text" id="newTokenHeader" class="icb-form-input icb-form-input-mono" value="Bearer @generatedToken" readonly @onclick="SelectAllOnFocus" />
                                    <button class="ic-btn @(tokenCopied ? "ic-btn-primary" : "ic-btn-ghost")" type="button" @onclick="CopyToken">
                                        <i class="oi oi-clipboard" aria-hidden="true"></i> @(tokenCopied ? "Copied" : "Copy")
                                    </button>
                                </div>
                            </div>

                            <div class="icb-form-field mb-2">
                                <span class="icb-form-help">Raw value only (if you only need the part after <code>Bearer </code>):</span>
                                <input type="text" class="icb-form-input icb-form-input-mono" value="@generatedToken" readonly @onclick="SelectAllOnFocus" />
                            </div>

                            <hr class="icb-form-divider" />

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <button class="ic-btn ic-btn-ghost ic-btn-sm" type="button" @onclick="TestNewToken" disabled="@testInFlight">
                                    @if (testInFlight)
                                    {
                                        <i class="fas fa-spinner fa-spin me-1" aria-hidden="true"></i>
                                        <span>Testing…</span>
                                    }
                                    else
                                    {
                                        <i class="oi oi-pulse" aria-hidden="true"></i>
                                        <span>Test this token now</span>
                                    }
                                </button>
                                <small class="text-muted">Hits <code>/scim/v2/ServiceProviderConfig</code> with this exact header.</small>
                            </div>
                            @if (!string.IsNullOrEmpty(testResult))
                            {
                                <div class="icb-notice @(testOk ? "icb-notice-success" : "icb-notice-danger") mb-2" role="status">
                                    <div class="icb-notice-body">@testResult</div>
                                </div>
                            }

                            <div class="icb-form-check">
                                <input type="checkbox" id="confirmCopied" @bind="confirmCopied" />
                                <label class="icb-form-check-label" for="confirmCopied">
                                    I've copied the token somewhere safe.
                                </label>
                            </div>
                        </div>
                    </div>
                }
            </form>
        </ChildContent>
    </BrandEditorDialog>
}

@code {
    private List<Conduit.Web.Services.ApiToken> tokens = new();
    private List<Tenant> tenants = new();
    private bool loading = true;
    private bool showCreateModal = false;
    private bool schemaError = false;
    private Conduit.Web.Services.ApiToken newToken = new();
    private string generatedToken = "";
    private string expirationOption = "never";
    // "__admin__" | "__arsproxy__" | a tenant Guid string
    private string newTokenSystemSelection = "__admin__";
    private BrandConfirmationModal? confirmModal;

    // Page-level feedback for list actions (toggle / delete) and an in-modal error
    // for create — previously all three swallowed failures to Console only, so the
    // operator saw nothing when an action failed.
    private string? actionMessage;
    private bool actionOk;
    private string? createError;

    private string TenantNameFor(Guid? id)
    {
        if (id == null) return "Admin";
        var t = tenants.FirstOrDefault(x => x.Id == id.Value);
        return t?.Name ?? id.Value.ToString();
    }

    protected override Task OnInitializedAsync()
    {
        // Don't call LoadTokens here during pre-rendering
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadTenants();
            await LoadTokens();
            StateHasChanged(); // Force re-render with loaded data
        }
    }

    private async Task LoadTenants()
    {
        try { tenants = await TenantRepo.GetAllAsync(); }
        catch (Exception ex) { Console.WriteLine($"LoadTenants failed: {ex.Message}"); }
    }

    private async Task LoadTokens()
    {
        loading = true;
        try
        {
            tokens = await ApiTokenService.GetAllTokensAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tokens: {ex.Message}");

            // Check if it's a schema error
            if (ex.Message.Contains("Invalid column name") || ex.Message.Contains("Invalid object name"))
            {
                schemaError = true;
            }

            tokens = new List<Conduit.Web.Services.ApiToken>();
        }
        finally
        {
            loading = false;
        }
    }

    private void ShowCreateTokenModal()
    {
        newToken = new Conduit.Web.Services.ApiToken();
        generatedToken = "";
        expirationOption = "never";
        newTokenSystemSelection = "__admin__";
        tokenCopied = false;
        confirmCopied = false;
        testInFlight = false;
        testOk = false;
        testResult = "";
        createError = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        newToken = new Conduit.Web.Services.ApiToken();
        generatedToken = "";
        tokenCopied = false;
        confirmCopied = false;
        testInFlight = false;
        testOk = false;
        testResult = "";
        createError = null;
    }

    private async Task CreateToken()
    {
        if (string.IsNullOrWhiteSpace(newToken.Name))
        {
            return;
        }

        // Set expiration based on selection
        if (expirationOption != "never")
        {
            newToken.ExpiresAt = DateTime.UtcNow.AddDays(int.Parse(expirationOption));
        }

        try
        {
            Guid? tenantId;
            string scope;
            switch (newTokenSystemSelection)
            {
                case "__admin__":
                    tenantId = null;
                    scope = nameof(ApiTokenScope.Admin);
                    break;
                case "__arsproxy__":
                    tenantId = null;
                    scope = nameof(ApiTokenScope.ArsProxy);
                    break;
                default:
                    tenantId = Guid.Parse(newTokenSystemSelection);
                    scope = nameof(ApiTokenScope.Tenant);
                    break;
            }
            generatedToken = await ApiTokenService.CreateTokenAsync(
                newToken.Name, newToken.Description, newToken.ExpiresAt,
                tenantId, scope, fixedRawValue: null);
            await LoadTokens();
        }
        catch (Exception ex)
        {
            // Surface the failure IN the modal so the operator isn't left staring
            // at a dialog that silently produced no token.
            createError = $"Could not create token: {ex.Message}";
        }
    }

    private async Task ToggleToken(Conduit.Web.Services.ApiToken token)
    {
        actionMessage = null;
        try
        {
            await ApiTokenService.ToggleTokenAsync(token.Id);
            await LoadTokens();
            actionOk = true;
            actionMessage = $"'{token.Name}' {(token.IsActive ? "deactivated" : "activated")}.";
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = $"Could not update '{token.Name}': {ex.Message}";
        }
    }

    private async Task DeleteToken(Conduit.Web.Services.ApiToken token)
    {
        if (confirmModal == null || !await confirmModal.ShowAsync("Delete API token", $"Are you sure you want to delete the token '{token.Name}'?"))
        {
            return;
        }

        actionMessage = null;
        try
        {
            await ApiTokenService.DeleteTokenAsync(token.Id);
            await LoadTokens();
            actionOk = true;
            actionMessage = $"Deleted '{token.Name}'. Any client still using it will now get 401.";
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = $"Could not delete '{token.Name}': {ex.Message}";
        }
    }

    // Post-mint hardening state. The "Done" button stays disabled until confirmCopied
    // is checked. The test runner round-trips the raw value against the local SCIM
    // discovery endpoint so the user can confirm — in the same dialog — that the token
    // they're about to walk away with actually works.
    private bool tokenCopied;
    private bool confirmCopied;
    private bool testInFlight;
    private bool testOk;
    private string testResult = "";

    private async Task CopyToken()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", $"Bearer {generatedToken}");
            tokenCopied = true;
        }
        catch
        {
            // Clipboard API can be denied in embedded contexts — silent best-effort.
        }
    }

    private async Task SelectAllOnFocus(MouseEventArgs _)
    {
        // Convenience: clicking the token field selects the whole value for easy copy.
        // Uses the focused element directly rather than eval() (no string-eval smell,
        // and works under a strict CSP that blocks unsafe-eval).
        try
        {
            await JSRuntime.InvokeVoidAsync("conduitSelectActiveElement");
        }
        catch
        {
            // Selection is a nicety — never let it disrupt the copy flow.
        }
    }

    private async Task TestNewToken()
    {
        if (string.IsNullOrEmpty(generatedToken)) return;
        testInFlight = true;
        testResult = "";
        testOk = false;
        StateHasChanged();
        try
        {
            var baseUrl = Navigation.BaseUri.TrimEnd('/');
            using var client = new HttpClient { BaseAddress = new Uri(baseUrl) };
            client.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", generatedToken);
            var resp = await client.GetAsync("/scim/v2/ServiceProviderConfig");
            testOk = resp.IsSuccessStatusCode;
            testResult = testOk
                ? $"✓ {(int)resp.StatusCode} {resp.ReasonPhrase} — token validated against /scim/v2/ServiceProviderConfig."
                : $"✗ {(int)resp.StatusCode} {resp.ReasonPhrase} — token did NOT validate. Check the value you saved.";
        }
        catch (Exception ex)
        {
            testOk = false;
            testResult = $"✗ Request failed: {ex.Message}";
        }
        finally
        {
            testInFlight = false;
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
