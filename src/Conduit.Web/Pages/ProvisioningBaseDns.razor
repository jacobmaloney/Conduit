@page "/provisioning-base-dns"
@attribute [Authorize]
@using Conduit.DataAccess.Repositories
@using Conduit.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject ICreationBaseDnAllowListRepository Repo
@inject ICreationBaseDnPolicy Policy
@inject Conduit.DataAccess.Repositories.SinkConnectionCredentialMapRepository CredMapRepo
@inject AuditLogService Audit
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor HttpCtx
@inject ILogger<ProvisioningBaseDns> Logger

<PageTitle>AD Creation Base DNs - Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Icon="fas fa-shield-alt" IconAccent="slate"
               Title="AD Creation Base DNs"
               Subtitle="The containment allow-list for AD account creation — customer-owned, on this agent." />

    <div class="icb-notice icb-notice-warning mb-3">
        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
        <div class="icb-notice-body">
            <strong>This is the creation containment control.</strong> An AD account create is only permitted when its
            target OU is <em>contained within</em> one of the base DNs configured here for its connection.
            A connection with <strong>no</strong> permitted base DN <strong>denies every create</strong> (deny-all by default).
            Grant only the OUs where creation is intended — and delegate the bind account "Create User objects" only there.
            These values live on this agent and are never set from IdentityCenter.
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="icb-notice @(messageIsError ? "icb-notice-danger" : "icb-notice-success") mb-3" role="status">
            <i class="@(messageIsError ? "fas fa-circle-exclamation" : "fas fa-circle-check")" aria-hidden="true"></i>
            <div class="icb-notice-body">@message</div>
            <button type="button" class="icb-notice-dismiss" aria-label="Dismiss" @onclick="ClearMessage">&times;</button>
        </div>
    }

    <div class="ic-card mb-4">
        <div class="ic-card-hdr">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span class="ic-card-hdr-title">Add a permitted base DN</span>
        </div>
        <div class="ic-card-body">
            <div class="row g-2 align-items-start">
                <div class="col-md-4">
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="pbd-conn">Connection name</label>
                        <select id="pbd-conn" class="icb-form-select" @bind="newConnectionName">
                            <option value="">-- select a connection --</option>
                            @foreach (var name in connectionOptions)
                            {
                                <option value="@name">@name</option>
                            }
                        </select>
                        <span class="icb-form-help">
                            @if (connectionOptions.Count == 0)
                            {
                                <text>No connections are registered on this agent yet — save an IdentityCenter-targeted sync project so its route appears here.</text>
                            }
                            else
                            {
                                <text>The IdentityCenter connection to provision into (its DirectoryConnections.Name).</text>
                            }
                        </span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="pbd-dn">Permitted base DN</label>
                        <input id="pbd-dn" class="icb-form-input icb-form-input-mono" @bind="newBaseDn" @bind:event="oninput" placeholder="OU=Staff,OU=Users,DC=corp,DC=local" />
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="icb-form-field">
                        <span class="icb-form-label d-none d-md-block">&nbsp;</span>
                        <button type="button" class="ic-btn ic-btn-primary w-100 justify-content-center" @onclick="AddAsync" disabled="@saving">Add</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <p><em>Loading…</em></p>
    }
    else if (connections.Count == 0)
    {
        <div class="icb-notice icb-notice-neutral">
            <div class="icb-notice-body">No provisioning routes are configured on this agent.</div>
        </div>
    }
    else
    {
        @if (!anyEffective)
        {
            <div class="icb-notice icb-notice-warning mb-3">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                <div class="icb-notice-body">Routes exist, but no permitted creation base DN is in effect. Every AD create is currently denied.</div>
            </div>
        }
        @foreach (var conn in connections)
        {
            <div class="ic-card mb-3">
                <div class="ic-card-hdr">
                    <i class="fas fa-plug" aria-hidden="true"></i>
                    <span class="ic-card-hdr-title">@conn.Name</span>
                    <span class="ms-auto">
                        @if (conn.EnforcedSource == BaseDnSource.Database)
                        {
                            <BrandBadge Text="@($"{conn.DbEntries.Count} enforced (database)")" Tone="BrandBadgeTone.Success" Compact="true" />
                        }
                        else if (conn.EnforcedSource == BaseDnSource.Config)
                        {
                            <BrandBadge Text="@($"{conn.ConfigDns.Count} enforced (host config)")" Tone="BrandBadgeTone.Info" Compact="true" />
                        }
                        else
                        {
                            <BrandBadge Text="denied — no permitted base DN" Tone="BrandBadgeTone.Danger" Compact="true" />
                        }
                    </span>
                </div>
                <section class="icb-table-panel" aria-label="@($"Permitted base DNs for {conn.Name}")">
                    <div class="icb-table-scroll" tabindex="0" role="region" aria-label="@($"Permitted base DNs for {conn.Name}")">
                        <table class="icb-data-table">
                            <thead>
                                <tr><th scope="col">Base DN</th><th scope="col">Source</th><th scope="col">Added</th><th scope="col">By</th><th scope="col" class="text-end">Action</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in conn.DbEntries)
                                {
                                    <tr>
                                        <td class="mono">@entry.BaseDn</td>
                                        <td><BrandBadge Text="database (enforced)" Tone="BrandBadgeTone.Success" Compact="true" /></td>
                                        <td>@entry.CreatedAt.ToString("u")</td>
                                        <td>@(entry.CreatedBy ?? "—")</td>
                                        <td class="text-end">
                                            <button type="button" class="ic-btn ic-btn-danger ic-btn-sm" @onclick="() => DeleteAsync(entry.Id)" disabled="@saving">Remove</button>
                                        </td>
                                    </tr>
                                }
                                @foreach (var dn in conn.ConfigDns)
                                {
                                    <tr>
                                        <td class="mono">@dn</td>
                                        <td>
                                            @if (conn.EnforcedSource == BaseDnSource.Config)
                                            {
                                                <span title="Edit in the agent's appsettings"><BrandBadge Text="host config (enforced) — read-only" Tone="BrandBadgeTone.Info" Compact="true" /></span>
                                            }
                                            else
                                            {
                                                <span title="Database entries take precedence; this is not currently enforced"><BrandBadge Text="host config — OVERRIDDEN by database, not enforced" Tone="BrandBadgeTone.Neutral" Compact="true" /></span>
                                            }
                                        </td>
                                        <td colspan="2"><em class="text-muted">from agent host config — edit in appsettings</em></td>
                                        <td class="text-end"><span class="text-muted">—</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        }
    }
</div>

@code {
    private bool loading = true;
    private bool saving = false;
    private string? message;
    private bool messageIsError;

    private string newConnectionName = string.Empty;
    private string newBaseDn = string.Empty;

    private sealed class ConnDisplay
    {
        public string Name { get; set; } = string.Empty;
        public BaseDnSource EnforcedSource { get; set; }
        public List<CreationBaseDnEntry> DbEntries { get; set; } = new();  // editable/removable
        public List<string> ConfigDns { get; set; } = new();              // read-only (host config)
    }

    private List<ConnDisplay> connections = new();
    private List<string> knownConnectionNames = new();
    private List<string> connectionOptions = new();
    private bool anyEffective;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            // DB entries (editable) grouped by connection.
            var dbAll = await Repo.GetAllAsync();
            var dbByConn = dbAll
                .GroupBy(e => e.SourceConnectionName)
                .ToDictionary(g => g.Key, g => g.OrderBy(e => e.BaseDn).ToList());

            // Include routed connections even when they have no allow-list entry. Hiding
            // that state made a valid route look absent instead of correctly "deny-all".
            var mapped = await CredMapRepo.GetAllSourceConnectionNamesAsync();
            var names = dbByConn.Keys
                .Concat(Policy.GetConfiguredConnectionNames())
                .Concat(mapped)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n)
                .ToList();

            connections = new List<ConnDisplay>();
            foreach (var name in names)
            {
                // The ENFORCED source is resolved by the SAME policy the create path uses — displayed == enforced.
                var effective = await Policy.GetEffectiveAsync(name);
                connections.Add(new ConnDisplay
                {
                    Name = name,
                    EnforcedSource = effective.Source,
                    DbEntries = dbByConn.TryGetValue(name, out var e) ? e : new List<CreationBaseDnEntry>(),
                    ConfigDns = Policy.GetConfigBaseDns(name).ToList()
                });
            }

            // Deny-all globally only when NOTHING is in effect anywhere (DB ∪ config empty).
            anyEffective = connections.Any(c => c.EnforcedSource != BaseDnSource.None);
            knownConnectionNames = names;

            // Dropdown options: connections Conduit can actually provision to (those with a registered
            // credential mapping) UNION any already in the allow-list — so an operator picks a real
            // connection name instead of typing a stray value that can never match.
            connectionOptions = mapped
                .Concat(names)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load creation base-DN allow-list.");
            SetError("Failed to load the allow-list. Check the database connection.");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AddAsync()
    {
        var connName = newConnectionName?.Trim() ?? string.Empty;
        var baseDn = newBaseDn?.Trim() ?? string.Empty;

        if (string.IsNullOrEmpty(connName))
        {
            SetError("A connection name is required.");
            return;
        }
        if (string.IsNullOrEmpty(baseDn))
        {
            SetError("A base DN is required.");
            return;
        }
        // Reject a malformed DN at save time — same component-wise parser the containment check uses.
        if (!BaseDnContainment.IsWellFormedDn(baseDn))
        {
            SetError(string.Concat("'", baseDn, "' is not a well-formed distinguished name. Example: OU=Staff,OU=Users,DC=corp,DC=local"));
            return;
        }

        saving = true;
        try
        {
            var userName = await GetUserNameAsync();
            var inserted = await Repo.AddAsync(connName, baseDn, userName);
            if (!inserted)
            {
                SetError(string.Concat("'", baseDn, "' is already permitted for connection '", connName, "'."));
                return;
            }

            await AuditAsync("CreationBaseDnAdded", connName, userName,
                details: string.Concat("Permitted AD creation base DN added for connection '", connName, "'."),
                oldValue: null, newValue: baseDn);

            newBaseDn = string.Empty;
            SetSuccess(string.Concat("Added permitted base DN for '", connName, "'."));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add creation base DN.");
            SetError("Failed to add the base DN. Check the database connection.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        saving = true;
        try
        {
            var entry = await Repo.GetByIdAsync(id);
            var deleted = await Repo.DeleteAsync(id);
            if (deleted && entry is not null)
            {
                var userName = await GetUserNameAsync();
                await AuditAsync("CreationBaseDnRemoved", entry.SourceConnectionName, userName,
                    details: string.Concat("Permitted AD creation base DN removed from connection '", entry.SourceConnectionName, "'."),
                    oldValue: entry.BaseDn, newValue: null);
                SetSuccess("Removed permitted base DN.");
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove creation base DN.");
            SetError("Failed to remove the base DN. Check the database connection.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<string> GetUserNameAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            return auth.User?.Identity?.Name ?? "unknown";
        }
        catch
        {
            return "unknown";
        }
    }

    private async Task AuditAsync(string action, string connName, string userName, string details, string? oldValue, string? newValue)
    {
        try
        {
            var ip = HttpCtx.HttpContext?.Connection.RemoteIpAddress?.ToString();
            var ua = HttpCtx.HttpContext?.Request.Headers["User-Agent"].ToString();
            await Audit.LogAsync(
                action: action,
                resourceType: "CreationBaseDnAllowList",
                resourceId: connName,
                userName: userName,
                ipAddress: ip,
                userAgent: ua,
                statusCode: 200,
                details: details,
                oldValue: oldValue,
                newValue: newValue);
        }
        catch (Exception ex)
        {
            // Audit is best-effort — never block the containment change on an audit-write failure.
            Logger.LogWarning(ex, "Failed to write audit for {Action} on the creation base-DN allow-list.", action);
        }
    }

    private void SetError(string m) { message = m; messageIsError = true; }
    private void SetSuccess(string m) { message = m; messageIsError = false; }
    private void ClearMessage() => message = null;
}
