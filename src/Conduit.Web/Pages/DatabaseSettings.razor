@page "/database-settings"
@attribute [Authorize]
@using Microsoft.Extensions.Configuration
@using Conduit.Web.Services
@inject SetupService SetupService
@inject IConfiguration Configuration
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IHostEnvironment HostEnvironment

<PageTitle>Database Settings - Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Title="Database Settings"
               Subtitle="Point Conduit at a different SQL Server, or stand up a brand-new database."
               Icon="fas fa-database"
               IconAccent="slate" />

    <div class="row">
        <div class="col-lg-8">
            <div class="ic-card mb-3">
                <div class="ic-card-hdr">
                    <i class="oi oi-hard-drive" aria-hidden="true"></i>
                    <span class="ic-card-hdr-title">Current Connection</span>
                </div>
                <div class="ic-card-body">
                    <code class="icb-code-block">@MaskConnectionString(currentConnectionString)</code>
                </div>
            </div>

            @{
                var prepared = prepareResult;
            }
            @if (prepared is not null && prepared.Success)
            {
                <div class="icb-notice icb-notice-success mb-3" role="alert">
                    <i class="oi oi-check" aria-hidden="true"></i>
                    <div class="icb-notice-body">
                        <span class="icb-notice-title">Database '@prepared.DatabaseName' is ready.</span>
                        <p class="mb-2">
                            Schema built and the sign-in is set up. Conduit is <strong>still running on
                            '@CurrentDatabaseName()'</strong> until you restart it.
                        </p>
                        @if (string.IsNullOrEmpty(prepared.AdminUserName))
                        {
                            <p class="mb-0">
                                After you restart, sign in with an administrator account that already
                                existed in '@prepared.DatabaseName' — this action created none and changed
                                no passwords there.
                            </p>
                        }
                        else
                        {
                            <p class="mb-0">
                                After you restart, sign in as <code>@prepared.AdminUserName</code>
                                @if (prepared.AdminPasswordCarriedOver)
                                {
                                    <text>with your current password.</text>
                                }
                                else
                                {
                                    <text>with the password you just set.</text>
                                }
                            </p>
                        }
                    </div>
                </div>
            }

            <div class="ic-card mb-3">
                <div class="ic-card-hdr">
                    <span class="ic-card-hdr-title">Choose SQL Server</span>
                </div>
                <div class="ic-card-body">
                    <div class="icb-form-field mb-3">
                        <label class="icb-form-label" for="dbType">Database Type</label>
                        <select id="dbType" class="icb-form-select" @bind="databaseType">
                            <option value="localdb">SQL Server LocalDB (Development)</option>
                            <option value="sqlexpress">SQL Server Express</option>
                            <option value="sqlserver">SQL Server</option>
                            <option value="custom">Custom Connection String</option>
                        </select>
                    </div>

                    @if (databaseType == "sqlexpress" || databaseType == "sqlserver")
                    {
                        <div class="icb-settings-grid mb-3">
                            <div class="icb-form-field">
                                <label class="icb-form-label" for="dbServer">Server Name</label>
                                <input id="dbServer" type="text" class="icb-form-input" @bind="serverName"
                                       placeholder="@(databaseType == "sqlexpress" ? ".\\SQLEXPRESS" : "localhost")" />
                            </div>

                            <div class="icb-form-field">
                                <label class="icb-form-label" for="dbName">Database Name</label>
                                <input id="dbName" type="text" class="icb-form-input" @bind="databaseName" />
                                <span class="icb-form-help">Type a name that does not exist yet to create a new database.</span>
                            </div>

                            <div class="icb-form-field">
                                <label class="icb-form-label" for="dbAuth">Authentication</label>
                                <select id="dbAuth" class="icb-form-select" @bind="authType">
                                    <option value="windows">Windows Authentication</option>
                                    <option value="sql">SQL Server Authentication</option>
                                </select>
                            </div>

                            @if (authType == "sql")
                            {
                                <div class="icb-form-field">
                                    <label class="icb-form-label" for="dbUser">Username</label>
                                    <input id="dbUser" type="text" class="icb-form-input" @bind="dbUsername" />
                                </div>
                                <div class="icb-form-field">
                                    <label class="icb-form-label" for="dbPass">Password</label>
                                    <input id="dbPass" type="password" class="icb-form-input" @bind="dbPassword" />
                                </div>
                            }
                        </div>

                        <div class="icb-form-check mb-2">
                            <input type="checkbox" id="trustCert" @bind="trustServerCertificate" />
                            <label class="icb-form-check-label" for="trustCert">Trust server certificate</label>
                        </div>
                        <div class="icb-form-check mb-3">
                            <input type="checkbox" id="encryptConn" @bind="encryptConnection" />
                            <label class="icb-form-check-label" for="encryptConn">Encrypt connection</label>
                        </div>
                    }
                    else if (databaseType == "localdb")
                    {
                        <div class="icb-form-field mb-3">
                            <label class="icb-form-label" for="dbNameLocal">Database Name</label>
                            <input id="dbNameLocal" type="text" class="icb-form-input" @bind="databaseName" />
                        </div>
                    }
                    else if (databaseType == "custom")
                    {
                        <div class="icb-form-field mb-3">
                            <label class="icb-form-label" for="dbCustom">Connection String</label>
                            <textarea id="dbCustom" class="icb-form-textarea" rows="3" @bind="customConnectionString"
                                      placeholder="Server=localhost;Database=Conduit;..."></textarea>
                        </div>
                    }

                    <hr class="icb-form-divider" />

                    <div class="mb-3">
                        <span class="icb-form-label d-block mb-2">Who signs in after restart?</span>

                        <div class="icb-form-check">
                            <input type="radio" id="signinCopy" name="signinChoice"
                                   checked="@copyCurrentAdmin" @onchange="SelectCopyAdmin" />
                            <label class="icb-form-check-label" for="signinCopy">
                                Me — <strong>@(string.IsNullOrEmpty(currentAdminUserName) ? "(unknown)" : currentAdminUserName)</strong>, same password
                            </label>
                        </div>

                        <div class="icb-form-check">
                            <input type="radio" id="signinNew" name="signinChoice"
                                   checked="@(!copyCurrentAdmin)" @onchange="SelectNewAdmin" />
                            <label class="icb-form-check-label" for="signinNew">A different admin</label>
                        </div>

                        @if (!copyCurrentAdmin)
                        {
                            <div class="icb-settings-grid mt-2">
                                <div class="icb-form-field">
                                    <label class="icb-form-label" for="newAdminUser">Username</label>
                                    <input id="newAdminUser" type="text" class="icb-form-input" placeholder="Username" @bind="newAdminUserName" />
                                </div>
                                <div class="icb-form-field">
                                    <label class="icb-form-label" for="newAdminPass">Password</label>
                                    <input id="newAdminPass" type="password" class="icb-form-input" placeholder="Password (min 8 characters)" @bind="newAdminPassword" />
                                </div>
                            </div>
                        }

                        <div class="icb-form-help d-block mt-2">
                            No agents, connections, or sync history come across &mdash; the new database starts empty.
                        </div>
                        <div class="icb-form-help d-block mt-1">
                            <strong>"Me" duplicates your credential.</strong> Your username, password hash and
                            salt are copied into the new database as a second, independent account. It is a
                            copy that outlives the original: changing or revoking your password in
                            '@CurrentDatabaseName()' later has <em>no effect</em> on the copy, and the copy
                            keeps working. To retire the credential you must change it in both databases.
                        </div>
                    </div>

                    <div class="icb-form-actions">
                        <button type="button" class="ic-btn ic-btn-ghost" @onclick="TestConnection" disabled="@(testingConnection || preparing)">
                            @if (testingConnection)
                            {
                                <i class="fas fa-spinner fa-spin me-2" aria-hidden="true"></i>
                            }
                            Test Connection
                        </button>
                        <button type="button" class="ic-btn ic-btn-primary" @onclick="PrepareDatabase" disabled="@(!CanPrepare())">
                            @if (preparing)
                            {
                                <i class="fas fa-spinner fa-spin me-2" aria-hidden="true"></i>
                            }
                            Create and prepare database
                        </button>
                    </div>

                    @if (prepared != null)
                    {
                        <ul class="icb-step-list">
                            @foreach (var step in prepared.Steps)
                            {
                                <li class="icb-step @(step.State == PrepareStepState.Failed ? "icb-step-failed" : "")">
                                    <span class="@StepIconClass(step.State)" aria-hidden="true">@StepIcon(step.State)</span>
                                    <div>
                                        <div class="icb-step-title">@step.Title</div>
                                        @if (!string.IsNullOrEmpty(step.Message))
                                        {
                                            <div class="icb-step-message">@step.Message</div>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>

                        var failedStep = prepared.Success ? null : prepared.FailedStep;
                        @if (failedStep != null && !preparing)
                        {
                            <div class="icb-notice icb-notice-danger mt-3">
                                <i class="oi oi-warning" aria-hidden="true"></i>
                                <div class="icb-notice-body">
                                    <span class="icb-notice-title">Stopped at &quot;@failedStep.Title&quot;.</span>
                                    <div class="small">@failedStep.Message</div>
                                    <hr class="icb-form-divider my-2" />
                                    <small>
                                        The connection was <strong>not</strong> saved. Conduit is still running on
                                        '@CurrentDatabaseName()' and a restart will change nothing. Fix the problem above and run it again.
                                    </small>
                                </div>
                            </div>
                        }
                    }

                    @if (connectionTest != null)
                    {
                        var alertClass = GetTestAlertClass();
                        <div class="icb-notice @alertClass mt-3" role="status">
                            <div class="icb-notice-body">@GetTestMessage()</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="ic-card">
                <div class="ic-card-hdr">
                    <span class="ic-card-hdr-title">Notes</span>
                </div>
                <div class="ic-card-body small">
                    <ul class="mb-0 ps-3">
                        <li>
                            <strong>Create and prepare database</strong> does everything in one go: creates the
                            database if needed, builds the schema, sets up the sign-in, then saves the connection.
                            Nothing is saved unless every step succeeds.
                        </li>
                        <li>
                            The connection string and JWT secret are written to
                            <code>@secretsFilePath</code> — an ACL-restricted machine-local file,
                            <em>not</em> to any <code>appsettings*.json</code>.
                        </li>
                        <li>
                            The only thing that goes to <code>@environmentConfigPath</code> is the Kestrel
                            listening port, and only when it is changed from the setup wizard.
                        </li>
                        <li>
                            That file is read once at startup (<code>reloadOnChange: false</code>), so
                            <strong>restart Conduit</strong> to switch over. Until you do, the app keeps
                            serving from the current database.
                        </li>
                        <li>
                            Test Connection is optional — it just reports what is there before you commit.
                        </li>
                        <li>If you lose connectivity and the app won't load, the <a href="/setup">setup wizard</a> is always reachable.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string currentConnectionString = "";
    private string secretsFilePath = "";
    private string environmentConfigPath = "";
    private string currentAdminUserName = "";

    private string databaseType = "sqlserver";
    private string serverName = "localhost";
    private string databaseName = "Conduit";
    private string authType = "sql";
    private string dbUsername = "sa";
    private string dbPassword = "";
    private bool trustServerCertificate = true;
    private bool encryptConnection = false;
    private string customConnectionString = "";

    private bool copyCurrentAdmin = true;
    private string newAdminUserName = "";
    private string newAdminPassword = "";

    private bool testingConnection;
    private ConnectionTestResult? connectionTest;

    private bool preparing;
    private PrepareDatabaseResult? prepareResult;

    protected override async Task OnInitializedAsync()
    {
        currentConnectionString = Configuration.GetConnectionString("DefaultConnection") ?? "";
        secretsFilePath = SecretsFile.DefaultPath;
        environmentConfigPath = SetupService.BuildEnvironmentConfigPath(
            HostEnvironment.ContentRootPath,
            Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT"));

        var auth = await AuthState.GetAuthenticationStateAsync();
        currentAdminUserName = auth.User.Identity?.Name ?? "";
    }

    private void SelectCopyAdmin() => copyCurrentAdmin = true;

    private void SelectNewAdmin() => copyCurrentAdmin = false;

    private string CurrentDatabaseName()
    {
        try
        {
            var name = new Microsoft.Data.SqlClient.SqlConnectionStringBuilder(currentConnectionString).InitialCatalog;
            return string.IsNullOrWhiteSpace(name) ? "the current database" : name;
        }
        catch
        {
            return "the current database";
        }
    }

    private string BuildConnectionString()
    {
        if (databaseType == "custom")
        {
            return customConnectionString?.Trim() ?? "";
        }
        if (databaseType == "localdb")
        {
            return $"Server=(localdb)\\mssqllocaldb;Database={databaseName};Trusted_Connection=True;";
        }
        var server = string.IsNullOrWhiteSpace(serverName)
            ? (databaseType == "sqlexpress" ? ".\\SQLEXPRESS" : "localhost")
            : serverName;
        var cs = authType == "windows"
            ? $"Server={server};Database={databaseName};Trusted_Connection=True;"
            : $"Server={server};Database={databaseName};User Id={dbUsername};Password={dbPassword};";
        if (!encryptConnection) cs += "Encrypt=False;";
        if (trustServerCertificate) cs += "TrustServerCertificate=True;";
        return cs;
    }

    private async Task TestConnection()
    {
        testingConnection = true;
        try
        {
            connectionTest = await SetupService.TestConnectionAsync(BuildConnectionString());
        }
        catch (Exception ex)
        {
            connectionTest = new ConnectionTestResult { ErrorMessage = ex.Message };
        }
        finally
        {
            testingConnection = false;
        }
    }

    private bool CanPrepare()
    {
        if (preparing || testingConnection) return false;
        if (string.IsNullOrWhiteSpace(BuildConnectionString())) return false;
        if (copyCurrentAdmin) return !string.IsNullOrWhiteSpace(currentAdminUserName);
        return !string.IsNullOrWhiteSpace(newAdminUserName) && newAdminPassword.Length >= 8;
    }

    private async Task PrepareDatabase()
    {
        preparing = true;
        connectionTest = null;
        prepareResult = null;

        var request = new PrepareDatabaseRequest
        {
            ConnectionString = BuildConnectionString(),
            CopyCurrentAdmin = copyCurrentAdmin,
            NewAdminUserName = newAdminUserName,
            NewAdminPassword = newAdminPassword
        };

        try
        {
            // Hand the service the principal, not a username — it derives which account it
            // is allowed to copy, so this page cannot name someone else's.
            var auth = await AuthState.GetAuthenticationStateAsync();

            prepareResult = await SetupService.PrepareDatabaseAsync(request, auth.User, async live =>
            {
                prepareResult = live;
                await InvokeAsync(StateHasChanged);
            });

            if (prepareResult.Success)
            {
                newAdminPassword = "";
            }
        }
        finally
        {
            preparing = false;
        }
    }

    private static string StepIcon(PrepareStepState state) => state switch
    {
        PrepareStepState.Succeeded => "✓",
        PrepareStepState.Skipped => "–",
        PrepareStepState.Failed => "✗",
        PrepareStepState.Running => "…",
        _ => "·"
    };

    private static string StepIconClass(PrepareStepState state) => state switch
    {
        PrepareStepState.Succeeded => "icb-step-icon icb-step-icon-success",
        PrepareStepState.Skipped => "icb-step-icon icb-step-icon-muted",
        PrepareStepState.Failed => "icb-step-icon icb-step-icon-danger",
        PrepareStepState.Running => "icb-step-icon icb-step-icon-running",
        _ => "icb-step-icon"
    };

    private string GetTestAlertClass()
    {
        if (connectionTest == null) return "icb-notice-neutral";
        if (!connectionTest.ServerReachable) return "icb-notice-danger";
        if (!connectionTest.DatabaseExists) return "icb-notice-warning";
        return "icb-notice-success";
    }

    private string GetTestMessage()
    {
        if (connectionTest == null) return "";
        if (!connectionTest.ServerReachable)
        {
            return $"Connection failed: {connectionTest.ErrorMessage}";
        }
        if (!connectionTest.DatabaseExists)
        {
            return $"Connected to the server. Database '{connectionTest.DatabaseName}' does not exist yet — 'Create and prepare database' will create it and build its schema.";
        }
        if (!connectionTest.SchemaExists)
        {
            return $"Connected. Database '{connectionTest.DatabaseName}' exists but is empty — 'Create and prepare database' will build its schema and set up the sign-in. Restarting alone will not do this.";
        }
        return $"Connection successful. Database '{connectionTest.DatabaseName}' already has a schema.";
    }

    private static string MaskConnectionString(string cs)
    {
        if (string.IsNullOrEmpty(cs)) return "Not configured";
        // Case-insensitive: a stored string using PWD= or PassWord= would otherwise render
        // the plaintext SQL password.
        return System.Text.RegularExpressions.Regex.Replace(cs, @"(Password|Pwd)\s*=\s*([^;]+)", "$1=****",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }
}
