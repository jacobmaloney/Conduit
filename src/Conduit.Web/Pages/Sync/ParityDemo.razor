@page "/sync/parity-demo"
@attribute [Authorize]
@using Conduit.Web.Services
@using IdentityCenter.Brand.Components.Layout
@inject ParityDemoSeedService ParitySeed

<PageTitle>Parity Demo Fixture</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Icon="fas fa-wand-magic-sparkles" IconAccent="cyan"
               Title="IC Parity Demo Fixture"
               Subtitle="Seeds ONE removable, sentinel-tagged sync project that mirrors an IdentityCenter multi-class project." />

    <p class="text-muted">
        The fixture covers user / group / computer / contact, one workflow per class, the
        user workflow carrying the <strong>Resolve Manager Relationships</strong> Lookup step.
        Open <a href="/sync/projects">Sync Projects</a> → Edit on the
        <code>@ParityDemoSeedService.SentinelPrefix</code> project and compare it side-by-side
        with IdentityCenter's Edit Sync Project modal.
    </p>

    <div class="icb-notice icb-notice-info mb-3">
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        <div class="icb-notice-body">
            Non-destructive. It only ever touches its own sentinel-tagged rows. Remove it any time
            with the button below, or run:
            <code>DELETE FROM SyncProjects WHERE Name LIKE '[PARITY-DEMO]%';</code>
        </div>
    </div>

    <div class="d-flex gap-2 align-items-center flex-wrap mb-3">
        <button type="button" class="ic-btn ic-btn-primary" @onclick="Seed" disabled="@busy">
            <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>Seed parity fixture
        </button>
        <button type="button" class="ic-btn ic-btn-danger" @onclick="Remove" disabled="@busy">
            <i class="fas fa-trash" aria-hidden="true"></i>Remove fixture
        </button>
        <div class="icb-form-check ms-2">
            <input class="icb-form-switch" type="checkbox" role="switch" id="rmTenants" @bind="removeTenants" />
            <label class="icb-form-check-label" for="rmTenants">also remove sentinel tenants</label>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="icb-notice @noticeClass" role="status">
            <div class="icb-notice-body">@message</div>
        </div>
    }
</div>

@code {
    private bool busy;
    private bool removeTenants;
    private string? message;
    private string noticeClass = "icb-notice-success";

    private async Task Seed()
    {
        busy = true;
        message = null;
        try
        {
            var r = await ParitySeed.SeedAsync();
            noticeClass = r.Created ? "icb-notice-success" : "icb-notice-warning";
            message = r.Created
                ? $"Created '{r.ProjectName}' — {r.Workflows} workflow(s), {r.Steps} step(s). {r.Note}"
                : r.Note;
        }
        catch (Exception ex)
        {
            noticeClass = "icb-notice-danger";
            message = $"Seed failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Remove()
    {
        busy = true;
        message = null;
        try
        {
            message = await ParitySeed.RemoveAsync(removeTenants);
            noticeClass = "icb-notice-success";
        }
        catch (Exception ex)
        {
            noticeClass = "icb-notice-danger";
            message = $"Remove failed: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }
}
