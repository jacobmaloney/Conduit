@page "/sync-history"
@page "/sync-history/{RunId:guid}"
@attribute [Authorize]
@using Conduit.Core.SyncModels
@using Conduit.DataAccess.Repositories
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Components.Modals
@using IdentityCenter.Brand.Models
@using Microsoft.AspNetCore.WebUtilities
@inject SyncRunRepository RunRepo
@inject SyncProjectRepository ProjectRepo
@inject SyncRunAsyncJobRepository AsyncJobRepo
@inject NavigationManager Navigation
@implements IDisposable

@*
    Phase 1C port: shape matches IC's WebPortal/Pages/Admin/SyncProjectRuns.razor
    + SyncProjectRunDetails.razor combined into a single split-pane experience.
    Differences from IC (intentional):
        - One page, not two. The right pane IS the "run detail" view.
        - Step execution is reconstructed from the canonical boundaries emitted
          by Conduit's workflow orchestrator; run logs predate a separate step table.
        - 2-second polling for any "Running" run (matches IC).
        - ?project=GUID query-string filter so the SyncProjects "History" link
          deep-links into the relevant subset.

    Visuals: CcTemplate1 header + BrandStatRow + BrandFilterTabs + BrandListPanel
    (BrandSummaryRow rows with Soft BrandBadge counters) on the left; the shared
    icb-detail-* / icb-log-* families and BrandListTable on the right; the step
    drill-down opens in BrandEditorDialog. Zero inline style= attributes.
*@

<PageTitle>Sync History - Conduit</PageTitle>

<div class="container-fluid sync-page-container ops-section">
    <CcTemplate1 Title="Sync History"
                 Subtitle="Every sync project run, every log line, kept forever."
                 Icon="fas fa-history"
                 IconAccent="violet" />

    <BrandStatRow Stats="@statRows" />

    @if (ProjectFilterActive)
    {
        <div class="icb-notice icb-notice-info align-items-center flex-wrap mb-3" role="status">
            <i class="fas fa-filter" aria-hidden="true"></i>
            <div class="icb-notice-body">
                Showing runs for <strong>@ProjectName(Guid.Parse(selectedProjectIdRaw))</strong> only — the counts above and the status tabs are scoped to this project. Other projects' history is intact.
            </div>
            <button type="button" class="icb-list-action" @onclick="ShowAllProjects">Show all projects</button>
        </div>
    }

    <BrandFilterTabs Tabs="@statusTabs"
                     ActiveTab="@activeStatusTab"
                     OnTabChanged="HandleStatusTabChanged"
                     Label="Run status"
                     CountDescription="runs" />

    <div class="row flex-grow-1 overflow-hidden mt-3">
        <div class="col-md-4 d-flex flex-column gap-2 overflow-hidden">
            <div class="icb-form-field">
                <label class="icb-form-label" for="sh-project">Project filter</label>
                <select id="sh-project" class="icb-form-select" @bind="selectedProjectIdRaw" @bind:after="ReloadList">
                    <option value="">All projects</option>
                    @foreach (var p in allProjects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <BrandListPanel TItem="Conduit.Core.SyncModels.SyncRun"
                            Width="BrandListWidth.Fill"
                            Title="Runs"
                            Items="@filteredRuns"
                            TotalCount="@filteredRuns.Count"
                            IsSelected="@(r => selectedRun?.Id == r.Id)"
                            OnSelect="HandleSelect"
                            ShowSearch="false"
                            ShowPaging="false"
                            EmptyMessage="No runs match the current filters.">
                <RowTemplate Context="run">
                    <BrandSummaryRow Title="@ProjectName(run.SyncProjectId)" Subtitle="@RunSubtitle(run)" Meta="@RunMeta(run)">
                        <Badges>
                            <BrandBadge Text="@StatusLabel(run.Status)" Tone="@StatusBadgeColor(run.Status)" Icon="@StatusTileIcon(run.Status)" Soft="true" />
                            <BrandBadge Text="@($"R {run.ObjectsRead}")" Tone="@CountTone(run.ObjectsRead)" Soft="true" Description="Objects read" />
                            <BrandBadge Text="@($"C {run.ObjectsCreated}")" Tone="@CountTone(run.ObjectsCreated)" Soft="true" Description="Objects created" />
                            <BrandBadge Text="@($"U {run.ObjectsUpdated}")" Tone="@CountTone(run.ObjectsUpdated)" Soft="true" Description="Objects updated" />
                            @if (run.ObjectsFailed > 0)
                            {
                                <BrandBadge Text="@($"F {run.ObjectsFailed}")" Tone="BrandBadgeTone.Danger" Icon="fas fa-triangle-exclamation" Description="Objects failed" />
                            }
                            else
                            {
                                <BrandBadge Text="F 0" Soft="true" Description="Objects failed" />
                            }
                        </Badges>
                    </BrandSummaryRow>
                </RowTemplate>
            </BrandListPanel>
        </div>

        <div class="col-md-8 overflow-auto">
            @if (selectedRun is null)
            {
                <div class="icb-detail-empty">
                    <i class="fas fa-arrow-left me-2"></i>
                    Select a run on the left to see its log.
                </div>
            }
            else
            {
                <div class="icb-detail-panel">
                    <div class="icb-detail-heading">
                        <div>
                            <h3 class="icb-detail-title">
                                <span>@ProjectName(selectedRun.SyncProjectId)</span>
                                <BrandBadge Text="@StatusLabel(selectedRun.Status)" Tone="@StatusBadgeColor(selectedRun.Status)" Icon="@StatusTileIcon(selectedRun.Status)" />
                                @if (isPolling)
                                {
                                    <BrandBadge Text="Live" Tone="BrandBadgeTone.Success" Dot="true" Soft="true" Compact="true" />
                                }
                            </h3>
                            <div class="icb-detail-subtitle">
                                Run started @selectedRun.StartedAt.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
                                @if (selectedRun.CompletedAt.HasValue)
                                {
                                    <span> · completed @selectedRun.CompletedAt.Value.ToString("HH:mm:ss") · @(selectedRun.DurationMs.HasValue ? $"{selectedRun.DurationMs.Value / 1000.0:0.00}s" : "—")</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="icb-detail-grid">
                        <div class="icb-detail-cell">
                            <div class="icb-detail-label">TRIGGER</div>
                            <div class="icb-detail-value">@selectedRun.TriggeredBy</div>
                        </div>
                        <div class="icb-detail-cell">
                            <div class="icb-detail-label">READ</div>
                            <div class="icb-detail-value">@selectedRun.ObjectsRead</div>
                        </div>
                        <div class="icb-detail-cell">
                            <div class="icb-detail-label">CREATED</div>
                            <div class="icb-detail-value text-success">@selectedRun.ObjectsCreated</div>
                        </div>
                        <div class="icb-detail-cell">
                            <div class="icb-detail-label">UPDATED</div>
                            <div class="icb-detail-value text-info">@selectedRun.ObjectsUpdated</div>
                        </div>
                        <div class="icb-detail-cell">
                            <div class="icb-detail-label">SKIPPED</div>
                            <div class="icb-detail-value text-muted">@selectedRun.ObjectsSkipped</div>
                        </div>
                        <div class="icb-detail-cell">
                            <div class="icb-detail-label">FAILED</div>
                            <div class="icb-detail-value text-danger">@selectedRun.ObjectsFailed</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(selectedRun.ErrorMessage))
                    {
                        <div class="icb-detail-section">
                            <div class="icb-detail-section-title">Error</div>
                            <pre class="icb-detail-error">@selectedRun.ErrorMessage</pre>
                        </div>
                    }

                    <div class="icb-detail-section">
                        <BrandFilterTabs Tabs="@detailTabs"
                                         ActiveTab="@activeDetailTab"
                                         OnTabChanged="HandleDetailTabChanged"
                                         Label="Run detail" />

                        @if (activeDetailTab == "log")
                        {
                            <div class="icb-card-toolbar mt-3">
                                <div class="icb-detail-section-title mb-0">
                                    Log (@visibleLogs.Count of @logs.Count lines)
                                    @if (selectedRun.Status == "Running")
                                    {
                                        <BrandBadge Text="Streaming" Tone="BrandBadgeTone.Success" Icon="fas fa-sync fa-spin" Soft="true" Compact="true" />
                                    }
                                </div>
                                <button type="button"
                                        class="icb-list-action @(traceEnabled ? "icb-list-action-primary" : "")"
                                        @onclick="ToggleTrace">
                                    <i class="fas @(traceEnabled ? "fa-stream" : "fa-align-left") me-1"></i>
                                    @(traceEnabled ? "Disable Trace" : "Enable Trace")
                                </button>
                            </div>
                            <p class="icb-table-note">@TraceNote</p>
                            @if (!string.IsNullOrEmpty(logLoadError))
                            {
                                <div class="icb-notice icb-notice-danger" role="alert">
                                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                                    <div class="icb-notice-body">@logLoadError</div>
                                </div>
                            }
                            @if (visibleLogs.Count == 0)
                            {
                                <div class="icb-detail-empty">No log lines at this verbosity.</div>
                            }
                            else
                            {
                                <div class="icb-log-block">
                                    @foreach (var line in visibleLogs)
                                    {
                                        <div class="icb-log-line icb-log-@line.Level.ToLowerInvariant()">
                                            <span class="icb-log-ts">@line.Timestamp.ToString("HH:mm:ss")</span>
                                            <span class="icb-log-level">@line.Level</span>
                                            <span class="icb-log-msg">@line.Message</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (activeDetailTab == "steps")
                        {
                            <div class="icb-detail-section-title mt-3">
                                Steps (@steps.Count)
                                <small class="text-muted ms-2">Recorded by this run's workflow telemetry.</small>
                            </div>
                            <BrandListTable TItem="StepView" Items="@steps" Title="Steps" TotalCount="@steps.Count" ShowPaging="false"
                                            RowClass="@(s => s.HasError ? "icb-row-danger" : null)"
                                            EmptyMessage="This run produced no per-step markers. It may predate workflow steps, or ran the legacy single-pass mapping. See the Log tab for raw lines.">
                                <HeaderTemplate>
                                    <th scope="col">Status</th>
                                    <th scope="col">Step</th>
                                    <th scope="col">Type</th>
                                    <th scope="col" class="text-center">Read</th>
                                    <th scope="col" class="text-center">Created</th>
                                    <th scope="col" class="text-center">Updated</th>
                                    <th scope="col" class="text-center">Skipped</th>
                                    <th scope="col" class="text-center">Failed</th>
                                    <th scope="col" class="text-end">Detail</th>
                                </HeaderTemplate>
                                <RowTemplate Context="step">
                                    <td><BrandBadge Text="@StepStatus(step)" Tone="@StepBadge(step)" Soft="true" /></td>
                                    <td class="nm-cell">@step.Name</td>
                                    <td><span class="mono">@step.StepType</span></td>
                                    <td class="text-center">@DeltaCell(step.Read)</td>
                                    <td class="text-center">@DeltaCell(step.Created)</td>
                                    <td class="text-center">@DeltaCell(step.Updated)</td>
                                    <td class="text-center">@DeltaCell(step.Skipped)</td>
                                    <td class="text-center">@DeltaCell(step.Failed)</td>
                                    <td class="text-end">
                                        <button type="button" class="icb-list-action" @onclick="() => OpenStepDetail(step)">
                                            <i class="fas @(step.HasError ? "fa-triangle-exclamation" : "fa-magnifying-glass") me-1"></i>
                                            @(step.HasError ? "Error" : "View")
                                        </button>
                                    </td>
                                </RowTemplate>
                            </BrandListTable>
                        }
                        else if (activeDetailTab == "asyncjobs")
                        {
                            <p class="icb-table-note mt-3">
                                Remote jobs are connector operations accepted by a target for background completion.
                                Normal AD and Identity Center writes complete inline and do not create remote jobs.
                            </p>
                            <div class="icb-card-toolbar mb-2">
                                <BrandFilterTabs Tabs="@asyncJobStateTabs"
                                                 ActiveTab="@activeAsyncJobState"
                                                 OnTabChanged="HandleAsyncJobStateChanged"
                                                 Label="Remote job state" />
                                @if (asyncJobTypes.Count > 1)
                                {
                                    <div class="icb-form-field">
                                        <select id="sh-job-type" class="icb-form-select" aria-label="Remote job type"
                                                @bind="asyncJobTypeFilter" @bind:after="RefilterAsyncJobs">
                                            <option value="">All job types</option>
                                            @foreach (var jt in asyncJobTypes)
                                            {
                                                <option value="@jt">@jt</option>
                                            }
                                        </select>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(asyncJobToast))
                                {
                                    <span class="small text-success">
                                        <i class="fas fa-check-circle me-1"></i>@asyncJobToast
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(asyncJobError))
                                {
                                    <span class="small text-danger">
                                        <i class="fas fa-exclamation-triangle me-1"></i>@asyncJobError
                                    </span>
                                }
                            </div>

                            <BrandListTable TItem="Conduit.Core.SyncModels.SyncRunAsyncJob" Items="@filteredAsyncJobs" Title="Remote jobs" TotalCount="@filteredAsyncJobs.Count" ShowPaging="false"
                                            EmptyMessage="@(allAsyncJobs.Count == 0 ? "No async jobs were submitted by this run." : "No async jobs match the current filters.")">
                                <HeaderTemplate>
                                    <th scope="col">State</th>
                                    <th scope="col">Job type</th>
                                    <th scope="col">External id</th>
                                    <th scope="col">Submitted</th>
                                    <th scope="col">Last poll</th>
                                    <th scope="col" class="text-center">Attempts</th>
                                    <th scope="col">Error</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </HeaderTemplate>
                                <RowTemplate Context="job">
                                    @{
                                        var jobId = job.Id;
                                        var state = job.State;
                                    }
                                    <td><BrandBadge Text="@state" Tone="@AsyncJobStateBadge(state)" Soft="true" /></td>
                                    <td><span class="mono">@job.JobType</span></td>
                                    <td class="mono text-break">@(job.ObjectExternalId ?? "—")</td>
                                    <td>@job.SubmittedAt.ToString("HH:mm:ss")</td>
                                    <td>@(job.LastPolledAt?.ToString("HH:mm:ss") ?? "—")</td>
                                    <td class="text-center">@job.PollAttempts</td>
                                    <td class="text-danger text-break">@(job.ErrorMessage ?? "")</td>
                                    <td class="text-end">
                                        @if (state == "Pending")
                                        {
                                            <button type="button" class="icb-list-action"
                                                    disabled="@asyncJobMutating"
                                                    @onclick="() => CancelAsyncJob(jobId)">
                                                <i class="fas fa-ban me-1"></i>Cancel
                                            </button>
                                        }
                                        else if (state == "Failed" || state == "Cancelled")
                                        {
                                            <button type="button" class="icb-list-action"
                                                    disabled="@asyncJobMutating"
                                                    @onclick="() => RetryAsyncJob(jobId)">
                                                <i class="fas fa-redo me-1"></i>Retry
                                            </button>
                                        }
                                    </td>
                                </RowTemplate>
                            </BrandListTable>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (stepDetail is not null)
{
    <BrandEditorDialog Label="@($"Step detail: {stepDetail.Name}")">
        <HeaderContent>
            <div class="icb-card-toolbar">
                <h2 class="icb-detail-title">
                    <BrandBadge Text="@StepStatus(stepDetail)" Tone="@StepBadge(stepDetail)" />
                    <span>Step: @stepDetail.Name</span>
                </h2>
                <div class="icb-action-bar">
                    <button type="button" class="icb-action" @onclick="CloseStepDetail">
                        <i class="fas fa-xmark me-1"></i>Close
                    </button>
                </div>
            </div>
        </HeaderContent>
        <ChildContent>
            <div class="icb-detail-grid">
                <div class="icb-detail-cell">
                    <div class="icb-detail-label">TYPE</div>
                    <div class="icb-detail-value"><span class="mono">@stepDetail.StepType</span></div>
                </div>
                <div class="icb-detail-cell">
                    <div class="icb-detail-label">READ</div>
                    <div class="icb-detail-value">@DeltaCell(stepDetail.Read)</div>
                </div>
                <div class="icb-detail-cell">
                    <div class="icb-detail-label">CREATED</div>
                    <div class="icb-detail-value text-success">@DeltaCell(stepDetail.Created)</div>
                </div>
                <div class="icb-detail-cell">
                    <div class="icb-detail-label">UPDATED</div>
                    <div class="icb-detail-value text-info">@DeltaCell(stepDetail.Updated)</div>
                </div>
                <div class="icb-detail-cell">
                    <div class="icb-detail-label">SKIPPED</div>
                    <div class="icb-detail-value text-muted">@DeltaCell(stepDetail.Skipped)</div>
                </div>
                <div class="icb-detail-cell">
                    <div class="icb-detail-label">FAILED</div>
                    <div class="icb-detail-value text-danger">@DeltaCell(stepDetail.Failed)</div>
                </div>
            </div>

            @if (stepDetail.HasError)
            {
                <div class="icb-detail-section">
                    <div class="icb-detail-section-title">Errors</div>
                    <pre class="icb-detail-error">@stepDetail.ErrorText</pre>
                </div>
            }

            <div class="icb-detail-section">
                <div class="icb-detail-section-title">Step log (@stepDetail.Lines.Count lines)</div>
                <div class="icb-log-block">
                    @foreach (var line in stepDetail.Lines)
                    {
                        <div class="icb-log-line icb-log-@line.Level.ToLowerInvariant()">
                            <span class="icb-log-ts">@line.Timestamp.ToString("HH:mm:ss")</span>
                            <span class="icb-log-level">@line.Level</span>
                            <span class="icb-log-msg">@line.Message</span>
                        </div>
                    }
                </div>
            </div>
        </ChildContent>
    </BrandEditorDialog>
}

@code {
    [Parameter] public Guid? RunId { get; set; }

    private List<Conduit.Core.SyncModels.SyncRun> allRuns = new();
    private List<Conduit.Core.SyncModels.SyncRun> filteredRuns = new();
    private List<Conduit.Core.SyncModels.SyncRunLog> logs = new();
    private List<SyncProject> allProjects = new();
    private Dictionary<Guid, SyncProject> projectById = new();
    private Conduit.Core.SyncModels.SyncRun? selectedRun;

    private string activeStatusTab = "all";
    private string selectedProjectIdRaw = string.Empty;

    private IReadOnlyList<BrandFilterTabs.Tab> statusTabs = Array.Empty<BrandFilterTabs.Tab>();
    private IReadOnlyList<BrandStatRow.StatItem> statRows = Array.Empty<BrandStatRow.StatItem>();

    // Item 4: detail-pane sub-tabs (Log / Steps / Async Jobs).
    private string activeDetailTab = "log";
    private IReadOnlyList<BrandFilterTabs.Tab> detailTabs = Array.Empty<BrandFilterTabs.Tab>();

    // Item 4: client-side trace verbosity + parsed step view.
    // HONEST NOTE: the toggle is CLIENT-SIDE. Conduit's orchestrator writes one
    // Info/Warning/Error log stream and accepts no server-side verbosity flag,
    // so "Enable Trace" reveals the indented per-object/step-detail lines while
    // "Disable Trace" collapses to workflow/step headers + warnings + errors.
    // No "Debug" level is emitted today; nothing is faked as a server trace level.
    private bool traceEnabled = true;
    // Fix 8: log-pane error surfacing (load/poll failures were console-only).
    private string logLoadError = string.Empty;
    private List<Conduit.Core.SyncModels.SyncRunLog> visibleLogs = new();
    private List<StepView> steps = new();
    private StepView? stepDetail;

    private string TraceNote => traceEnabled
        ? "Trace ON — showing every log line, including per-object detail. (Client-side verbosity; the orchestrator emits a single Info/Warning/Error stream.)"
        : "Trace OFF — showing workflow/step headers, warnings and errors only. (Client-side filter over the same stream.)";

    /// <summary>
    /// A step reconstructed from the orchestrator's own log markers — NOT a DB
    /// table. SyncRunLogs has no step column (Id/SyncRunId/Level/Message/Timestamp
    /// only), so step boundaries are derived from the real lines the orchestrator
    /// emits: "  Step '{name}' [{type}] starting (ordinal {n})." …
    /// "  Step '{name}' done. +Read=… +Failed=…." with any
    /// "  Step '{name}' threw: …" Error line in between.
    /// </summary>
    private sealed class StepView
    {
        public string Name { get; set; } = string.Empty;
        public string StepType { get; set; } = string.Empty;
        public bool Done { get; set; }
        public bool HasError { get; set; }
        public int? Read { get; set; }
        public int? Created { get; set; }
        public int? Updated { get; set; }
        public int? Skipped { get; set; }
        public int? Failed { get; set; }
        public List<Conduit.Core.SyncModels.SyncRunLog> Lines { get; } = new();
        public string ErrorText { get; set; } = string.Empty;
    }

    // Phase 5: async-job admin state for the currently selected run.
    private List<Conduit.Core.SyncModels.SyncRunAsyncJob> allAsyncJobs = new();
    private List<Conduit.Core.SyncModels.SyncRunAsyncJob> filteredAsyncJobs = new();
    private List<string> asyncJobTypes = new();
    private string activeAsyncJobState = "all";
    private string asyncJobTypeFilter = string.Empty;
    private IReadOnlyList<BrandFilterTabs.Tab> asyncJobStateTabs = Array.Empty<BrandFilterTabs.Tab>();
    private bool asyncJobMutating;
    private string asyncJobToast = string.Empty;
    private string asyncJobError = string.Empty;

    // Auto-refresh polling for running runs. Mirrors IC's SyncProjectRuns.razor
    // (2-second timer; stops once nothing is running).
    private System.Threading.Timer? pollTimer;
    private bool isPolling;
    private bool isRefreshing;

    protected override async Task OnInitializedAsync()
    {
        // ?project=GUID — entry point from SyncProjects "History" link.
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("project", out var pidStr) && Guid.TryParse(pidStr, out var pid))
        {
            selectedProjectIdRaw = pid.ToString();
        }

        allProjects = await ProjectRepo.GetAllAsync();
        projectById = allProjects.ToDictionary(p => p.Id);
        await ReloadList();
        if (RunId.HasValue)
        {
            selectedRun = allRuns.FirstOrDefault(r => r.Id == RunId.Value)
                          ?? await RunRepo.GetByIdAsync(RunId.Value);
            if (selectedRun is not null)
            {
                await LoadLogs();
                await LoadAsyncJobs();
            }
        }
        RebuildDetailTabs();
        StartPollingIfNeeded();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RunId.HasValue && (selectedRun is null || selectedRun.Id != RunId.Value))
        {
            selectedRun = await RunRepo.GetByIdAsync(RunId.Value);
            if (selectedRun is not null)
            {
                await LoadLogs();
                await LoadAsyncJobs();
            }
            StartPollingIfNeeded();
        }
    }

    private bool ProjectFilterActive => Guid.TryParse(selectedProjectIdRaw, out _);

    private async Task ShowAllProjects()
    {
        selectedProjectIdRaw = string.Empty;
        await ReloadList();
    }

    /// <summary>
    /// Keep ?project= in the address bar in step with the select so refresh / back / share
    /// reproduce what the user is looking at, and clearing the filter clears the URL.
    /// </summary>
    private void SyncProjectQueryString(Guid? projectFilter)
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        var current = query.TryGetValue("project", out var v) ? v.ToString() : string.Empty;
        var wanted = projectFilter?.ToString() ?? string.Empty;
        if (string.Equals(current, wanted, StringComparison.OrdinalIgnoreCase)) return;
        var path = uri.GetLeftPart(UriPartial.Path);
        var target = string.IsNullOrEmpty(wanted) ? path : $"{path}?project={wanted}";
        Navigation.NavigateTo(target, forceLoad: false, replace: true);
    }

    private async Task ReloadList()
    {
        Guid? projectFilter = null;
        if (Guid.TryParse(selectedProjectIdRaw, out var pg)) projectFilter = pg;
        SyncProjectQueryString(projectFilter);

        string? statusFilter = activeStatusTab == "all" ? null : activeStatusTab;

        allRuns = await RunRepo.GetRecentAsync(take: 200, projectId: projectFilter, status: statusFilter);
        filteredRuns = allRuns;
        RebuildStatusTabs();
        RecomputeStats();
    }

    private void RebuildStatusTabs()
    {
        statusTabs = new[]
        {
            new BrandFilterTabs.Tab("all",            "All",       allRuns.Count),
            new BrandFilterTabs.Tab("Running",        "Running",   allRuns.Count(r => r.Status == "Running")),
            new BrandFilterTabs.Tab("Succeeded",      "Succeeded", allRuns.Count(r => r.Status == "Succeeded")),
            new BrandFilterTabs.Tab("PartialSuccess", "Partial",   allRuns.Count(r => r.Status == "PartialSuccess")),
            new BrandFilterTabs.Tab("Failed",         "Failed",    allRuns.Count(r => r.Status == "Failed")),
            new BrandFilterTabs.Tab("Cancelled",      "Cancelled", allRuns.Count(r => r.Status == "Cancelled"))
        };
    }

    private void RecomputeStats()
    {
        // Mirror IC SyncProjectRunDetails Created / Updated / Deleted / Errors —
        // adapted for Conduit's counter shape (Created / Updated / Skipped / Failed).
        statRows = new[]
        {
            new BrandStatRow.StatItem("Created", filteredRuns.Sum(r => r.ObjectsCreated).ToString("N0"), ValueColor: "text-success"),
            new BrandStatRow.StatItem("Updated", filteredRuns.Sum(r => r.ObjectsUpdated).ToString("N0"), ValueColor: "text-info"),
            new BrandStatRow.StatItem("Skipped", filteredRuns.Sum(r => r.ObjectsSkipped).ToString("N0"), ValueColor: "text-muted"),
            // "Objects Failed", not "Failed" — the status pill above counts failed
            // RUNS, and two differently-scoped "Failed" numbers sat inches apart.
            new BrandStatRow.StatItem("Objects Failed", filteredRuns.Sum(r => r.ObjectsFailed).ToString("N0"), ValueColor: "text-danger", Emphasize: filteredRuns.Any(r => r.ObjectsFailed > 0))
        };
    }

    private async Task HandleStatusTabChanged(string key)
    {
        activeStatusTab = key;
        await ReloadList();
        StartPollingIfNeeded();
    }

    private async Task HandleSelect(Conduit.Core.SyncModels.SyncRun r)
    {
        selectedRun = r;
        await LoadLogs();
        await LoadAsyncJobs();
        StartPollingIfNeeded();
    }

    // Fix 7: rendered-log cap + high-water mark for incremental tailing. The poll
    // loop appends only rows with Id > maxSeenLogId and drops from the HEAD once
    // the in-memory list exceeds the cap, so a long run keeps streaming its tail
    // instead of freezing at the first 2000 lines.
    private const int LogRenderCap = 2000;
    private long maxSeenLogId;

    private async Task LoadLogs()
    {
        if (selectedRun is null) { logs = new(); maxSeenLogId = 0; RebuildDerivedViews(); return; }
        try
        {
            // Initial load = the TAIL of the run (identical to the old TOP-N for
            // runs under the cap; the useful end of the log for runs over it).
            logs = await RunRepo.GetLogsTailAsync(selectedRun.Id, take: LogRenderCap);
            maxSeenLogId = logs.Count > 0 ? logs[^1].Id : 0;
            logLoadError = string.Empty;
        }
        catch (Exception ex)
        {
            logLoadError = $"Could not load run logs: {ex.Message}";
            logs = new();
            maxSeenLogId = 0;
        }
        RebuildDerivedViews();
    }

    /// <summary>
    /// Fix 7: poll-tick log refresh. Appends only rows after the max seen Id and
    /// trims the head to the render cap — no more full TOP-N re-fetch every 2s.
    /// </summary>
    private async Task AppendNewLogs()
    {
        if (selectedRun is null) return;
        try
        {
            var fresh = await RunRepo.GetLogsAfterAsync(selectedRun.Id, maxSeenLogId, take: LogRenderCap);
            logLoadError = string.Empty;
            if (fresh.Count == 0) return;
            logs.AddRange(fresh);
            maxSeenLogId = logs[^1].Id;
            if (logs.Count > LogRenderCap)
            {
                logs.RemoveRange(0, logs.Count - LogRenderCap);
            }
            RebuildDerivedViews();
        }
        catch (Exception ex)
        {
            logLoadError = $"Live log refresh failed: {ex.Message}";
        }
    }

    // ─── Item 4: derive trace-filtered log + step view from real log lines ───

    private void RebuildDerivedViews()
    {
        visibleLogs = traceEnabled
            ? logs
            : logs.Where(IsHeadlineLine).ToList();
        steps = ParseSteps(logs);
        RebuildDetailTabs();

        // Keep an open step-detail modal in sync with refreshed log data.
        if (stepDetail is not null)
        {
            stepDetail = steps.FirstOrDefault(s => s.Name == stepDetail.Name && s.StepType == stepDetail.StepType);
        }
    }

    // A line is "headline" when it is a Warning/Error, or a step/workflow header
    // (these start at column 0-2 in the orchestrator's emitted text). Per-object
    // detail lines are indented 4+ spaces and are hidden when trace is OFF.
    private static bool IsHeadlineLine(Conduit.Core.SyncModels.SyncRunLog line)
    {
        if (line.Level == "Warning" || line.Level == "Error") return true;
        var leadingSpaces = line.Message.Length - line.Message.TrimStart().Length;
        return leadingSpaces < 4;
    }

    private static List<StepView> ParseSteps(List<Conduit.Core.SyncModels.SyncRunLog> source)
    {
        var result = new List<StepView>();
        StepView? current = null;

        foreach (var line in source)
        {
            var msg = line.Message;
            var trimmed = msg.TrimStart();

            if (SyncRunStepMarker.TryParse(trimmed, out var marker))
            {
                current = new StepView
                {
                    Name = marker.Name,
                    StepType = marker.StepType ?? string.Empty
                };
                current.Lines.Add(line);
                result.Add(current);
                continue;
            }

            if (trimmed.StartsWith("Step '"))
            {
                var name = ExtractQuoted(trimmed);
                if (current is not null && current.Name == name)
                {
                    current.Lines.Add(line);
                    if (trimmed.Contains("' done."))
                    {
                        current.Done = true;
                        ApplyDeltas(current, trimmed);
                    }
                    else if (trimmed.Contains("' threw:"))
                    {
                        current.HasError = true;
                    }
                    continue;
                }
            }

            if (current is not null)
            {
                current.Lines.Add(line);
                if (line.Level == "Error") current.HasError = true;
            }
        }

        foreach (var s in result)
        {
            var errLines = s.Lines.Where(l => l.Level == "Error").Select(l => l.Message.Trim());
            s.ErrorText = string.Join("\n", errLines);
            if (!string.IsNullOrEmpty(s.ErrorText)) s.HasError = true;
        }
        return result;
    }

    // "  Step 'Map Users' [Mapping] starting (ordinal 0)." → "Map Users"
    private static string ExtractQuoted(string s)
    {
        var open = s.IndexOf('\'');
        if (open < 0) return string.Empty;
        var close = s.IndexOf('\'', open + 1);
        if (close < 0) return string.Empty;
        return s.Substring(open + 1, close - open - 1);
    }

    // "  Step 'X' done. +Read=5 +Created=2 +Updated=0 +Skipped=1 +Failed=0."
    private static void ApplyDeltas(StepView step, string doneLine)
    {
        step.Read    = ReadDelta(doneLine, "+Read=");
        step.Created = ReadDelta(doneLine, "+Created=");
        step.Updated = ReadDelta(doneLine, "+Updated=");
        step.Skipped = ReadDelta(doneLine, "+Skipped=");
        step.Failed  = ReadDelta(doneLine, "+Failed=");
    }

    private static int? ReadDelta(string source, string token)
    {
        var idx = source.IndexOf(token, StringComparison.Ordinal);
        if (idx < 0) return null;
        var start = idx + token.Length;
        var end = start;
        while (end < source.Length && (char.IsDigit(source[end]) || source[end] == '-')) end++;
        if (end == start) return null;
        return int.TryParse(source.Substring(start, end - start), out var v) ? v : null;
    }

    private static string DeltaCell(int? v) => v.HasValue ? v.Value.ToString() : "—";

    private static string StepStatus(StepView s) =>
        s.HasError ? "Failed" : s.Done ? "Done" : "Running";

    private static BrandBadgeTone StepBadge(StepView s) =>
        s.HasError ? BrandBadgeTone.Danger : s.Done ? BrandBadgeTone.Success : BrandBadgeTone.Info;

    private async Task ToggleTrace()
    {
        traceEnabled = !traceEnabled;
        RebuildDerivedViews();
        await Task.CompletedTask;
    }

    private void OpenStepDetail(StepView step) => stepDetail = step;

    private void CloseStepDetail() => stepDetail = null;

    private async Task LoadAsyncJobs()
    {
        if (selectedRun is null)
        {
            allAsyncJobs = new();
            filteredAsyncJobs = new();
            asyncJobTypes = new();
            RebuildDetailTabs();
            return;
        }
        try
        {
            allAsyncJobs = await AsyncJobRepo.GetByRunAsync(selectedRun.Id);
            asyncJobTypes = allAsyncJobs.Select(j => j.JobType).Distinct().OrderBy(s => s).ToList();
            RefilterAsyncJobs();
            RebuildDetailTabs();
        }
        catch (Exception ex)
        {
            // Fix 8: surface in the async-jobs pane's existing error field.
            asyncJobError = $"Could not load async jobs: {ex.Message}";
            allAsyncJobs = new();
            filteredAsyncJobs = new();
            asyncJobTypes = new();
            RebuildDetailTabs();
        }
    }

    private void RebuildDetailTabs()
    {
        var tabs = new List<BrandFilterTabs.Tab>
        {
            new BrandFilterTabs.Tab("log", "Log", logs.Count),
            new BrandFilterTabs.Tab("steps", "Steps", steps.Count)
        };

        // Remote jobs are an advanced connector capability, not a normal phase
        // of every sync. Reveal the tab only when this run submitted one.
        if (allAsyncJobs.Count > 0)
            tabs.Add(new BrandFilterTabs.Tab("asyncjobs", "Remote jobs", allAsyncJobs.Count));
        else if (activeDetailTab == "asyncjobs")
            activeDetailTab = "log";
        detailTabs = tabs;

        var pending   = allAsyncJobs.Count(j => j.State == "Pending");
        var succeeded = allAsyncJobs.Count(j => j.State == "Succeeded");
        var failed    = allAsyncJobs.Count(j => j.State == "Failed");
        var cancelled = allAsyncJobs.Count(j => j.State == "Cancelled");

        asyncJobStateTabs = new[]
        {
            new BrandFilterTabs.Tab("all",       "All",       allAsyncJobs.Count),
            new BrandFilterTabs.Tab("Pending",   "Pending",   pending),
            new BrandFilterTabs.Tab("Succeeded", "Succeeded", succeeded),
            new BrandFilterTabs.Tab("Failed",    "Failed",    failed),
            new BrandFilterTabs.Tab("Cancelled", "Cancelled", cancelled)
        };
    }

    private void RefilterAsyncJobs()
    {
        IEnumerable<Conduit.Core.SyncModels.SyncRunAsyncJob> q = allAsyncJobs;
        if (activeAsyncJobState != "all")
            q = q.Where(j => j.State == activeAsyncJobState);
        if (!string.IsNullOrEmpty(asyncJobTypeFilter))
            q = q.Where(j => j.JobType == asyncJobTypeFilter);
        filteredAsyncJobs = q.OrderByDescending(j => j.SubmittedAt).ToList();
    }

    private async Task HandleDetailTabChanged(string key)
    {
        activeDetailTab = key;
        if (key == "asyncjobs") await LoadAsyncJobs();
    }

    private async Task HandleAsyncJobStateChanged(string key)
    {
        activeAsyncJobState = key;
        RefilterAsyncJobs();
        await Task.CompletedTask;
    }

    private async Task CancelAsyncJob(long jobId)
    {
        asyncJobMutating = true;
        asyncJobToast = string.Empty;
        asyncJobError = string.Empty;
        try
        {
            var ok = await AsyncJobRepo.CancelAsync(jobId);
            asyncJobToast = ok ? "Job cancelled." : "Job state already changed — refresh to see latest.";
            await LoadAsyncJobs();
        }
        catch (Exception ex)
        {
            asyncJobError = $"Cancel failed: {ex.Message}";
        }
        finally
        {
            asyncJobMutating = false;
        }
    }

    private async Task RetryAsyncJob(long jobId)
    {
        asyncJobMutating = true;
        asyncJobToast = string.Empty;
        asyncJobError = string.Empty;
        try
        {
            var ok = await AsyncJobRepo.RetryAsync(jobId);
            asyncJobToast = ok ? "Job re-queued — the poller will pick it up shortly." : "Job not in a re-tryable state — refresh to see latest.";
            await LoadAsyncJobs();
        }
        catch (Exception ex)
        {
            asyncJobError = $"Retry failed: {ex.Message}";
        }
        finally
        {
            asyncJobMutating = false;
        }
    }

    private static BrandBadgeTone AsyncJobStateBadge(string? state) => state switch
    {
        "Succeeded" => BrandBadgeTone.Success,
        "Failed"    => BrandBadgeTone.Danger,
        "Cancelled" => BrandBadgeTone.Warning,
        "Pending"   => BrandBadgeTone.Info,
        _           => BrandBadgeTone.Neutral
    };

    // Polling: start a 2s timer whenever the list OR the selected run contains
    // a "Running" entry. Stop automatically when everything settles.
    private void StartPollingIfNeeded()
    {
        var anythingRunning =
            allRuns.Any(r => r.Status == "Running") ||
            (selectedRun?.Status == "Running") ||
            allAsyncJobs.Any(j => j.State == "Pending");

        if (anythingRunning && pollTimer is null)
        {
            isPolling = true;
            pollTimer = new System.Threading.Timer(async _ => await PollAsync(), null, 2000, 2000);
        }
        else if (!anythingRunning && pollTimer is not null)
        {
            isPolling = false;
            pollTimer.Dispose();
            pollTimer = null;
        }
    }

    private async Task PollAsync()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        try
        {
            await ReloadList();
            if (selectedRun is not null)
            {
                var refreshed = await RunRepo.GetByIdAsync(selectedRun.Id);
                if (refreshed is not null)
                {
                    selectedRun = refreshed;
                    // Fix 7: append-only tail instead of re-fetching the first
                    // TOP-N (which froze long runs at the first 2000 lines).
                    await AppendNewLogs();
                    // Phase 5: keep async-job rows live while jobs are pending —
                    // the poller may advance them out of band on a 30s tick.
                    if (activeDetailTab == "asyncjobs" || allAsyncJobs.Any(j => j.State == "Pending"))
                    {
                        await LoadAsyncJobs();
                    }
                }
            }
            await InvokeAsync(StateHasChanged);

            var stillRunning =
                allRuns.Any(r => r.Status == "Running") ||
                (selectedRun?.Status == "Running");
            if (!stillRunning && pollTimer is not null)
            {
                isPolling = false;
                pollTimer.Dispose();
                pollTimer = null;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            // Fix 8: surface the poll failure in the log pane rather than
            // swallowing to console — the operator otherwise sees a silently
            // frozen "Live" view.
            logLoadError = $"Live refresh failed: {ex.Message}";
            try { await InvokeAsync(StateHasChanged); } catch { /* circuit gone */ }
        }
        finally
        {
            isRefreshing = false;
        }
    }

    private string ProjectName(Guid id) =>
        projectById.TryGetValue(id, out var p) ? p.Name : "(deleted project)";

    private static BrandBadgeTone StatusBadgeColor(string? status) => status switch
    {
        "Succeeded"      => BrandBadgeTone.Success,
        "Running"        => BrandBadgeTone.Info,
        "Failed"         => BrandBadgeTone.Danger,
        "PartialSuccess" => BrandBadgeTone.Warning,
        "Cancelled"      => BrandBadgeTone.Warning,
        "Interrupted"    => BrandBadgeTone.Warning,
        _                => BrandBadgeTone.Neutral
    };

    // The orchestrator emits "PartialSuccess" as a real rolled-up status (some
    // steps failed, some succeeded). Matches IC SyncProjectRuns' "Partial Success".
    private static string StatusLabel(string? status) => status switch
    {
        "PartialSuccess" => "Partial Success",
        _                => status ?? "Unknown"
    };

    // Left-rail row status badge: StatusBadgeColor supplies the tone, this the icon.
    private static string StatusTileIcon(string? status) => status switch
    {
        "Succeeded"      => "fas fa-check",
        "Running"        => "fas fa-spinner fa-spin",
        "Failed"         => "fas fa-xmark",
        "PartialSuccess" => "fas fa-triangle-exclamation",
        "Cancelled"      => "fas fa-ban",
        "Interrupted"    => "fas fa-plug-circle-xmark",
        _                => "fas fa-circle-question"
    };

    private static string TruncateErr(string s) =>
        s.Length <= 120 ? s : s.Substring(0, 117) + "…";

    private static string RunSubtitle(Conduit.Core.SyncModels.SyncRun run) =>
        string.IsNullOrEmpty(run.ErrorMessage) ? string.Empty : "Error: " + TruncateErr(run.ErrorMessage!);

    private static string RunMeta(Conduit.Core.SyncModels.SyncRun run) =>
        run.StartedAt.ToString("yyyy-MM-dd HH:mm:ss") + (run.DurationMs.HasValue ? $" · {run.DurationMs.Value / 1000.0:0.0}s" : string.Empty);

    // Counter chips: zeros recede as Neutral; a nonzero count takes the Info tone.
    private static BrandBadgeTone CountTone(int count) =>
        count == 0 ? BrandBadgeTone.Neutral : BrandBadgeTone.Info;

    public void Dispose()
    {
        pollTimer?.Dispose();
        pollTimer = null;
    }
}
