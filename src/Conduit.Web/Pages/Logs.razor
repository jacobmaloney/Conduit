@page "/logs"
@attribute [Authorize]
@using Conduit.Web.Services
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject ApplicationLogService ApplicationLogService
@inject IJSRuntime JSRuntime

<PageTitle>Application Logs - Conduit</PageTitle>

<div class="container-fluid">
    <Template1 Title="Application Logs"
               Subtitle="Monitor system activities and debug issues"
               Icon="fas fa-bug"
               IconAccent="amber">
        <PrimaryAction>
            <div class="d-flex gap-2">
                <button type="button" class="icb-list-action" @onclick="RefreshLogs">
                    <i class="oi oi-loop-circular"></i> Refresh
                </button>
                <button type="button" class="icb-list-action" @onclick="ClearLogs">
                    <i class="oi oi-trash"></i> Clear
                </button>
            </div>
        </PrimaryAction>
    </Template1>

    <BrandListTable TItem="ApplicationLogService.LogEntry" Items="@logs" Title="Application logs"
                    TotalCount="@logs.Count" ShowPaging="false"
                    State="@(loading ? BrandListState.Loading : BrandListState.Ready)"
                    EmptyMessage="No Logs Found. No logs match your current filters or no logs have been generated yet."
                    RowClass="@(log => GetRowClass(log.Level))">
        <Toolbar>
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="icb-form-field">
                    <label class="icb-form-label" for="lg-level">Log Level</label>
                    <select id="lg-level" class="icb-form-select" @bind="selectedLevel" @bind:after="RefreshLogs">
                        <option value="">All Levels</option>
                        <option value="Debug">Debug</option>
                        <option value="Info">Info</option>
                        <option value="Warning">Warning</option>
                        <option value="Error">Error</option>
                        <option value="Critical">Critical</option>
                    </select>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="lg-category">Category</label>
                        <input id="lg-category" type="text" class="icb-form-input" @bind="categoryFilter" @bind:after="RefreshLogs" placeholder="e.g., GroupGeneration" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="icb-form-field">
                    <label class="icb-form-label" for="lg-max">Max Results</label>
                    <select id="lg-max" class="icb-form-select" @bind="maxResults" @bind:after="RefreshLogs">
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                        <option value="500">500</option>
                    </select>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="icb-form-check">
                        <input type="checkbox" @bind="autoRefresh" @bind:after="ToggleAutoRefresh" id="autoRefreshCheck" />
                        <label class="icb-form-check-label" for="autoRefreshCheck">
                            Auto-refresh (5s)
                        </label>
                    </div>
                </div>
            </div>
        </Toolbar>
        <HeaderTemplate>
            <th scope="col">Timestamp</th>
            <th scope="col">Level</th>
            <th scope="col">Category</th>
            <th scope="col">Message</th>
            <th scope="col">Details</th>
        </HeaderTemplate>
        <RowTemplate Context="log">
            <td>
                <small>@log.Timestamp.ToString("HH:mm:ss.fff")</small>
            </td>
            <td>
                <BrandBadge Text="@log.Level.ToString()" Tone="@GetLevelBadgeClass(log.Level)" Soft="true" />
            </td>
            <td>
                <small>@log.Category</small>
            </td>
            <td>
                <small>@log.Message</small>
            </td>
            <td>
                @if (!string.IsNullOrEmpty(log.Details))
                {
                    <small class="text-muted">@log.Details</small>
                }
                @if (log.Exception != null)
                {
                    <div class="mt-1">
                        <small class="text-danger">
                            <strong>Exception:</strong> @log.Exception.Message
                        </small>
                        @if (!string.IsNullOrEmpty(log.Exception.StackTrace))
                        {
                            <details class="mt-1">
                                <summary><small class="text-muted">Stack Trace</small></summary>
                                <pre class="small text-muted mt-1">@log.Exception.StackTrace</pre>
                            </details>
                        }
                    </div>
                }
            </td>
        </RowTemplate>
    </BrandListTable>
</div>

@code {
    private List<ApplicationLogService.LogEntry> logs = new();
    private bool loading = true;
    private string selectedLevel = "";
    private string categoryFilter = "";
    private int maxResults = 100;
    private bool autoRefresh = false;
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshLogs();
    }

    private Task RefreshLogs()
    {
        loading = true;

        try
        {
            ApplicationLogService.LogLevel? minLevel = null;
            if (!string.IsNullOrEmpty(selectedLevel) && Enum.TryParse<ApplicationLogService.LogLevel>(selectedLevel, out var level))
            {
                minLevel = level;
            }

            logs = ApplicationLogService.GetRecentLogs(
                count: maxResults,
                minLevel: minLevel,
                category: string.IsNullOrEmpty(categoryFilter) ? null : categoryFilter
            );
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading logs: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private Task ClearLogs()
    {
        ApplicationLogService.ClearLogs();
        return RefreshLogs();
    }

    private void ToggleAutoRefresh()
    {
        if (autoRefresh)
        {
            refreshTimer = new Timer(async _ => await InvokeAsync(async () => await RefreshLogs()),
                                   null, TimeSpan.Zero, TimeSpan.FromSeconds(5));
        }
        else
        {
            refreshTimer?.Dispose();
            refreshTimer = null;
        }
    }

    private BrandBadgeTone GetLevelBadgeClass(ApplicationLogService.LogLevel level)
    {
        return level switch
        {
            ApplicationLogService.LogLevel.Debug => BrandBadgeTone.Neutral,
            ApplicationLogService.LogLevel.Info => BrandBadgeTone.Info,
            ApplicationLogService.LogLevel.Warning => BrandBadgeTone.Warning,
            ApplicationLogService.LogLevel.Error => BrandBadgeTone.Danger,
            ApplicationLogService.LogLevel.Critical => BrandBadgeTone.Danger,
            _ => BrandBadgeTone.Neutral
        };
    }

    private string GetRowClass(ApplicationLogService.LogLevel level)
    {
        return level switch
        {
            ApplicationLogService.LogLevel.Error => "icb-row-danger",
            ApplicationLogService.LogLevel.Critical => "icb-row-danger",
            ApplicationLogService.LogLevel.Warning => "icb-row-warning",
            _ => ""
        };
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}

@implements IDisposable
