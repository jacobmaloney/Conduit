@using Conduit.Core.Models
@using Conduit.Core.Services
@using Conduit.DataAccess.Repositories
@using Conduit.Web.Services
@inject OpenAccessState OpenAccess
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment
@inject SyncProjectRepository ProjectRepo
@inject TenantRepository TenantRepo

<div class="cx-sidebar">
    @* Open-access warning pill (portal authentication is OFF), Development-gated. *@
    @if (ShowDevChrome && OpenAccess.IsEnabled)
    {
        <a class="cx-openaccess-pill" href="configuration" title="Portal authentication is OFF — click to manage in Configuration">
            <i class="fas fa-triangle-exclamation"></i>
            <span>Open access</span>
        </a>
    }

    <nav>
        @* Redesign rail: MAIN (Dashboard, Sync Projects) · SYNC (Connections,
           Schedules) · SETTINGS (Configuration). History lives on the dashboard
           "Run history" button; Identity Providers/Database/Audit are tabs inside
           Configuration; Quick Connect is off the rail. *@
        <div class="cx-nav-label">Main</div>
        <NavLink class="cx-nav" ActiveClass="active" href="" Match="NavLinkMatch.All">
            <span class="cx-nav-left"><i class="fas fa-gauge-high"></i><span>Dashboard</span></span>
        </NavLink>
        <NavLink class="cx-nav" ActiveClass="active" href="sync-projects">
            <span class="cx-nav-left"><i class="fas fa-right-left"></i><span>Sync Projects</span></span>
            @if (projectCount is int pc)
            {
                <span class="cx-nav-badge">@pc</span>
            }
        </NavLink>

        <div class="cx-nav-label">Sync</div>
        <NavLink class="cx-nav" ActiveClass="active" href="connected-systems">
            <span class="cx-nav-left"><i class="fas fa-plug"></i><span>Connections</span></span>
            @if (connectionCount is int cc)
            {
                <span class="cx-nav-badge">@cc</span>
            }
        </NavLink>
        <NavLink class="cx-nav" ActiveClass="active" href="schedules">
            <span class="cx-nav-left"><i class="fas fa-calendar-days"></i><span>Schedules</span></span>
            @if (scheduleCount is int sc)
            {
                <span class="cx-nav-badge">@sc</span>
            }
        </NavLink>

        <div class="cx-nav-label">Settings</div>
        <NavLink class="cx-nav" ActiveClass="active" href="configuration">
            <span class="cx-nav-left"><i class="fas fa-gear"></i><span>Configuration</span></span>
        </NavLink>
    </nav>

    <div class="cx-sidebar-spacer"></div>

    <div class="cx-sidebar-foot">
        <AuthorizeView>
            <Authorized>
                Signed in as <b>@(context.User.Identity?.Name ?? "admin")</b><br />
                <a href="/logout">Sign out</a>
            </Authorized>
            <NotAuthorized>
                <a href="/login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    // SCIM-origin chrome (the open-access pill) stays gated to Development.
    private bool ShowDevChrome => Environment.IsDevelopment();

    // Rail count badges. Pulled once on load the same way the dashboard/hub do;
    // any repo failure just leaves the badge off (null) rather than breaking nav.
    private int? projectCount;
    private int? scheduleCount;
    private int? connectionCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var projects = await ProjectRepo.GetAllAsync();
            projectCount = projects.Count;
            scheduleCount = projects.Count(p => !string.IsNullOrWhiteSpace(p.CronSchedule));
        }
        catch { }

        try
        {
            var tenants = await TenantRepo.GetAllAsync(includeInactive: true);
            connectionCount = tenants.Count;
        }
        catch { }
    }
}
