@page "/provisioning-base-dns"
@attribute [Authorize]
@using Conduit.DataAccess.Repositories
@using Conduit.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject ICreationBaseDnAllowListRepository Repo
@inject ICreationBaseDnPolicy Policy
@inject Conduit.DataAccess.Repositories.SinkConnectionCredentialMapRepository CredMapRepo
@inject AuditLogService Audit
@inject AuthenticationStateProvider AuthState
@inject IHttpContextAccessor HttpCtx
@inject ILogger<ProvisioningBaseDns> Logger

<PageTitle>AD Creation Base DNs - Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Icon="fas fa-shield-alt" IconAccent="slate"
               Title="AD Creation Base DNs"
               Subtitle="The containment allow-list for AD account creation — customer-owned, on this agent." />

    <div class="icb-notice icb-notice-warning mb-3">
        <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
        <div class="icb-notice-body">
            <strong>This is the creation containment control.</strong> An AD account create is only permitted when its
            target OU is <em>contained within</em> one of the base DNs configured here for its connection.
            A connection with <strong>no</strong> permitted base DN <strong>denies every create</strong> (deny-all by default).
            A permitted container <strong>includes every container beneath it</strong>. A <strong>blocked</strong> container refuses
            itself and everything beneath it, even inside a permitted one.
            Grant only the OUs where creation is intended — and delegate the bind account "Create User objects" only there.
            These values live on this agent and are never set from IdentityCenter.
        </div>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="icb-notice @(messageIsError ? "icb-notice-danger" : "icb-notice-success") mb-3" role="status">
            <i class="@(messageIsError ? "fas fa-circle-exclamation" : "fas fa-circle-check")" aria-hidden="true"></i>
            <div class="icb-notice-body">@message</div>
            <button type="button" class="icb-notice-dismiss" aria-label="Dismiss" @onclick="ClearMessage">&times;</button>
        </div>
    }

    <div class="ic-card mb-4">
        <div class="ic-card-hdr">
            <i class="fas fa-plus" aria-hidden="true"></i>
            <span class="ic-card-hdr-title">Choose where accounts may be created</span>
        </div>
        <div class="ic-card-body">
            <div class="row g-2 align-items-start">
                <div class="col-md-3">
                    <div class="icb-form-field">
                        <BrandSelectField Label="Connection name" Id="pbd-conn" @bind-Value="newConnectionName">
                            <option value="">-- select a connection --</option>
                            @foreach (var name in connectionOptions)
                            {
                                <option value="@name">@name</option>
                            }
                        </BrandSelectField>
                        <span class="icb-form-help">
                            @if (connectionOptions.Count == 0)
                            {
                                <text>No connections are registered on this agent yet — save an IdentityCenter-targeted sync project so its route appears here.</text>
                            }
                            else
                            {
                                <text>The IdentityCenter connection to provision into (its DirectoryConnections.Name).</text>
                            }
                        </span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="icb-form-field">
                        <span class="icb-form-label d-none d-md-block">&nbsp;</span>
                        <button type="button" class="ic-btn ic-btn-primary w-100 justify-content-center" @onclick="BrowseAsync" disabled="@(saving || string.IsNullOrWhiteSpace(newConnectionName))">
                            <i class="fas fa-folder-tree me-1" aria-hidden="true"></i>Browse and choose
                        </button>
                        <span class="icb-form-help">Shows what is permitted and blocked now. Click a container to permit it, click again to block it.</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="icb-form-field">
                        <BrandTextField Label="Or type a distinguished name" Id="pbd-dn" @bind-Value="newBaseDn" Immediate="true" Placeholder="OU=Staff,OU=Users,DC=corp,DC=local" Monospace="true" />
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="icb-form-field">
                        <span class="icb-form-label d-none d-md-block">&nbsp;</span>
                        <button type="button" class="ic-btn ic-btn-ghost w-100 justify-content-center" @onclick="() => AddAsync(false)" disabled="@saving">Permit</button>
                    </div>
                </div>
                <div class="col-md-1">
                    <div class="icb-form-field">
                        <span class="icb-form-label d-none d-md-block">&nbsp;</span>
                        <button type="button" class="ic-btn ic-btn-danger w-100 justify-content-center" @onclick="() => AddAsync(true)" disabled="@saving">Block</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <p><em>Loading…</em></p>
    }
    else if (connections.Count == 0)
    {
        <div class="icb-notice icb-notice-neutral">
            <div class="icb-notice-body">No provisioning routes are configured on this agent.</div>
        </div>
    }
    else
    {
        @if (!anyEffective)
        {
            <div class="icb-notice icb-notice-warning mb-3">
                <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
                <div class="icb-notice-body">Routes exist, but no permitted creation base DN is in effect. Every AD create is currently denied.</div>
            </div>
        }
        @foreach (var conn in connections)
        {
            <div class="ic-card mb-3">
                <div class="ic-card-hdr">
                    <i class="fas fa-plug" aria-hidden="true"></i>
                    <span class="ic-card-hdr-title">@conn.Name</span>
                    <span class="ms-auto">
                        @if (conn.EnforcedSource == BaseDnSource.Database)
                        {
                            <BrandBadge Text="@($"{conn.DbEntries.Count(e => !e.IsBlocked)} permitted, {conn.DbEntries.Count(e => e.IsBlocked)} blocked (database)")" Tone="BrandBadgeTone.Success" Compact="true" />
                        }
                        else if (conn.EnforcedSource == BaseDnSource.Config)
                        {
                            <BrandBadge Text="@($"{conn.ConfigDns.Count} enforced (host config)")" Tone="BrandBadgeTone.Info" Compact="true" />
                        }
                        else
                        {
                            <BrandBadge Text="denied — no permitted base DN" Tone="BrandBadgeTone.Danger" Compact="true" />
                        }
                    </span>
                </div>
                <section class="icb-table-panel" aria-label="@($"Permitted base DNs for {conn.Name}")">
                    <div class="icb-table-scroll" tabindex="0" role="region" aria-label="@($"Permitted base DNs for {conn.Name}")">
                        <table class="icb-data-table">
                            <thead>
                                <tr><th scope="col">Container</th><th scope="col">Rule</th><th scope="col">Source</th><th scope="col">Added</th><th scope="col">By</th><th scope="col" class="text-end">Action</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in conn.DbEntries)
                                {
                                    <tr>
                                        <td>
                                            <div class="mono">@entry.BaseDn</div>
                                            @{ var note = NoteFor(conn, entry); }
                                            @if (note is not null)
                                            {
                                                <div>@note</div>
                                            }
                                        </td>
                                        <td>
                                            @if (entry.IsBlocked)
                                            {
                                                <BrandBadge Text="Blocked" Tone="BrandBadgeTone.Danger" Compact="true" />
                                            }
                                            else
                                            {
                                                <BrandBadge Text="Permitted, with everything beneath" Tone="BrandBadgeTone.Success" Compact="true" />
                                            }
                                        </td>
                                        <td><BrandBadge Text="database (enforced)" Tone="BrandBadgeTone.Success" Compact="true" /></td>
                                        <td>@entry.CreatedAt.ToString("u")</td>
                                        <td>@(entry.CreatedBy ?? "—")</td>
                                        <td class="text-end">
                                            <button type="button" class="ic-btn ic-btn-danger ic-btn-sm" @onclick="() => DeleteAsync(entry.Id)" disabled="@saving">Remove</button>
                                        </td>
                                    </tr>
                                }
                                @foreach (var dn in conn.ConfigDns)
                                {
                                    <tr>
                                        <td class="mono">@dn</td>
                                        <td><BrandBadge Text="Permitted, with everything beneath" Tone="BrandBadgeTone.Neutral" Compact="true" /></td>
                                        <td>
                                            @if (conn.EnforcedSource == BaseDnSource.Config)
                                            {
                                                <span title="Edit in the agent's appsettings"><BrandBadge Text="host config (enforced) — read-only" Tone="BrandBadgeTone.Info" Compact="true" /></span>
                                            }
                                            else
                                            {
                                                <span title="Database entries take precedence; this is not currently enforced"><BrandBadge Text="host config — OVERRIDDEN by database, not enforced" Tone="BrandBadgeTone.Neutral" Compact="true" /></span>
                                            }
                                        </td>
                                        <td colspan="2"><em class="text-muted">from agent host config — edit in appsettings</em></td>
                                        <td class="text-end"><span class="text-muted">—</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        }
    }
</div>

@* The same directory browser the sync project editor uses, in its include/block mode: it opens showing what is
   permitted (and inherited beneath it) and blocked now, and Apply saves the difference, each change audited. *@
<Conduit.Web.Shared.Design.DirectoryBrowserModal @ref="browser" ScopeTitle="Where accounts may be created" OnScopesSelected="OnScopesAppliedAsync" />

@code {
    private Conduit.Web.Shared.Design.DirectoryBrowserModal? browser;

    private async Task BrowseAsync()
    {
        var connName = newConnectionName?.Trim() ?? string.Empty;
        if (connName.Length == 0 || browser is null) return;
        try
        {
            var tenantId = await CredMapRepo.GetTenantIdByNameAsync(connName);
            if (tenantId is null || tenantId.Value == Guid.Empty)
            {
                SetError(string.Concat("'", connName, "' is not registered on this agent yet, so its directory cannot be browsed. Type the distinguished name."));
                return;
            }
            ClearMessage();
            browseConnection = connName;
            var current = (await Repo.GetAllAsync())
                .Where(e => string.Equals(e.SourceConnectionName, connName, StringComparison.OrdinalIgnoreCase)).ToList();
            await browser.ShowForScopeAsync(tenantId.Value, null,
                current.Where(e => !e.IsBlocked).Select(e => e.BaseDn),
                current.Where(e => e.IsBlocked).Select(e => e.BaseDn));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open the directory browser for the creation base-DN allow-list.");
            SetError("The directory could not be opened. Type the distinguished name.");
        }
    }

    private string browseConnection = string.Empty;

    /// <summary>
    /// Apply in the browser: store exactly what the tree now shows for the connection it was opened for. Rows whose
    /// rule is unchanged are left alone; every removal and addition is audited like a typed one.
    /// </summary>
    private async Task OnScopesAppliedAsync((HashSet<string> Included, HashSet<string> Blocked) picked)
    {
        var connName = browseConnection;
        if (connName.Length == 0) return;
        saving = true;
        try
        {
            var userName = await GetUserNameAsync();
            var current = (await Repo.GetAllAsync())
                .Where(e => string.Equals(e.SourceConnectionName, connName, StringComparison.OrdinalIgnoreCase)).ToList();
            var malformed = picked.Included.Concat(picked.Blocked).FirstOrDefault(d => !BaseDnContainment.IsWellFormedDn(d));
            if (malformed is not null)
            {
                SetError(string.Concat("'", malformed, "' is not a well-formed distinguished name. Nothing was changed."));
                return;
            }

            int added = 0, removed = 0;
            foreach (var entry in current)
            {
                // A block wins when a container is somehow in both sets.
                var wanted = picked.Blocked.Contains(entry.BaseDn) ? true : picked.Included.Contains(entry.BaseDn) ? false : (bool?)null;
                if (wanted == entry.IsBlocked) continue;
                if (await Repo.DeleteAsync(entry.Id))
                {
                    removed++;
                    await AuditAsync(entry.IsBlocked ? "CreationBaseDnBlockRemoved" : "CreationBaseDnRemoved", connName, userName,
                        details: string.Concat(entry.IsBlocked ? "Blocked container removed from connection '" : "Permitted AD creation base DN removed from connection '", connName, "'."),
                        oldValue: entry.BaseDn, newValue: null);
                }
            }
            foreach (var (dn, isBlocked) in picked.Blocked.Select(d => (d, true))
                         .Concat(picked.Included.Where(d => !picked.Blocked.Contains(d)).Select(d => (d, false))))
            {
                if (await Repo.AddAsync(connName, dn, userName, isBlocked))
                {
                    added++;
                    await AuditAsync(isBlocked ? "CreationBaseDnBlocked" : "CreationBaseDnAdded", connName, userName,
                        details: string.Concat(isBlocked ? "Container blocked for connection '" : "Permitted AD creation base DN added for connection '", connName, "'."),
                        oldValue: null, newValue: dn);
                }
            }

            if (added == 0 && removed == 0) SetSuccess(string.Concat("Nothing changed for '", connName, "'."));
            else SetSuccess(string.Concat("Saved for '", connName, "': ", added.ToString(), " added, ", removed.ToString(), " removed."));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save the creation base-DN allow-list from the directory browser.");
            SetError("Failed to save. Check the database connection, then open the browser again to see what is stored.");
            await LoadAsync();
        }
        finally
        {
            saving = false;
        }
    }

    /// <summary>
    /// What a row means next to its neighbours, from the same containment rule the write paths use: a permit inside a
    /// block does nothing, and a permit inside another permit is already covered.
    /// </summary>
    private static string? NoteFor(ConnDisplay conn, CreationBaseDnEntry entry)
    {
        if (entry.IsBlocked) return null;
        var block = conn.DbEntries.FirstOrDefault(o => o.IsBlocked && BaseDnContainment.IsContained(entry.BaseDn, new[] { o.BaseDn }));
        if (block is not null) return string.Concat("Has no effect: inside the blocked container ", block.BaseDn);
        var parent = conn.DbEntries.FirstOrDefault(o => !o.IsBlocked && o.Id != entry.Id && BaseDnContainment.IsStrictlyBelow(entry.BaseDn, new[] { o.BaseDn }));
        return parent is null ? null : string.Concat("Already covered by ", parent.BaseDn);
    }

    private bool loading = true;
    private bool saving = false;
    private string? message;
    private bool messageIsError;

    private string newConnectionName = string.Empty;
    private string newBaseDn = string.Empty;

    private sealed class ConnDisplay
    {
        public string Name { get; set; } = string.Empty;
        public BaseDnSource EnforcedSource { get; set; }
        public List<CreationBaseDnEntry> DbEntries { get; set; } = new();  // editable/removable
        public List<string> ConfigDns { get; set; } = new();              // read-only (host config)
    }

    private List<ConnDisplay> connections = new();
    private List<string> knownConnectionNames = new();
    private List<string> connectionOptions = new();
    private bool anyEffective;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            // DB entries (editable) grouped by connection.
            var dbAll = await Repo.GetAllAsync();
            var dbByConn = dbAll
                .GroupBy(e => e.SourceConnectionName)
                .ToDictionary(g => g.Key, g => g.OrderBy(e => e.BaseDn).ToList());

            // Include routed connections even when they have no allow-list entry. Hiding
            // that state made a valid route look absent instead of correctly "deny-all".
            var mapped = await CredMapRepo.GetAllSourceConnectionNamesAsync();
            var names = dbByConn.Keys
                .Concat(Policy.GetConfiguredConnectionNames())
                .Concat(mapped)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n)
                .ToList();

            connections = new List<ConnDisplay>();
            foreach (var name in names)
            {
                // The ENFORCED source is resolved by the SAME policy the create path uses — displayed == enforced.
                var effective = await Policy.GetEffectiveAsync(name);
                connections.Add(new ConnDisplay
                {
                    Name = name,
                    EnforcedSource = effective.Source,
                    DbEntries = dbByConn.TryGetValue(name, out var e) ? e : new List<CreationBaseDnEntry>(),
                    ConfigDns = Policy.GetConfigBaseDns(name).ToList()
                });
            }

            // Deny-all globally only when NOTHING is in effect anywhere (DB ∪ config empty).
            anyEffective = connections.Any(c => c.EnforcedSource != BaseDnSource.None);
            knownConnectionNames = names;

            // Dropdown options: connections Conduit can actually provision to (those with a registered
            // credential mapping) UNION any already in the allow-list — so an operator picks a real
            // connection name instead of typing a stray value that can never match.
            connectionOptions = mapped
                .Concat(names)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load creation base-DN allow-list.");
            SetError("Failed to load the allow-list. Check the database connection.");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AddAsync(bool isBlocked)
    {
        var connName = newConnectionName?.Trim() ?? string.Empty;
        var baseDn = newBaseDn?.Trim() ?? string.Empty;

        if (string.IsNullOrEmpty(connName))
        {
            SetError("A connection name is required.");
            return;
        }
        if (string.IsNullOrEmpty(baseDn))
        {
            SetError("A base DN is required.");
            return;
        }
        // Reject a malformed DN at save time — same component-wise parser the containment check uses.
        if (!BaseDnContainment.IsWellFormedDn(baseDn))
        {
            SetError(string.Concat("'", baseDn, "' is not a well-formed distinguished name. Example: OU=Staff,OU=Users,DC=corp,DC=local"));
            return;
        }

        saving = true;
        try
        {
            var userName = await GetUserNameAsync();
            var inserted = await Repo.AddAsync(connName, baseDn, userName, isBlocked);
            if (!inserted)
            {
                SetError(string.Concat("'", baseDn, "' is already listed for connection '", connName, "'. Remove it first to change its rule."));
                return;
            }

            await AuditAsync(isBlocked ? "CreationBaseDnBlocked" : "CreationBaseDnAdded", connName, userName,
                details: string.Concat(isBlocked ? "Container blocked for connection '" : "Permitted AD creation base DN added for connection '", connName, "'."),
                oldValue: null, newValue: baseDn);

            newBaseDn = string.Empty;
            SetSuccess(string.Concat(isBlocked ? "Blocked the container for '" : "Added permitted base DN for '", connName, "'."));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add creation base DN.");
            SetError("Failed to add the base DN. Check the database connection.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        saving = true;
        try
        {
            var entry = await Repo.GetByIdAsync(id);
            var deleted = await Repo.DeleteAsync(id);
            if (deleted && entry is not null)
            {
                var userName = await GetUserNameAsync();
                await AuditAsync(entry.IsBlocked ? "CreationBaseDnBlockRemoved" : "CreationBaseDnRemoved", entry.SourceConnectionName, userName,
                    details: string.Concat(entry.IsBlocked ? "Blocked container removed from connection '" : "Permitted AD creation base DN removed from connection '", entry.SourceConnectionName, "'."),
                    oldValue: entry.BaseDn, newValue: null);
                SetSuccess(entry.IsBlocked ? "Removed the block." : "Removed permitted base DN.");
            }
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to remove creation base DN.");
            SetError("Failed to remove the base DN. Check the database connection.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<string> GetUserNameAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            return auth.User?.Identity?.Name ?? "unknown";
        }
        catch
        {
            return "unknown";
        }
    }

    private async Task AuditAsync(string action, string connName, string userName, string details, string? oldValue, string? newValue)
    {
        try
        {
            var ip = HttpCtx.HttpContext?.Connection.RemoteIpAddress?.ToString();
            var ua = HttpCtx.HttpContext?.Request.Headers["User-Agent"].ToString();
            await Audit.LogAsync(
                action: action,
                resourceType: "CreationBaseDnAllowList",
                resourceId: connName,
                userName: userName,
                ipAddress: ip,
                userAgent: ua,
                statusCode: 200,
                details: details,
                oldValue: oldValue,
                newValue: newValue);
        }
        catch (Exception ex)
        {
            // Audit is best-effort — never block the containment change on an audit-write failure.
            Logger.LogWarning(ex, "Failed to write audit for {Action} on the creation base-DN allow-list.", action);
        }
    }

    private void SetError(string m) { message = m; messageIsError = true; }
    private void SetSuccess(string m) { message = m; messageIsError = false; }
    private void ClearMessage() => message = null;
}
