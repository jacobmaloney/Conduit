@page "/login"
@model Conduit.Web.Pages.LoginModel
@using IdentityCenter.Brand.Models
@{
    Layout = null;
    var errors = new List<string>();
    if (!string.IsNullOrEmpty(Model.ErrorMessage)) { errors.Add(Model.ErrorMessage); }
    if (Model.SsoError) { errors.Add("Single sign-on could not complete. Contact your administrator or sign in below."); }
    var login = new BrandLoginModel {
        Identity = ProductIdentities.Conduit with { LogoUrl = "~/_content/IdentityCenter.Brand/assets/brand/conduit-mark-light-bg.svg" },
        FormAction = Request.PathBase + Request.Path + Request.QueryString,
        Username = Model.Username,
        Errors = errors,
        HiddenFields = new Dictionary<string, string?> { ["ReturnUrl"] = Model.ReturnUrl },
        Providers = Model.ExternalProviders.Select(p => new LoginProvider("Sign in with " + p.Name,
            $"/login/sso?provider={Uri.EscapeDataString(p.Name)}&returnUrl={Uri.EscapeDataString(Model.ReturnUrl ?? "/")}")).ToArray()
    };
}
@await Html.PartialAsync("/Views/Shared/BrandLogin.cshtml", login)
