@page "/setup"
@using Conduit.Web.Services
@using System.Security.Cryptography
@using Microsoft.Extensions.Logging
@inject SetupService SetupService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject ILogger<Setup> Logger
@layout SetupLayout

<div class="icb-wizard">
    <aside class="icb-wizard-aside">
        <div class="icb-wizard-brand">
            <ConduitMark Size="72" Color="var(--accent)" HubFill="var(--bg-2)" />
            <span><b>Conduit</b></span>
        </div>
        <div class="icb-wizard-steps">
            @foreach (var (label, num) in StepList())
            {
                var state = num == currentStep ? "is-current" : (num < currentStep ? "is-done" : "");
                <div class="icb-wizard-step @state">
                    <span class="icb-wizard-step-num">
                        @if (num < currentStep)
                        {
                            <i class="oi oi-check" aria-hidden="true"></i>
                        }
                        else
                        {
                            @num
                        }
                    </span>
                    <span>@label</span>
                </div>
            }
        </div>
        <div class="icb-wizard-aside-foot">
            <div>First-run setup</div>
            <p class="icb-wizard-aside-foot-note">Point Conduit at a database, create your admin sign-in, and you're ready to connect your first system. You can change everything later in Configuration.</p>
        </div>
    </aside>

    <main class="icb-wizard-main">
        <div class="icb-wizard-pane">
            @if (isProcessing)
            {
                <div class="text-center py-5" role="status">
                    <i class="fas fa-spinner fa-spin fa-2x" aria-hidden="true"></i>
                    <span class="visually-hidden">Setting up...</span>
                    <p class="mt-3 text-muted">Setting up Conduit, please wait...</p>
                </div>
            }
            else if (setupComplete)
            {
                <div class="icb-wizard-eyebrow">All set</div>
                <h1 class="icb-wizard-title">Setup <span class="icb-wizard-title-accent">complete</span>.</h1>
                <p class="icb-wizard-lede">Conduit has been successfully configured. Redirecting to the login page…</p>
            }
            else if (prefill.RecoveryRequired)
            {
                <!--
                    Schema present, zero active admins. This wizard renders NO FORM for that
                    state — not a narrowed one.

                    A narrowed wizard was the original answer here and it was wrong twice
                    over. First, it made the anonymous wizard reachable on an install that
                    had already been set up, and its admin step would resolve an existing
                    username with no Active filter and UPDATE it with Active = 1 — typing a
                    deactivated admin's name took that account over. Second, the step list
                    never actually narrowed: StepList() was a fixed four-element array and
                    submit was gated on currentStep == 4, so the operator still walked
                    through Step 3, which carries the JWT signing key and a "Generate New"
                    button that an anonymous visitor could use to mint this install's
                    signing key.

                    WHAT ENFORCES WHAT, precisely, because this branch is easy to over-credit:

                      - The AUTHORITATIVE refusals are server-side and in SetupService:
                        ApplySetupAsync throws unless setup is genuinely required, and both
                        it and CreateAdminUserAsync refuse when PortalAdmins holds any row.
                        Nothing rendered or not rendered here can be relied on for that; a
                        hostile client controls its own render tree.

                      - This branch is what keeps the EditForm — every step, the JWT key
                        field, the Generate button, the submit path — out of the render tree,
                        so the real signing key is never sent to a client in this state. It
                        fires because OnInitializedAsync sets prefill.RecoveryRequired before
                        it redirects. Deleting that assignment does NOT make this branch fall
                        back to the redirect; it silently renders the whole form instead.
                -->
                <div class="icb-wizard-eyebrow">Recovery required</div>
                <h1 class="icb-wizard-title">This install needs its <span class="icb-wizard-title-accent">administrator</span> back.</h1>
                <p class="icb-wizard-lede">
                    Conduit already has a database and a schema — this is not a first run, so the
                    setup wizard will not open. What it does not have is an active portal
                    administrator, and restoring one requires access to the Conduit host itself.
                </p>
                <a class="ic-btn ic-btn-primary" href="/admin-recovery">Continue to recovery</a>
            }
            else
            {
                <div class="icb-wizard-eyebrow">First-run setup · @StepList()[currentStep - 1].label</div>
                <h1 class="icb-wizard-title">@WizardHeading()</h1>
                <p class="icb-wizard-lede">@WizardLede()</p>

                <EditForm Model="@config" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />

                            @if (currentStep == 1)
                            {
                                <!-- Step 1: Database Configuration -->
                                <h4 class="section-title">Database Configuration</h4>
                                <p class="text-muted">Configure the database connection for Conduit.</p>

                                <div class="icb-form-field mb-3">
                                    <label class="icb-form-label" for="setupDbType">Database Type</label>
                                    <select id="setupDbType" class="icb-form-select" @bind="databaseType">
                                        <option value="localdb">SQL Server LocalDB (Development)</option>
                                        <option value="sqlexpress">SQL Server Express</option>
                                        <option value="sqlserver">SQL Server</option>
                                        <option value="custom">Custom Connection String</option>
                                    </select>
                                </div>

                                @if (databaseType == "localdb")
                                {
                                    <div class="icb-form-field mb-3">
                                        <label class="icb-form-label" for="setupDbNameLocal">Database Name</label>
                                        <input id="setupDbNameLocal" type="text" class="icb-form-input" @bind="databaseName" placeholder="Conduit" />
                                        <span class="icb-form-help">
                                            Defaults to <code>Conduit</code>. Use suffixes like <code>ConduitUSA1</code> to run multiple instances side-by-side.
                                        </span>
                                    </div>
                                }

                                @if (databaseType == "sqlexpress" || databaseType == "sqlserver")
                                {
                                    <div class="icb-form-field mb-3">
                                        <label class="icb-form-label" for="setupServer">Server Name</label>
                                        <input id="setupServer" type="text" class="icb-form-input" @bind="serverName"
                                               placeholder="@(databaseType == "sqlexpress" ? ".\\SQLEXPRESS" : "localhost")" />
                                    </div>

                                    <div class="icb-form-field mb-3">
                                        <label class="icb-form-label" for="setupDbName">Database Name</label>
                                        <input id="setupDbName" type="text" class="icb-form-input" @bind="databaseName" placeholder="Conduit" />
                                        <span class="icb-form-help">
                                            Defaults to <code>Conduit</code>. Use suffixes like <code>ConduitUSA1</code>, <code>ConduitUSA2</code> to run multiple instances side-by-side on one server.
                                        </span>
                                    </div>

                                    <div class="icb-form-field mb-3">
                                        <label class="icb-form-label" for="setupAuthType">Authentication</label>
                                        <select id="setupAuthType" class="icb-form-select" @bind="authType">
                                            <option value="windows">Windows Authentication</option>
                                            <option value="sql">SQL Server Authentication</option>
                                        </select>
                                    </div>

                                    @if (authType == "sql")
                                    {
                                        <div class="icb-form-field mb-3">
                                            <label class="icb-form-label" for="setupDbUser">Username</label>
                                            <input id="setupDbUser" type="text" class="icb-form-input" @bind="dbUsername" />
                                            @if (prefill.HasConnection && !prefill.IntegratedSecurity)
                                            {
                                                <span class="icb-form-help">
                                                    Re-enter the SQL login. Stored credentials are never shown on this page.
                                                </span>
                                            }
                                        </div>

                                        <div class="icb-form-field mb-3">
                                            <label class="icb-form-label" for="setupDbPassword">Password</label>
                                            <input id="setupDbPassword" type="password" class="icb-form-input" @bind="dbPassword" />
                                        </div>
                                    }

                                    <div class="icb-form-check mb-2">
                                        <input type="checkbox" id="trustServerCertificate" @bind="trustServerCertificate" />
                                        <label class="icb-form-check-label" for="trustServerCertificate">
                                            Trust server certificate (use for self-signed SSL certificates)
                                            <span class="icb-form-help">Enable this if you're getting SSL certificate trust errors. Not recommended for production.</span>
                                        </label>
                                    </div>

                                    <div class="icb-form-check mb-3">
                                        <input type="checkbox" id="encryptConnection" @bind="encryptConnection" />
                                        <label class="icb-form-check-label" for="encryptConnection">
                                            Encrypt connection
                                            <span class="icb-form-help">Uncheck this to disable encryption. May help with SSPI context errors.</span>
                                        </label>
                                    </div>
                                }
                                else if (databaseType == "custom")
                                {
                                    <div class="icb-form-field mb-3">
                                        <label class="icb-form-label" for="setupConnectionString">Connection String</label>
                                        <textarea id="setupConnectionString" class="icb-form-textarea" rows="3" @bind="config.ConnectionString"
                                                  placeholder="Server=localhost;Database=Conduit;..."></textarea>
                                    </div>
                                }

                                <div class="mb-3">
                                    <button type="button" class="ic-btn ic-btn-ghost ic-btn-sm" @onclick="TestConnection" disabled="@testingConnection">
                                        @if (testingConnection)
                                        {
                                            <i class="fas fa-spinner fa-spin me-2" aria-hidden="true"></i>
                                        }
                                        Test Connection
                                    </button>
                                    @if (connectionTest != null)
                                    {
                                        var noticeClass = GetTestAlertClass();
                                        <div class="icb-notice @noticeClass mt-2" role="status">
                                            <div class="icb-notice-body">
                                                @GetTestMessage()
                                                @if (!connectionTest.ServerReachable && !string.IsNullOrEmpty(connectionTest.ErrorMessage) &&
                                                     (connectionTest.ErrorMessage.Contains("SSPI") || connectionTest.ErrorMessage.Contains("principal name")))
                                                {
                                                    <hr class="icb-form-divider" />
                                                    <small>
                                                        <strong>SSPI Error Help:</strong>
                                                        <ul class="mb-0 ps-3">
                                                            <li>Try switching to SQL Server Authentication instead of Windows Authentication</li>
                                                            <li>Uncheck "Encrypt connection" above</li>
                                                            <li>Verify the server name is correct (use computer name instead of IP)</li>
                                                            <li>Check if SQL Server Browser service is running</li>
                                                        </ul>
                                                    </small>
                                                }
                                                @if (connectionTest.ServerReachable && !connectionTest.DatabaseExists && !string.IsNullOrWhiteSpace(connectionTest.DatabaseName))
                                                {
                                                    <hr class="icb-form-divider" />
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <button type="button" class="ic-btn icb-btn-caution ic-btn-sm" @onclick="CreateDatabaseNow" disabled="@creatingDatabase">
                                                            @if (creatingDatabase)
                                                            {
                                                                <i class="fas fa-spinner fa-spin me-2" aria-hidden="true"></i>
                                                            }
                                                            Create Database Now
                                                        </button>
                                                        <div class="icb-form-check ms-2 mb-0">
                                                            <input type="checkbox" id="autoCreateDb" @bind="autoCreateDatabase" />
                                                            <label class="icb-form-check-label" for="autoCreateDb">
                                                                Create on setup completion
                                                            </label>
                                                        </div>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(createDatabaseMessage))
                                                    {
                                                        <div class="mt-2 @(createDatabaseSuccess ? "icb-form-help" : "icb-form-error")">
                                                            @createDatabaseMessage
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (currentStep == 2)
                            {
                                <!-- Step 2: Admin User -->
                                <h4 class="section-title">Administrator Account</h4>
                                <p class="text-muted">Create the administrator account for Conduit.</p>

                                <div class="icb-form-field mb-3">
                                    <label class="icb-form-label" for="setupAdminUser">Admin Username</label>
                                    <InputText id="setupAdminUser" class="icb-form-input" @bind-Value="config.AdminUsername" />
                                    <div class="icb-form-error"><ValidationMessage For="@(() => config.AdminUsername)" /></div>
                                </div>

                                <div class="icb-form-field mb-3">
                                    <label class="icb-form-label" for="setupAdminPassword">Admin Password</label>
                                    <InputText id="setupAdminPassword" type="password" class="icb-form-input" @bind-Value="config.AdminPassword" />
                                    <div class="icb-form-error"><ValidationMessage For="@(() => config.AdminPassword)" /></div>
                                    <span class="icb-form-help">Minimum 8 characters</span>
                                </div>

                                <div class="icb-form-field mb-3">
                                    <label class="icb-form-label" for="setupConfirmPassword">Confirm Password</label>
                                    <input id="setupConfirmPassword" type="password" class="icb-form-input" @bind="confirmPassword" />
                                    @if (!string.IsNullOrEmpty(confirmPassword) && confirmPassword != config.AdminPassword)
                                    {
                                        <span class="icb-form-error">Passwords do not match</span>
                                    }
                                </div>
                            }
                            else if (currentStep == 3)
                            {
                                <!-- Step 3: Security Settings -->
                                <h4 class="section-title">Security Configuration</h4>
                                <p class="text-muted">Configure security settings for Conduit.</p>

                                <div class="icb-form-field mb-3">
                                    <label class="icb-form-label" for="setupJwtKey">JWT Secret Key</label>
                                    <div class="icb-form-input-group">
                                        @if (reusedExistingJwtKey)
                                        {
                                            <input id="setupJwtKey" type="text" class="icb-form-input icb-form-input-mono" value="Existing signing key retained" readonly />
                                        }
                                        else
                                        {
                                            <input id="setupJwtKey" type="text" class="icb-form-input icb-form-input-mono" @bind="config.JwtSecretKey" readonly />
                                        }
                                        <button type="button" class="ic-btn ic-btn-ghost" @onclick="GenerateSecretKey">
                                            Generate New
                                        </button>
                                    </div>
                                    @if (reusedExistingJwtKey)
                                    {
                                        <span class="icb-form-help">
                                            This install already has a signing key, so it is being kept — every API token
                                            already issued stays valid. Generating a new one invalidates all of them.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="icb-form-help">This key is used to sign JWT tokens. Keep it secure!</span>
                                    }
                                </div>

                                <div class="icb-form-field mb-3">
                                    <label class="icb-form-label" for="setupPort">Server Port</label>
                                    <InputNumber id="setupPort" class="icb-form-input" @bind-Value="config.ServerPort" />
                                </div>

                                <div class="icb-form-check mb-3">
                                    <InputCheckbox id="setupUseHttps" @bind-Value="config.UseHttps" />
                                    <label class="icb-form-check-label" for="setupUseHttps">
                                        Enable HTTPS (recommended for production)
                                    </label>
                                </div>
                            }
                            else if (currentStep == 4)
                            {
                                <!-- Step 4: Review -->
                                <h4 class="section-title">Review Configuration</h4>
                                <p class="text-muted">Please review your settings before completing setup.</p>

                                <div class="ic-field-grid p-0 mb-3">
                                    <div class="ic-field">
                                        <span class="ic-field-label">Server</span>
                                        <span class="ic-field-value">
                                            @if (databaseType == "localdb")
                                            {
                                                <text>SQL Server LocalDB</text>
                                            }
                                            else if (databaseType == "custom")
                                            {
                                                <text>Custom</text>
                                            }
                                            else
                                            {
                                                <text>@serverName</text>
                                            }
                                        </span>
                                    </div>

                                    @if (databaseType != "custom")
                                    {
                                        <div class="ic-field">
                                            <span class="ic-field-label">Database Name</span>
                                            <span class="ic-field-value">@(string.IsNullOrWhiteSpace(databaseName) ? "Conduit" : databaseName)</span>
                                        </div>
                                    }

                                    <div class="ic-field">
                                        <span class="ic-field-label">Admin Username</span>
                                        <span class="ic-field-value">@config.AdminUsername</span>
                                    </div>

                                    <div class="ic-field">
                                        <span class="ic-field-label">Server URL</span>
                                        <span class="ic-field-value mono">@(config.UseHttps ? "https" : "http")://localhost:@config.ServerPort</span>
                                    </div>

                                    <div class="ic-field">
                                        <span class="ic-field-label">JWT Security</span>
                                        <span class="ic-field-value">✓ Configured</span>
                                    </div>
                                </div>

                                @if (errors.Any())
                                {
                                    <div class="icb-notice icb-notice-danger" role="alert">
                                        <i class="oi oi-warning" aria-hidden="true"></i>
                                        <div class="icb-notice-body">
                                            <span class="icb-notice-title">Please fix the following errors:</span>
                                            <ul class="mb-0">
                                                @foreach (var error in errors)
                                                {
                                                    <li>@error</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                }
                            }

                    <div class="icb-wizard-foot">
                        <button type="button" class="ic-btn ic-btn-ghost" @onclick="PreviousStep"
                                disabled="@(currentStep == 1)">
                            ← Previous
                        </button>

                        @if (currentStep < 4)
                        {
                            <button type="button" class="ic-btn ic-btn-primary" @onclick="NextStep">
                                Next →
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="ic-btn ic-btn-primary" disabled="@isProcessing">
                                Complete Setup
                            </button>
                        }
                    </div>
                </EditForm>
            }
        </div>
    </main>
</div>

@code {
    private static readonly (string label, int num)[] _steps = new[]
    {
        ("Database", 1),
        ("Admin user", 2),
        ("Security", 3),
        ("Review", 4)
    };
    private static (string label, int num)[] StepList() => _steps;

    private string WizardHeading() => currentStep switch
    {
        1 => "Connect a database.",
        2 => "Create your admin.",
        3 => "Lock things down.",
        4 => "Review and go.",
        _ => "Conduit setup."
    };

    private string WizardLede() => currentStep switch
    {
        1 => "Where should Conduit store users, groups, tokens, and audit logs? Point it at a SQL Server you can reach; we'll create the database for you if it doesn't exist yet.",
        2 => "The first user to sign in to the portal. Pick something memorable — you can rotate the password later from the admin panel.",
        3 => "JWT signing key and the public port the SCIM API will bind to. Defaults are sensible; only change them if you have a reason.",
        4 => "Last look before we apply everything. Nothing has been written yet.",
        _ => ""
    };

    private SetupConfiguration config = new();
    private int currentStep = 1;
    private bool isProcessing = false;
    private bool setupComplete = false;
    private List<string> errors = new();

    // Database configuration
    private string databaseType = "sqlserver";
    private string serverName = "localhost";
    private string databaseName = "Conduit";
    private string authType = "sql";
    private string dbUsername = "sa";
    private string dbPassword = "";
    private bool trustServerCertificate = true;
    private bool encryptConnection = false;

    // Password confirmation
    private string confirmPassword = "";

    // Connection test
    private bool testingConnection = false;
    private ConnectionTestResult? connectionTest;
    private bool autoCreateDatabase = true;
    private bool creatingDatabase = false;
    private string createDatabaseMessage = "";
    private bool createDatabaseSuccess = false;

    // Connection details the app has already resolved. Never carries a password —
    // /setup is anonymous and must not render a stored credential.
    private SetupPrefill prefill = new();

    /// <summary>True while config.JwtSecretKey holds this install's REAL key, which must
    /// not be rendered on this anonymous page. Cleared as soon as a new one is generated.</summary>
    private bool reusedExistingJwtKey;

    protected override async Task OnInitializedAsync()
    {
        // Only bounce to the app when the database is genuinely READY (reachable + set up).
        // If it's Unreachable, the operator opened /setup specifically to repoint Conduit at a
        // different, reachable server — redirecting to "/" would just bounce them to /db-offline
        // and evict what they were typing. Keep the wizard open so they can reconnect.
        var status = await SetupService.GetDatabaseStatusAsync();
        if (status == DatabaseStatus.Ready)
        {
            Navigation.NavigateTo("/");
        }
        else if (status == DatabaseStatus.NeedsAdminRecovery)
        {
            // Schema present, nobody can sign in. That is not a first run and this wizard
            // is not the repair for it — recovery requires the host-local token.
            //
            // Set the render state BEFORE navigating and returning. This return skips
            // ApplyPrefillAsync, so prefill.RecoveryRequired would otherwise stay false and
            // the recovery branch in the markup — the branch that keeps the EditForm out of
            // the render tree — would never fire on the one path it is named for. A client
            // that ignores the redirect would get the full wizard rendered to it.
            prefill = new SetupPrefill { RecoveryRequired = true };
            Navigation.NavigateTo("/admin-recovery", forceLoad: true);
            return;
        }

        await ApplyPrefillAsync();
    }

    /// <summary>
    /// Seeds the wizard from the NON-SECRET shape of the configuration the app already
    /// resolved — auth mode and the TLS checkboxes, so they start where the install is.
    ///
    /// The server hostname, the database name, the SQL login, and the SQL password are all
    /// deliberately withheld. This page is anonymous and it hands a visitor a connection
    /// tester and a CREATE DATABASE against a server they name; rendering the real server
    /// and database turns a blind probe into a targeted one. Those fields fall back to
    /// their defaults, which the operator retypes — that is the intended cost.
    /// </summary>
    private async Task ApplyPrefillAsync()
    {
        try
        {
            prefill = await SetupService.GetSetupPrefillAsync();
        }
        catch (Exception ex)
        {
            // Prefill is a convenience. It must never be the reason the wizard won't render.
            Logger.LogWarning(ex, "Could not read the resolved connection for setup prefill.");
            prefill = new SetupPrefill();
        }

        if (prefill.HasConnection)
        {
            // NOTE: prefill.ConnectionString is never assigned to config here. It carries
            // the SQL password, and the "Custom" database type binds config.ConnectionString
            // straight into a textarea on this ANONYMOUS page. The wizard rebuilds the
            // string from the visible fields in UpdateConnectionString(), so seeding it
            // would buy nothing and would put the password one dropdown change from the DOM.
            authType = prefill.IntegratedSecurity ? "windows" : "sql";
            trustServerCertificate = prefill.TrustServerCertificate;
            encryptConnection = prefill.Encrypt;
        }

        if (prefill.ServerPort is > 0)
        {
            config.ServerPort = prefill.ServerPort.Value;
        }

        if (!string.IsNullOrWhiteSpace(prefill.JwtSecretKey))
        {
            // Reuse the existing signing key. Rotating it here would invalidate every API
            // token already issued against this install.
            //
            // SECURITY: /setup is anonymous, and step 3 renders the key into the DOM. A
            // freshly generated throwaway key is harmless there, but a LIVE install's real
            // signing key is not — anyone who could reach the page could forge tokens. So
            // the flag below suppresses the value and shows a placeholder instead; the key
            // itself stays server-side.
            config.JwtSecretKey = prefill.JwtSecretKey!;
            reusedExistingJwtKey = true;
        }
        else
        {
            GenerateSecretKey();
        }
    }

    private void NextStep()
    {
        errors.Clear();

        // Validate current step
        if (currentStep == 1)
        {
            UpdateConnectionString();
            if (string.IsNullOrWhiteSpace(config.ConnectionString))
            {
                errors.Add("Please configure the database connection");
                return;
            }
            if (connectionTest == null)
            {
                errors.Add("Please test the connection before continuing.");
                return;
            }
            if (!connectionTest.ServerReachable)
            {
                errors.Add("Database server is not reachable. Fix the connection and re-test.");
                return;
            }
            if (!connectionTest.DatabaseExists && !autoCreateDatabase)
            {
                errors.Add($"Database '{connectionTest.DatabaseName}' does not exist. Either create it now, or check 'Create on setup completion'.");
                return;
            }
            config.AutoCreateDatabase = autoCreateDatabase;
        }
        else if (currentStep == 2)
        {
            if (string.IsNullOrWhiteSpace(config.AdminUsername))
            {
                errors.Add("Admin username is required");
                return;
            }
            if (string.IsNullOrWhiteSpace(config.AdminPassword) || config.AdminPassword.Length < 8)
            {
                errors.Add("Admin password must be at least 8 characters");
                return;
            }
            if (config.AdminPassword != confirmPassword)
            {
                errors.Add("Passwords do not match");
                return;
            }
        }

        if (currentStep < 4)
        {
            currentStep++;
        }
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
        }
    }

    private void UpdateConnectionString()
    {
        var db = string.IsNullOrWhiteSpace(databaseName) ? "Conduit" : databaseName.Trim();

        if (databaseType == "localdb")
        {
            config.ConnectionString = $"Server=(localdb)\\mssqllocaldb;Database={db};Trusted_Connection=True;";
        }
        else if (databaseType == "sqlexpress" || databaseType == "sqlserver")
        {
            var server = string.IsNullOrWhiteSpace(serverName)
                ? (databaseType == "sqlexpress" ? ".\\SQLEXPRESS" : "localhost")
                : serverName;

            if (authType == "windows")
            {
                config.ConnectionString = $"Server={server};Database={db};Trusted_Connection=True;";
            }
            else
            {
                config.ConnectionString = $"Server={server};Database={db};User Id={dbUsername};Password={dbPassword};";
            }

            // Add encryption settings
            if (!encryptConnection)
            {
                config.ConnectionString += "Encrypt=False;";
            }

            // Add TrustServerCertificate if enabled
            if (trustServerCertificate)
            {
                config.ConnectionString += "TrustServerCertificate=True;";
            }
        }
    }

    private async Task TestConnection()
    {
        testingConnection = true;
        createDatabaseMessage = "";
        UpdateConnectionString();

        try
        {
            connectionTest = await SetupService.TestConnectionAsync(config.ConnectionString);
        }
        catch (Exception ex)
        {
            // An unhandled exception in a Blazor Server event handler tears down the
            // circuit and takes every typed field with it. A failed test must never do
            // more than render an inline error. The operator sees the driver's own text
            // ("Login failed for user 'sa'", "No such host is known") because that is the
            // only thing that tells them what to fix; the full detail also goes to the log.
            Logger.LogWarning(ex, "Connection test failed.");
            connectionTest = new ConnectionTestResult { ErrorMessage = ex.Message };
        }
        finally
        {
            testingConnection = false;
        }
    }

    private async Task CreateDatabaseNow()
    {
        if (connectionTest == null) return;
        creatingDatabase = true;
        createDatabaseMessage = "";
        try
        {
            var (success, message) = await SetupService.CreateDatabaseAsync(config.ConnectionString);
            createDatabaseSuccess = success;
            createDatabaseMessage = message;
            if (success)
            {
                connectionTest = await SetupService.TestConnectionAsync(config.ConnectionString);
            }
        }
        finally
        {
            creatingDatabase = false;
        }
    }

    private string GetTestAlertClass()
    {
        if (connectionTest == null) return "icb-notice-neutral";
        if (!connectionTest.ServerReachable) return "icb-notice-danger";
        if (!connectionTest.DatabaseExists) return "icb-notice-warning";
        return "icb-notice-success";
    }

    private string GetTestMessage()
    {
        if (connectionTest == null) return "";
        if (!connectionTest.ServerReachable)
        {
            return $"Connection failed: {connectionTest.ErrorMessage}";
        }
        if (!connectionTest.DatabaseExists)
        {
            return $"Connected to server, but database '{connectionTest.DatabaseName}' does not exist.";
        }
        if (!connectionTest.SchemaExists)
        {
            return $"Connected. Database '{connectionTest.DatabaseName}' exists but is empty — schema will be created on setup completion.";
        }
        return $"Connection successful. Database '{connectionTest.DatabaseName}' is ready (existing schema detected).";
    }

    private void GenerateSecretKey()
    {
        using var rng = RandomNumberGenerator.Create();
        var bytes = new byte[64];
        rng.GetBytes(bytes);
        config.JwtSecretKey = Convert.ToBase64String(bytes);
        reusedExistingJwtKey = false;
    }

    private async Task HandleValidSubmit()
    {
        isProcessing = true;
        errors.Clear();

        // Final validation
        var validationResult = SetupService.ValidateSetup(config);
        if (!validationResult.IsValid)
        {
            foreach (var errorList in validationResult.Errors.Values)
            {
                errors.AddRange(errorList);
            }
            isProcessing = false;
            return;
        }

        // Apply setup. The service performs an authoritative server-side completion
        // check; if setup is already done it throws and we send the operator to the
        // login page instead of re-applying anything.
        try
        {
            var success = await SetupService.ApplySetupAsync(config);
            if (success)
            {
                setupComplete = true;
                await Task.Delay(2000);
                // Force a hard reload to ensure the application restarts and picks up the new configuration
                await JSRuntime.InvokeVoidAsync("eval", "window.location.href = '/';");
            }
            else
            {
                errors.Add("Setup failed. Please check the logs for more information.");
                isProcessing = false;
            }
        }
        catch (SetupAlreadyCompletedException)
        {
            // Setup was completed by another request/session. Bounce to the app root.
            isProcessing = false;
            Navigation.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            // ANY other failure must render inline. An unhandled exception in a Blazor Server
            // event handler tears down the circuit, so before this existed a first-run
            // operator who clicked "Complete Setup" got a dead page with nothing to act on —
            // and any change that made ApplySetupAsync throw earlier than expected turned
            // into exactly that, invisibly. The detail goes to the log, not to the page:
            // /setup is anonymous and driver messages carry server and database names.
            Logger.LogError(ex, "First-run setup failed: {Message}", ex.Message);
            errors.Add("Setup could not be completed. Check the application log on the Conduit host.");
            isProcessing = false;
        }
    }
}
