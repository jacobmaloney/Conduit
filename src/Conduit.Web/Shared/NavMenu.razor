@using Conduit.Core.Models
@using Conduit.Core.Services
@using Conduit.DataAccess.Repositories
@using Conduit.Web.Services
@inject OpenAccessState OpenAccess
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment Environment

<div class="ic-sidebar">
    @* Open-access warning pill (portal authentication is OFF), Development-gated. *@
    @if (ShowDevChrome && OpenAccess.IsEnabled)
    {
        <a class="open-access-pill" href="configuration" title="Portal authentication is OFF — click to manage in Configuration">
            <i class="fas fa-triangle-exclamation"></i>
            <span>Open access</span>
        </a>
    }

    <nav>
        @* Conduit is a directory-sync engine: Connections + Sync Projects are the
           whole experience. The Synchronization Center hub hosts Projects /
           History / Schedules / Processing as tabs (see SynchronizationCenter.razor). *@
        <div class="ic-nav-group section-identity">
            <div class="ic-nav-group-label">Main</div>
            <NavLink class="ic-nav-item" ActiveClass="on-identity" href="" Match="NavLinkMatch.All">
                <i class="fas fa-gauge-high"></i>
                <span>Dashboard</span>
            </NavLink>
        </div>

        <div class="ic-nav-group section-operations">
            <div class="ic-nav-group-label">Sync</div>
            <NavLink class="ic-nav-item" ActiveClass="on-operations" href="synchronization-center">
                <i class="fas fa-arrows-rotate"></i>
                <span>Synchronization Center</span>
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-operations" href="connected-systems">
                <i class="fas fa-globe"></i>
                <span>Connections</span>
            </NavLink>
        </div>

        <div class="ic-nav-group section-analytics">
            <div class="ic-nav-group-label">Tools</div>
            <NavLink class="ic-nav-item" ActiveClass="on-analytics" href="quick-connect">
                <i class="fas fa-link"></i>
                <span>Quick Connect</span>
            </NavLink>
            @* API Explorer + API Tokens are SCIM-origin chrome — kept but gated to
               Development so they don't clutter the primary directory-sync nav. *@
            @if (ShowDevChrome)
            {
                <NavLink class="ic-nav-item" ActiveClass="on-analytics" href="api-explorer">
                    <i class="fas fa-code"></i>
                    <span>API Explorer</span>
                </NavLink>
                <NavLink class="ic-nav-item" ActiveClass="on-analytics" href="tokens">
                    <i class="fas fa-key"></i>
                    <span>API Tokens</span>
                </NavLink>
            }
        </div>

        <div class="ic-nav-group section-configure">
            <div class="ic-nav-group-label">Settings</div>
            <NavLink class="ic-nav-item" ActiveClass="on-configure" href="configuration">
                <i class="fas fa-gear"></i>
                <span>Configuration</span>
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-configure" href="admin/identity-providers">
                <i class="fas fa-id-card"></i>
                <span>Identity Providers</span>
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-configure" href="database-settings">
                <i class="fas fa-database"></i>
                <span>Database</span>
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-configure" href="audit-log">
                <i class="fas fa-list"></i>
                <span>Audit Log</span>
            </NavLink>
            <NavLink class="ic-nav-item" ActiveClass="on-configure" href="logs">
                <i class="fas fa-bug"></i>
                <span>Debug Logs</span>
            </NavLink>
        </div>
    </nav>

    <div class="ic-sidebar-scope">
        <AuthorizeView>
            <Authorized>
                <div class="mb-2">
                    <strong>Signed in as</strong>
                    @context.User.Identity?.Name
                </div>
                <a class="btn btn-sm btn-outline-secondary w-100" href="/logout">Sign out</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-sm btn-outline-primary w-100" href="/login">Sign in</a>
            </NotAuthorized>
        </AuthorizeView>
        <div class="mt-2">
            <div>Identity synchronization</div>
            <div>Version 1.0.0</div>
        </div>
    </div>
</div>

@code {
    // SCIM-origin chrome (Open-access pill, API Explorer, API Tokens) is gated to
    // Development for the directory-sync product — kept off the production nav.
    private bool ShowDevChrome => Environment.IsDevelopment();
}
