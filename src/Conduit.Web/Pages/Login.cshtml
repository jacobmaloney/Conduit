@page "/login"
@model Conduit.Web.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - Conduit</title>
    <base href="~/" />
    <link rel="icon" type="image/svg+xml" href="~/assets/brand/conduit-mark.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <meta name="theme-color" content="#FAFAF7" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    @* CenturyCity warm-paper theme — the SAME stylesheet IdentityCenter's login uses, so
       this page matches IC exactly. It is self-contained (defines its own :root tokens +
       .cc-* classes) and light by default, so the standalone login needs nothing else. *@
    <link rel="stylesheet" href="css/centurycity.css" />
    <link rel="stylesheet" href="lib/fontawesome/css/all.min.css" />
    <style>
        /* Login layout — ported verbatim from IdentityCenter's Login.cshtml for parity. */
        .cc-login-shell { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 48px 20px; }
        .cc-login-card {
            width: 100%; max-width: 420px;
            background: var(--color-surface);
            border: 1px solid var(--color-line);
            border-radius: var(--cc-radius-card);
            box-shadow: var(--cc-shadow-card);
            padding: 40px 38px 32px;
        }
        .cc-login-mark { display: flex; align-items: center; gap: 11px; margin-bottom: 26px; }
        .cc-login-mark img { display: block; }
        .cc-login-wordmark { font-weight: 700; letter-spacing: -0.02em; font-size: 16.5px; color: var(--color-ink); }
        .cc-login-card h1 { font-size: 26px; font-weight: 700; letter-spacing: -0.028em; line-height: 1.12; margin: 14px 0 0; color: var(--color-ink); }
        .cc-login-sub { font-size: 14.5px; color: var(--color-ink-2); margin: 8px 0 0; }
        .cc-login-form { margin-top: 26px; }
        .cc-login-form .cc-field-label { margin-bottom: 6px; }
        .cc-login-form .cc-field { margin-bottom: 14px; }
        .cc-login-footer { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--color-line); display: flex; flex-direction: column; gap: 9px; font-size: 13px; }
        .cc-login-footer a { color: var(--color-cyan-deep); text-decoration: none; font-weight: 500; }
        .cc-login-footer a:hover { text-decoration: underline; }
        .cc-login-footer .muted { color: var(--color-ink-3); }
        .cc-login-divider { display: flex; align-items: center; gap: 12px; margin: 22px 0; font-family: var(--cc-font-mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
        .cc-login-divider::before, .cc-login-divider::after { content: ""; flex: 1; height: 1px; background: var(--color-line); }
        .cc-ext-btn { width: 100%; margin-bottom: 8px; }
        .cc-val-summary { color: var(--color-danger); font-size: 13px; margin-bottom: 12px; }
    </style>
</head>
<body>
<div class="cc-site">
    <div class="cc-login-shell">
        <div class="cc-login-card">
            <div class="cc-login-mark">
                <img src="~/assets/brand/conduit-mark-light-bg.svg" width="28" height="28" alt="" />
                <span class="cc-login-wordmark">Conduit</span>
            </div>

            <div class="cc-eyebrow"><span class="cc-eyebrow-rule"></span>Sign in</div>
            <h1>Welcome <span class="cc-serif">back</span></h1>
            <p class="cc-login-sub">Sign in to your account</p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="cc-val-summary">@Model.ErrorMessage</div>
            }
            @if (Model.SsoError)
            {
                @* Generic, non-enumerating message: never reveals whether the federated
                   identity exists, only that sign-in did not complete. *@
                <div class="cc-val-summary">Single sign-on could not complete. Contact your administrator or sign in below.</div>
            }

            @if (Model.ExternalProviders.Count > 0)
            {
                <div class="cc-login-divider">Organization account</div>
                @foreach (var idp in Model.ExternalProviders)
                {
                    <a class="cc-btn-line cc-ext-btn"
                       href="@($"/login/sso?provider={Uri.EscapeDataString(idp.Name)}&returnUrl={Uri.EscapeDataString(Model.ReturnUrl ?? "/")}")">
                        <i class="fas fa-sign-in-alt"></i>Sign in with @idp.Name
                    </a>
                }
                <div class="cc-login-divider">or local account</div>
            }

            <form method="post" class="cc-login-form">
                <div class="cc-field">
                    <label class="cc-field-label" for="Username">Username</label>
                    <input type="text" class="cc-in" id="Username" name="Username" value="@Model.Username" placeholder="Username" autofocus required />
                </div>
                <div class="cc-field">
                    <label class="cc-field-label" for="Password">Password</label>
                    <input type="password" class="cc-in" id="Password" name="Password" placeholder="Your password" required />
                </div>
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="cc-btn-ink cc-btn-block">Sign In</button>
            </form>
        </div>
    </div>
</div>
</body>
</html>
