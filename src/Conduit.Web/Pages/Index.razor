@page "/"
@attribute [Authorize]
@using Conduit.Core.SyncModels
@inject Conduit.DataAccess.Repositories.UserRepository UserRepository
@inject Conduit.DataAccess.Repositories.TenantRepository TenantRepo
@inject Conduit.DataAccess.Repositories.SyncProjectRepository ProjectRepo
@inject Conduit.DataAccess.Repositories.SyncRunRepository RunRepo
@inject Conduit.DataAccess.Repositories.SystemConfigurationRepository Config
@inject IWebHostEnvironment Environment

<PageTitle>Conduit — move identities across connected systems.</PageTitle>

<div class="cx-page">
    <div class="cx-page-head">
        <div>
            <div class="cx-page-title">Dashboard</div>
            <div class="cx-page-sub">Everything that moves identities, at a glance.</div>
        </div>
        <div class="cx-page-head-spacer"></div>
        <div class="cx-page-actions">
            <a href="/getting-started" class="cx-btn"><i class="fas fa-list-check"></i> Getting Started</a>
            <a href="/sync-projects" class="cx-btn cx-btn--primary"><i class="fas fa-play"></i> Run All Syncs</a>
        </div>
    </div>

    @if (_showGettingStarted)
    {
        <div class="alert alert-info d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3" role="alert">
            <div>
                <i class="fas fa-list-check me-2"></i>
                <strong>New to Conduit?</strong> Finish setting up — connect a system, point it at IdentityCenter, and run your first sync.
            </div>
            <div class="d-flex gap-2 align-items-center">
                <a href="/getting-started" class="btn btn-sm btn-primary">Getting Started</a>
                <button type="button" class="btn-close" aria-label="Dismiss" @onclick="DismissGettingStarted"></button>
            </div>
        </div>
    }

    <div class="cx-statband">
        <div class="cx-stat">
            <div class="cx-stat-label">Total Users</div>
            <div class="cx-stat-val">@userCount.ToString("N0")</div>
            <div class="cx-stat-sub">across systems</div>
        </div>
        <div class="cx-stat">
            <div class="cx-stat-label">Connections</div>
            <div class="cx-stat-val">@connectionCount.ToString("N0")</div>
            <div class="cx-stat-sub">@activeConnectionCount active</div>
        </div>
        <div class="cx-stat">
            <div class="cx-stat-label">Sync Projects</div>
            <div class="cx-stat-val">@projectCount.ToString("N0")</div>
            <div class="cx-stat-sub">@EnabledProjectsSub</div>
        </div>
        <div class="cx-stat">
            <div class="cx-stat-label">Runs Today</div>
            <div class="cx-stat-val @(runsTodayCount > 0 ? "ok" : "")">@runsTodayCount.ToString("N0")</div>
            <div class="cx-stat-sub">@failedTodayCount failed</div>
        </div>
        <div class="cx-stat">
            <div class="cx-stat-label">Last Run</div>
            <div class="cx-stat-val @LastRunValueClass">@LastRunShort</div>
            <div class="cx-stat-sub">@LastRunSub</div>
        </div>
    </div>

    <div class="cx-dash-grid">
        <div class="cx-card">
            <div class="cx-card-head">
                <span class="cx-card-title">Sync projects</span>
                <a href="/sync-projects" class="cx-card-link">Open Sync Center →</a>
            </div>
            @if (projectList.Count == 0)
            {
                <div class="text-muted small">No sync projects yet. <a href="/sync-projects">Create one →</a></div>
            }
            else
            {
                <div class="cx-rows">
                    @foreach (var p in projectList.Take(6))
                    {
                        <div class="cx-row">
                            <span class="cx-dot @StatusDotClass(p.LastRunStatus)"></span>
                            <div class="cx-row-main">
                                <div class="cx-row-name">@p.Name</div>
                                <div class="cx-row-meta">@TenantName(p.SourceTenantId) → @TenantName(p.SinkTenantId) · @p.ObjectClass</div>
                            </div>
                            <span class="cx-pill cx-pill--runs">@p.SuccessfulRuns/@p.TotalRuns runs</span>
                            <span class="cx-row-time">@(p.LastRunAt is { } lr ? RelativeTime(lr) : "never")</span>
                            <a href="/sync-projects" class="cx-btn cx-btn--run cx-btn--xs"><i class="fas fa-play"></i> Run</a>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="cx-col-stack">
            <div class="cx-card">
                <div class="cx-card-title" style="margin-bottom:10px;">Next scheduled run</div>
                <div class="cx-bigtime">@NextRunLabel</div>
                <div class="cx-card-sub">@scheduledCount schedules · @failingCount failing</div>
                <div class="d-flex gap-2 mt-3">
                    <a href="/schedules" class="cx-btn cx-btn--md">Schedules</a>
                    <a href="/sync-history" class="cx-btn cx-btn--md">Run history</a>
                </div>
            </div>
            <div class="cx-card">
                <div class="cx-card-title" style="margin-bottom:10px;">Recent activity</div>
                @if (recentRuns.Count == 0)
                {
                    <div class="text-muted small">No runs recorded yet.</div>
                }
                else
                {
                    <div class="cx-activity">
                        @foreach (var r in recentRuns.Take(6))
                        {
                            <div>
                                <span class="@StatusGlyphClass(r.Status)">@StatusGlyph(r.Status)</span>
                                @ProjectName(r.SyncProjectId) — @r.ObjectsRead read, @r.ObjectsCreated created, @r.ObjectsUpdated updated
                                <span class="text-muted">· @RelativeTime(r.CompletedAt ?? r.StartedAt)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int userCount = 0;
    private int connectionCount = 0;
    private int activeConnectionCount = 0;
    private int projectCount = 0;
    private int enabledProjectCount = 0;
    private int scheduledCount = 0;
    private int failingCount = 0;
    private int runsTodayCount = 0;
    private int failedTodayCount = 0;

    private string? lastRunStatus;
    private DateTime? lastRunWhen;
    private DateTime? nextScheduledRun;

    private List<SyncProject> projectList = new();
    private List<SyncRun> recentRuns = new();
    private Dictionary<Guid, string> tenantNames = new();
    private Dictionary<Guid, string> projectNames = new();

    private bool _showGettingStarted;

    private string EnabledProjectsSub =>
        projectCount > 0 && enabledProjectCount == projectCount ? "all enabled" : $"{enabledProjectCount} enabled";

    private string NextRunLabel => nextScheduledRun is { } n ? n.ToLocalTime().ToString("ddd, h:mm tt") : "No schedule";

    private string LastRunShort => lastRunWhen is { } w ? ShortRelative(w) : "—";
    private string LastRunSub => lastRunWhen is null ? "no runs yet" : $"ago · {(lastRunStatus ?? "unknown").ToLowerInvariant()}";
    private string LastRunValueClass => lastRunStatus switch
    {
        "Completed" or "Succeeded" => "ok",
        "Failed" or "Error" => "muted",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        try { _showGettingStarted = !string.Equals(await Config.GetValueAsync("GettingStarted.Dismissed"), "true", StringComparison.OrdinalIgnoreCase); }
        catch { _showGettingStarted = false; }

        try
        {
            var (_, count) = await UserRepository.GetAllAsync(new Conduit.Core.Models.ScimQueryOptions { Count = 1 });
            userCount = count;
        }
        catch { userCount = 0; }

        try
        {
            var tenants = await TenantRepo.GetAllAsync(includeInactive: true);
            connectionCount = tenants.Count;
            activeConnectionCount = tenants.Count(t => t.IsActive);
            tenantNames = tenants.ToDictionary(t => t.Id, t => t.Name);
        }
        catch { connectionCount = 0; }

        try
        {
            projectList = await ProjectRepo.GetAllAsync();
            projectCount = projectList.Count;
            enabledProjectCount = projectList.Count(p => p.IsEnabled);
            scheduledCount = projectList.Count(p => !string.IsNullOrWhiteSpace(p.CronSchedule));
            failingCount = projectList.Count(p => p.LastRunStatus == "Failed");
            projectNames = projectList.ToDictionary(p => p.Id, p => p.Name);
            nextScheduledRun = projectList
                .Where(p => p.IsEnabled && p.NextScheduledRunAt.HasValue)
                .Select(p => p.NextScheduledRunAt!.Value)
                .DefaultIfEmpty()
                .Min();
            if (nextScheduledRun == default(DateTime)) nextScheduledRun = null;
        }
        catch { projectList = new(); }

        try
        {
            recentRuns = await RunRepo.GetRecentAsync(take: 200);
            var today = DateTime.UtcNow.Date;
            runsTodayCount = recentRuns.Count(r => r.StartedAt.Date == today);
            failedTodayCount = recentRuns.Count(r => r.StartedAt.Date == today && (r.Status == "Failed" || r.Status == "Error"));
            var latest = recentRuns.OrderByDescending(r => r.CompletedAt ?? r.StartedAt).FirstOrDefault();
            if (latest is not null)
            {
                lastRunStatus = latest.Status;
                lastRunWhen = latest.CompletedAt ?? latest.StartedAt;
            }
        }
        catch { recentRuns = new(); }
    }

    private string TenantName(Guid id) => tenantNames.TryGetValue(id, out var n) ? n : "—";
    private string ProjectName(Guid id) => projectNames.TryGetValue(id, out var n) ? n : "Sync project";

    private static string StatusDotClass(string? status) => status switch
    {
        "Completed" or "Succeeded" => "",
        "Failed" or "Error" => "cx-dot--fail",
        "Running" => "cx-dot--run",
        _ => "cx-dot--idle"
    };

    private static string StatusGlyph(string? status) => status switch
    {
        "Completed" or "Succeeded" => "✓",
        "Failed" or "Error" => "✗",
        "Running" => "●",
        _ => "＋"
    };

    private static string StatusGlyphClass(string? status) => status switch
    {
        "Failed" or "Error" => "add",
        "Running" => "add",
        _ => "ok"
    };

    private static string RelativeTime(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    private static string ShortRelative(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;
        if (span.TotalMinutes < 1) return "now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h";
        return $"{(int)span.TotalDays}d";
    }

    private async Task DismissGettingStarted()
    {
        try
        {
            await Config.UpsertAsync("GettingStarted.Dismissed", "true", "Boolean",
                "Getting Started checklist dismissed by the operator.");
        }
        catch { }
        _showGettingStarted = false;
    }
}
