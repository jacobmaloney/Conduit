@page "/admin/identity-providers"
@attribute [Authorize]
@using System.Text.Json
@using System.Net.Http
@using Conduit.Web.Authentication
@using Conduit.DataAccess.Repositories
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Components.Modals
@using IdentityCenter.Brand.Models
@inject IdentityProviderRepository ProviderRepo
@inject ISecretProtector SecretProtector
@inject IHttpClientFactory HttpClientFactory
@inject AuthenticationStateProvider AuthState
@inject IJSRuntime JSRuntime

<PageTitle>Identity Providers - Conduit</PageTitle>

<div class="container-fluid identities-container">
    <Template1 Icon="oi oi-key" IconAccent="slate"
               Title="Identity Providers"
               Subtitle="Optional single sign-on. SSO maps to an existing admin — it never creates accounts.">
        <PrimaryAction>
            <button type="button" class="ic-btn ic-btn-primary" @onclick="OpenCreate">
                <i class="oi oi-plus" aria-hidden="true"></i> Add provider
            </button>
        </PrimaryAction>
    </Template1>

    <div class="icb-notice icb-notice-info mb-3">
        <i class="oi oi-info" aria-hidden="true"></i>
        <div class="icb-notice-body">
            Single sign-on is <strong>optional</strong>. With no enabled providers, the portal uses local
            username/password only. A successful SSO sign-in must match an <strong>existing active admin</strong>
            by username or email — no accounts are auto-created; manage those accounts under
            <a href="/admin/portal-admins">Portal Admins</a>. Changes take effect after an app restart.
        </div>
    </div>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="icb-notice @(actionOk ? "icb-notice-success" : "icb-notice-danger") mb-3" role="status">
            <i class="oi @(actionOk ? "oi-check" : "oi-warning")" aria-hidden="true"></i>
            <div class="icb-notice-body">@actionMessage</div>
            <button type="button" class="icb-notice-dismiss" aria-label="Dismiss" @onclick="() => actionMessage = null">&times;</button>
        </div>
    }

    <BrandListTable TItem="IdentityProvider" Title="Identity providers" Items="@providers" TotalCount="@providers.Count"
                    PageSize="@Math.Max(1, providers.Count)" State="@(loading ? BrandListState.Loading : BrandListState.Ready)"
                    EmptyMessage="No identity providers. Add an OIDC or Azure AD provider to enable single sign-on for your existing admins.">
        <HeaderTemplate>
            <th scope="col">Name</th><th scope="col">Type</th><th scope="col">Authority</th><th scope="col">Status</th><th scope="col">Actions</th>
        </HeaderTemplate>
        <RowTemplate Context="p">
            <td class="nm-cell">@p.Name</td>
            <td><BrandBadge Text="@p.Type" Soft="true" /></td>
            <td class="mono">@AuthorityFor(p)</td>
            <td>
                @if (p.IsEnabled)
                {
                    <BrandBadge Text="Enabled" Tone="BrandBadgeTone.Success" Soft="true" />
                }
                else
                {
                    <BrandBadge Text="Disabled" Tone="BrandBadgeTone.Neutral" Soft="true" />
                }
            </td>
            <td>
                <div class="icb-table-actions">
                    <button type="button" class="ic-btn ic-btn-ghost ic-btn-sm" @onclick="() => OpenEdit(p)">
                        <i class="oi oi-pencil" aria-hidden="true"></i> Edit
                    </button>
                    <button type="button" class="ic-btn icb-btn-caution ic-btn-sm" @onclick="() => ToggleEnabled(p)">
                        @(p.IsEnabled ? "Disable" : "Enable")
                    </button>
                    <button type="button" class="ic-btn ic-btn-danger ic-btn-sm" @onclick="() => DeleteProvider(p)" aria-label="@($"Delete {p.Name}")" title="Delete">
                        <i class="oi oi-trash" aria-hidden="true"></i>
                    </button>
                </div>
            </td>
        </RowTemplate>
    </BrandListTable>

    <BrandConfirmationModal @ref="confirmModal" ConfirmLabel="Delete" />
</div>

@if (showModal)
{
    <BrandEditorDialog Label="@(editingId == null ? "Add identity provider" : "Edit identity provider")">
        <HeaderContent>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="icb-editor-title mb-1">
                        <i class="oi oi-key me-2" aria-hidden="true"></i>
                        <span>@(editingId == null ? "Add identity provider" : "Edit identity provider")</span>
                    </h1>
                    <p class="icb-editor-subtitle mb-0">Test GETs the provider's /.well-known/openid-configuration.</p>
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <button type="button" class="ic-btn ic-btn-ghost" @onclick="TestConnection" disabled="@(saving || testInFlight)">
                        @if (testInFlight)
                        {
                            <i class="fas fa-spinner fa-spin me-1" aria-hidden="true"></i>
                        }
                        else
                        {
                            <i class="oi oi-pulse me-1" aria-hidden="true"></i>
                        }
                        Test Connection
                    </button>
                    <button type="button" class="ic-btn ic-btn-ghost" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="ic-btn ic-btn-primary" @onclick="Save" disabled="@saving">Save</button>
                </div>
            </div>
        </HeaderContent>
        <ChildContent>
            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="icb-notice icb-notice-danger mb-3" role="alert"><div class="icb-notice-body">@formError</div></div>
            }
            @if (!string.IsNullOrEmpty(testResult))
            {
                <div class="icb-notice @(testOk ? "icb-notice-success" : "icb-notice-danger") mb-3" role="status">
                    <div class="icb-notice-body">@testResult</div>
                    <button type="button" class="icb-notice-dismiss" aria-label="Dismiss" @onclick="@(() => testResult = string.Empty)">&times;</button>
                </div>
            }
            <form>
                <div class="icb-settings-grid">
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="idpName">Name *</label>
                        <input id="idpName" type="text" class="icb-form-input" @bind="form.Name" placeholder="e.g., Contoso Azure AD" />
                        <span class="icb-form-help">Also the sign-in button label and scheme name.</span>
                    </div>
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="idpType">Type *</label>
                        <select id="idpType" class="icb-form-select" @bind="form.Type">
                            <option value="OIDC">Generic OIDC</option>
                            <option value="AzureAD">Azure AD</option>
                        </select>
                    </div>
                </div>

                <hr class="icb-form-divider" />
                <h3 class="section-title">@(form.Type == "AzureAD" ? "Azure AD" : "Generic OIDC") Settings</h3>

                <div class="icb-settings-grid">
                    @if (form.Type == "AzureAD")
                    {
                        <div class="icb-form-field icb-settings-grid-full">
                            <label class="icb-form-label" for="idpTenant">Azure Tenant ID *</label>
                            <input id="idpTenant" type="text" class="icb-form-input" @bind="form.TenantId" placeholder="specific tenant GUID (required)" />
                            <span class="icb-form-help">Authority becomes https://login.microsoftonline.com/{tenant}/v2.0. Multi-tenant authorities (common, organizations, consumers) are not allowed — they would accept tokens from any Azure tenant.</span>
                        </div>
                    }
                    else
                    {
                        <div class="icb-form-field icb-settings-grid-full">
                            <label class="icb-form-label" for="idpAuthority">Authority (issuer URL) *</label>
                            <input id="idpAuthority" type="text" class="icb-form-input" @bind="form.Authority" placeholder="https://idp.example.com/" />
                        </div>
                    }
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="idpClientId">Client ID *</label>
                        <input id="idpClientId" type="text" class="icb-form-input" @bind="form.ClientId" />
                    </div>
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="idpSecret">Client Secret @(editingId != null ? "(leave blank to keep current)" : "*")</label>
                        <div class="icb-form-input-group">
                            <input id="idpSecret" type="@(showSecret ? "text" : "password")" class="icb-form-input" @bind="form.ClientSecret" autocomplete="new-password"
                                   placeholder="@(editingId != null ? "•••••••• (unchanged)" : "")" />
                            <button class="ic-btn ic-btn-ghost" type="button" @onclick="ToggleSecret" aria-label="@(showSecret ? "Hide secret" : "Show secret")">
                                <i class="oi @(showSecret ? "oi-lock-locked" : "oi-eye")" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span class="icb-form-help">Encrypted at rest. Never displayed after saving.</span>
                    </div>
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="idpClaim">Username/email claim (optional)</label>
                        <input id="idpClaim" type="text" class="icb-form-input" @bind="form.UsernameClaim"
                               placeholder="preferred_username (default prefers preferred_username, then upn; email only if verified)" />
                        <span class="icb-form-help">Which claim is matched against an existing admin's username.</span>
                    </div>
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="idpCallback">Redirect / callback path</label>
                        <input id="idpCallback" type="text" class="icb-form-input" @bind="form.CallbackPath" placeholder="/signin-oidc" />
                        <span class="icb-form-help">The path your IdP redirects back to after login. Register this EXACT path as the redirect URI in your IdP app registration (e.g. https://&lt;host&gt;/signin-oidc). If you run more than one enabled provider, give each a unique path.</span>
                    </div>
                    <div class="icb-form-field">
                        <label class="icb-form-label" for="idpScopes">Extra scopes (space-separated, optional)</label>
                        <input id="idpScopes" type="text" class="icb-form-input" @bind="form.ScopesRaw" placeholder="openid profile email are always requested" />
                    </div>
                    <div class="icb-form-field icb-settings-grid-full">
                        <div class="icb-form-check mb-2">
                            <input class="icb-form-switch" type="checkbox" role="switch" id="idpEnabled" @bind="form.IsEnabled" />
                            <label class="icb-form-check-label" for="idpEnabled">Enabled</label>
                        </div>
                        <div class="icb-form-check">
                            <input type="checkbox" id="idpAutoProvision" @bind="form.AutoProvision" />
                            <label class="icb-form-check-label" for="idpAutoProvision">
                                Auto-create an admin on first SSO sign-in
                                <span class="icb-form-help">When on, anyone who successfully signs in through this provider (and isn't already an admin) gets a new active admin account. Use only with a trusted, tenant-pinned provider — every Conduit admin has full access.</span>
                            </label>
                        </div>
                    </div>
                </div>
            </form>
        </ChildContent>
    </BrandEditorDialog>
}

@code {
    private List<IdentityProvider> providers = new();
    private bool loading = true;
    private bool showModal;
    private bool saving;
    private Guid? editingId;
    private string? formError;

    // Page-level feedback for list actions (toggle / delete) that happen OUTSIDE
    // the edit form — formError only renders inside the modal, so without this an
    // operator's toggle/delete failure was invisible (logged to Console only).
    private string? actionMessage;
    private bool actionOk;
    private ProviderForm form = new();

    private bool testInFlight;
    private bool testOk;
    private string testResult = "";
    private bool showSecret;
    private BrandConfirmationModal? confirmModal;

    private void ToggleSecret() => showSecret = !showSecret;

    private string AuthorityFor(IdentityProvider p)
    {
        try
        {
            var cfg = JsonSerializer.Deserialize<IdentityProviderConfig>(p.Configuration) ?? new();
            if (string.Equals(p.Type, "AzureAD", StringComparison.OrdinalIgnoreCase))
            {
                var t = string.IsNullOrWhiteSpace(cfg.TenantId) ? "common" : cfg.TenantId;
                return $"https://login.microsoftonline.com/{t}/v2.0";
            }
            return cfg.Authority ?? "(none)";
        }
        catch { return "(unparseable)"; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Load();
            StateHasChanged();
        }
    }

    private async Task Load()
    {
        loading = true;
        try { providers = await ProviderRepo.GetAllAsync(); }
        catch (Exception ex) { Console.WriteLine($"IdentityProviders load failed: {ex.Message}"); providers = new(); }
        finally { loading = false; }
    }

    private void OpenCreate()
    {
        editingId = null;
        form = new ProviderForm { Type = "OIDC", IsEnabled = true };
        formError = null; testResult = ""; testOk = false; showSecret = false;
        showModal = true;
    }

    private void OpenEdit(IdentityProvider p)
    {
        editingId = p.Id;
        var cfg = JsonSerializer.Deserialize<IdentityProviderConfig>(p.Configuration) ?? new();
        form = new ProviderForm
        {
            Name = p.Name,
            Type = p.Type,
            IsEnabled = p.IsEnabled,
            ClientId = cfg.ClientId,
            ClientSecret = "", // never round-trip the secret to the browser
            Authority = cfg.Authority,
            TenantId = cfg.TenantId,
            UsernameClaim = cfg.UsernameClaim,
            CallbackPath = string.IsNullOrWhiteSpace(cfg.CallbackPath) ? "/signin-oidc" : cfg.CallbackPath,
            ScopesRaw = string.Join(' ', cfg.Scopes),
            AutoProvision = cfg.AutoProvision
        };
        formError = null; testResult = ""; testOk = false; showSecret = false;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task<string> CurrentUser()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        return state.User.Identity?.Name ?? "admin";
    }

    private async Task Save()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(form.Name)) { formError = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(form.ClientId)) { formError = "Client ID is required."; return; }
        if (form.Type == "AzureAD")
        {
            var tenant = form.TenantId?.Trim();
            if (string.IsNullOrWhiteSpace(tenant)) { formError = "Azure Tenant ID is required."; return; }
            if (string.Equals(tenant, "common", StringComparison.OrdinalIgnoreCase)
                || string.Equals(tenant, "organizations", StringComparison.OrdinalIgnoreCase)
                || string.Equals(tenant, "consumers", StringComparison.OrdinalIgnoreCase))
            {
                formError = "Azure Tenant ID must be a specific tenant GUID. Multi-tenant authorities (common, organizations, consumers) are not allowed.";
                return;
            }
        }
        if (form.Type != "AzureAD" && string.IsNullOrWhiteSpace(form.Authority)) { formError = "Authority is required."; return; }
        var callbackPath = string.IsNullOrWhiteSpace(form.CallbackPath) ? "/signin-oidc" : form.CallbackPath.Trim();
        if (!callbackPath.StartsWith("/")) { formError = "Redirect / callback path must start with '/' — it is an app-local path, not a full URL."; return; }
        if (editingId == null && string.IsNullOrWhiteSpace(form.ClientSecret)) { formError = "Client Secret is required."; return; }

        saving = true;
        try
        {
            var who = await CurrentUser();

            // Determine the secret to store: a freshly typed value is encrypted now;
            // a blank field on edit means "keep the existing encrypted secret".
            string encryptedSecret;
            if (!string.IsNullOrWhiteSpace(form.ClientSecret))
            {
                encryptedSecret = SecretProtector.Protect(form.ClientSecret);
            }
            else if (editingId != null)
            {
                var existing = await ProviderRepo.GetByIdAsync(editingId.Value);
                var existingCfg = existing != null
                    ? JsonSerializer.Deserialize<IdentityProviderConfig>(existing.Configuration) ?? new()
                    : new();
                encryptedSecret = existingCfg.ClientSecret; // already-encrypted ciphertext
            }
            else
            {
                encryptedSecret = "";
            }

            var cfg = new IdentityProviderConfig
            {
                ClientId = form.ClientId.Trim(),
                ClientSecret = encryptedSecret,
                Authority = string.IsNullOrWhiteSpace(form.Authority) ? null : form.Authority.Trim(),
                TenantId = string.IsNullOrWhiteSpace(form.TenantId) ? null : form.TenantId.Trim(),
                UsernameClaim = string.IsNullOrWhiteSpace(form.UsernameClaim) ? null : form.UsernameClaim.Trim(),
                CallbackPath = callbackPath,
                Scopes = (form.ScopesRaw ?? "")
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList(),
                AutoProvision = form.AutoProvision
            };
            var configJson = JsonSerializer.Serialize(cfg);

            if (editingId == null)
            {
                await ProviderRepo.CreateAsync(new IdentityProvider
                {
                    Name = form.Name.Trim(),
                    Type = form.Type,
                    IsEnabled = form.IsEnabled,
                    Configuration = configJson,
                    CreatedBy = who,
                    ModifiedBy = who
                });
            }
            else
            {
                var row = await ProviderRepo.GetByIdAsync(editingId.Value);
                if (row != null)
                {
                    row.Name = form.Name.Trim();
                    row.Type = form.Type;
                    row.IsEnabled = form.IsEnabled;
                    row.Configuration = configJson;
                    row.ModifiedBy = who;
                    await ProviderRepo.UpdateAsync(row);
                }
            }
            showModal = false;
            await Load();
        }
        catch (Exception ex)
        {
            formError = $"Save failed: {ex.Message}";
        }
        finally { saving = false; }
    }

    private async Task ToggleEnabled(IdentityProvider p)
    {
        actionMessage = null;
        try
        {
            await ProviderRepo.SetEnabledAsync(p.Id, !p.IsEnabled, await CurrentUser());
            await Load();
            actionOk = true;
            actionMessage = $"'{p.Name}' {(p.IsEnabled ? "disabled" : "enabled")}. Changes take effect after an app restart.";
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = $"Could not change '{p.Name}': {ex.Message}";
        }
    }

    private async Task DeleteProvider(IdentityProvider p)
    {
        if (confirmModal == null || !await confirmModal.ShowAsync("Delete identity provider", $"Delete identity provider '{p.Name}'?")) return;
        actionMessage = null;
        try
        {
            await ProviderRepo.DeleteAsync(p.Id);
            await Load();
            actionOk = true;
            actionMessage = $"Deleted '{p.Name}'.";
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = $"Could not delete '{p.Name}': {ex.Message}";
        }
    }

    private async Task TestConnection()
    {
        testInFlight = true; testResult = ""; testOk = false;
        StateHasChanged();
        try
        {
            string authority;
            if (form.Type == "AzureAD")
            {
                var t = string.IsNullOrWhiteSpace(form.TenantId) ? "common" : form.TenantId!.Trim();
                authority = $"https://login.microsoftonline.com/{t}/v2.0";
            }
            else
            {
                authority = (form.Authority ?? "").Trim();
            }
            if (string.IsNullOrWhiteSpace(authority)) { testResult = "Set the authority first."; return; }

            var url = authority.TrimEnd('/') + "/.well-known/openid-configuration";
            using var client = HttpClientFactory.CreateClient();
            client.Timeout = TimeSpan.FromSeconds(10);
            var resp = await client.GetAsync(url);
            testOk = resp.IsSuccessStatusCode;
            testResult = testOk
                ? $"✓ {(int)resp.StatusCode} — discovery document reachable at {url}"
                : $"✗ {(int)resp.StatusCode} {resp.ReasonPhrase} — could not read {url}";
        }
        catch (Exception ex)
        {
            testOk = false;
            testResult = $"✗ {ex.Message}";
        }
        finally { testInFlight = false; }
    }

    private class ProviderForm
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "OIDC";
        public bool IsEnabled { get; set; }
        public string ClientId { get; set; } = "";
        public string ClientSecret { get; set; } = "";
        public string? Authority { get; set; }
        public string? TenantId { get; set; }
        public string? UsernameClaim { get; set; }
        public string? CallbackPath { get; set; } = "/signin-oidc";
        public string? ScopesRaw { get; set; }
        public bool AutoProvision { get; set; }
    }
}
