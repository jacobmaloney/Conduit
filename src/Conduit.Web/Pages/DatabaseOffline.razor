@page "/db-offline"
@using Conduit.Web.Services
@inject SetupService SetupService
@inject NavigationManager Navigation
@layout SetupLayout
@implements IAsyncDisposable

@*
    Database Offline page.

    Shown by SetupMiddleware when the configured database is UNREACHABLE (host down /
    connection cannot be opened) — as opposed to "reachable but not yet set up", which
    routes to /setup. This page must NEVER be the setup wizard: a transient network blip
    must not expose first-run setup.

    Anonymous by design (you can't authenticate without a database anyway) and uses the
    same SetupLayout chrome as the wizard.

    Automatic recovery is driven by a COMPONENT-SCOPED timer, never a meta-refresh tag.
    HeadContent projects into the live document.head, which arms a document-level refresh
    that survives client-side navigation away from this page — the operator would click
    "Reconnect to a different database", start typing in the wizard, and get hard-navigated
    out from under mid-keystroke. Removing the meta element does NOT cancel the
    already-scheduled navigation; a timer, by contrast, disposes with the component.
    Do not reintroduce the meta refresh — DatabaseOfflineMetaRefreshTests guards it.
*@

<div class="offline-shell">
    <div class="offline-card">
        <div class="offline-mark">
            <ConduitMark Size="64" Color="var(--accent)" HubFill="var(--bg-2)" />
        </div>

        <div class="offline-badge">
            <span class="offline-dot"></span>
            Database offline
        </div>

        <h1 class="offline-title">Waiting for the database</h1>

        <p class="offline-lead">
            Conduit can't reach its database@(string.IsNullOrEmpty(_server) ? "" : _serverPhrase) right now.
            This usually means the database server is temporarily down or unreachable on the network.
        </p>

        <p class="offline-sub">
            Nothing is lost. Conduit is retrying automatically and will recover on its own as soon
            as the database is back online &mdash; you don't need to do anything.
        </p>

        <div class="offline-retry">
            <span class="offline-spinner"></span>
            <span>Retrying&hellip; we'll take you through automatically as soon as it's back.</span>
        </div>

        <a class="offline-manual" href="/db-offline" @onclick="CheckNowAsync" @onclick:preventDefault>
            @(_checking ? "Checking…" : "Check again now")
        </a>

        @if (_lastCheckFailed)
        {
            <p class="offline-still">Still unreachable.</p>
        }

        <div class="offline-divider"><span>or</span></div>

        <p class="offline-moved">
            Moved to a new database server, or the old one is gone for good?
        </p>
        <a class="offline-reconnect" href="/setup" @onclick="Reconnect" @onclick:preventDefault>
            Reconnect to a different database
        </a>
    </div>
</div>

<style>
    .offline-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
        background: var(--bg, #0A1322);
    }

    .offline-card {
        width: 100%;
        max-width: 480px;
        background: var(--bg-2, #0E1A2D);
        border: 1px solid rgba(157, 176, 204, 0.14);
        border-radius: 16px;
        padding: 40px 36px;
        text-align: center;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
    }

    .offline-mark { margin-bottom: 20px; }

    .offline-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 12px;
        border-radius: 999px;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.35);
        color: var(--warn, #F59E0B);
        font-size: 12.5px;
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .offline-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--warn, #F59E0B);
        box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5);
        animation: offline-pulse 1.6s infinite;
    }

    @@keyframes offline-pulse {
        0%   { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.5); }
        70%  { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); }
        100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }

    .offline-title {
        color: var(--text, #E4EDFB);
        font-size: 22px;
        font-weight: 700;
        margin: 0 0 14px;
    }

    .offline-lead {
        color: var(--text-2, #9DB0CC);
        font-size: 15px;
        line-height: 1.6;
        margin: 0 0 12px;
    }

    .offline-sub {
        color: var(--text-3, #6B809E);
        font-size: 13.5px;
        line-height: 1.6;
        margin: 0 0 24px;
    }

    .offline-retry {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--text-2, #9DB0CC);
        font-size: 13px;
        margin-bottom: 18px;
    }

    .offline-spinner {
        width: 15px;
        height: 15px;
        border-radius: 50%;
        border: 2px solid rgba(34, 211, 238, 0.25);
        border-top-color: var(--accent, #22D3EE);
        animation: offline-spin 0.8s linear infinite;
    }

    @@keyframes offline-spin {
        to { transform: rotate(360deg); }
    }

    .offline-manual {
        display: inline-block;
        color: var(--accent, #22D3EE);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .offline-still {
        color: var(--text-3, #6B809E);
        font-size: 12.5px;
        margin: 10px 0 0;
    }

    .offline-divider {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 26px 0 18px;
        color: var(--text-3, #6B809E);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .offline-divider::before,
    .offline-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: rgba(157, 176, 204, 0.14);
    }

    .offline-moved {
        color: var(--text-2, #9DB0CC);
        font-size: 13.5px;
        line-height: 1.5;
        margin: 0 0 14px;
    }

    .offline-reconnect {
        display: inline-block;
        padding: 10px 20px;
        border-radius: 10px;
        background: var(--accent, #22D3EE);
        color: #06121F;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        transition: filter 0.15s ease;
    }

    .offline-reconnect:hover {
        filter: brightness(1.08);
    }
</style>

@code {
    // 15s, not 10: SetupService's status probe allows a 15s connect timeout, so a
    // shorter interval would stack overlapping probes against a dead host.
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(15);

    private string _server = string.Empty;
    private string _serverPhrase = string.Empty;
    private bool _offline;
    private bool _checking;
    private bool _lastCheckFailed;
    private int _probing;
    private System.Threading.Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        // Self-evict when the database is healthy. This route is anonymous by design, so on
        // a live install it would otherwise render to any caller and disclose the configured
        // SQL host via GetConfiguredServerName(). Mirrors the guard in Setup.razor.
        if (await SetupService.GetDatabaseStatusAsync() != DatabaseStatus.Unreachable)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        _offline = true;
        _server = SetupService.GetConfiguredServerName();
        if (!string.IsNullOrEmpty(_server))
        {
            _serverPhrase = " at " + _server;
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _offline)
        {
            _timer = new System.Threading.Timer(_ => _ = ProbeAsync(), null, PollInterval, PollInterval);
        }
        return Task.CompletedTask;
    }

    // forceLoad: destroy this document rather than client-side navigating, so nothing
    // armed on it can outlive the page and yank the wizard out from under the operator.
    private void Reconnect() => Navigation.NavigateTo("/setup", forceLoad: true);

    private async Task CheckNowAsync()
    {
        _checking = true;
        await ProbeAsync();
        _checking = false;
    }

    private async Task ProbeAsync()
    {
        // Per-circuit early-out so a click and a timer tick can't overlap. The authoritative
        // one-probe-at-a-time gate is static, inside SetupService.
        if (System.Threading.Interlocked.Exchange(ref _probing, 1) == 1)
        {
            return;
        }

        try
        {
            var status = await SetupService.GetDatabaseStatusAsync();
            if (status != DatabaseStatus.Unreachable)
            {
                // forceLoad so SetupMiddleware re-evaluates and routes onward.
                await InvokeAsync(() => Navigation.NavigateTo("/", forceLoad: true));
                return;
            }

            _lastCheckFailed = true;
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // A throwing probe must never tear down the circuit — keep polling.
        }
        finally
        {
            System.Threading.Interlocked.Exchange(ref _probing, 0);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_timer is not null)
        {
            await _timer.DisposeAsync();
            _timer = null;
        }
    }
}
