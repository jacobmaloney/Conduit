@inherits LayoutComponentBase

<PageTitle>Conduit</PageTitle>

<div class="ic-shell">
    <nav class="ic-topbar">
        @* Brand lockup (IC .ic-logo idiom). Base-relative href so it stays inside
           any tenant base path. Retires the old cyan ConduitMark from the shell. *@
        <a href="" class="ic-logo">
            <i class="fas fa-shield-alt"></i>
            <span class="ic-logo-text">Con<span>duit</span></span>
        </a>

        <div class="ic-topbar-right ms-auto">
            <a href="/api-explorer" class="top-bar-link mono">
                <i class="fas fa-code"></i> API Docs
            </a>
            <a href="/health" target="_blank" class="top-bar-link mono health">
                Health
            </a>
        </div>
    </nav>

    <div class="ic-body">
        <NavMenu />

        <div class="ic-content">
            <main>
                @Body
            </main>
        </div>
    </div>
</div>
