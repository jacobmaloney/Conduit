@page "/schedule-manager"
@page "/schedules"
@attribute [Authorize]
@using IdentityCenter.Brand.Components.Modals
@using Conduit.Core.SyncModels
@using Conduit.DataAccess.Repositories
@using Conduit.Sync.Orchestration
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@using NCrontab
@using IdentityCenter.Brand.Components.Layout
@using IdentityCenter.Brand.Models
@inject SyncProjectRepository ProjectRepo
@inject SyncCancellationRegistry CancellationRegistry
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<ScheduleManager> Logger
@inject NavigationManager Navigation

@*
    Schedule Manager — one place to see and manage EVERY sync project's schedule.

    Conduit stores schedules as a per-project CronSchedule string column on
    SyncProjects (no separate Schedules table); the ScheduledSyncRunnerJob fires
    enabled projects whose cron is due. This page is therefore an AGGREGATE
    VIEW/EDITOR over all projects' CronSchedule + IsEnabled — it introduces NO new
    storage and NO parallel scheduler. It mirrors IC's Schedule Manager surface:
    list project / schedule (human-readable) / next run / last run+status /
    enabled, with inline enable-disable and an edit-schedule modal.

    The edit modal reuses the SHARED CcScheduleEditor (same presets + same
    ScheduledSyncRunnerJob.TryValidate validator the inline Sync Projects modal and
    the create/edit wizard use) so the schedule-edit logic is not forked.
*@

<PageTitle>Schedules - Conduit</PageTitle>

<div class="container-fluid">
    @* CcTemplate1 is the thin adapter over the shared BrandPageHeader, so Schedules gets the same
       header as every other migrated page instead of a local cx-* copy that drifts. *@
    <CcTemplate1 Title="Schedules"
                 Subtitle="@($"Recurring runs across all sync projects. Next run {NextScheduledRunText} · {FailingCount} failing.")"
                 Icon="fas fa-clock"
                 IconAccent="amber">
        <PrimaryAction>
            <button type="button" class="ic-btn ic-btn-primary" @onclick="OpenAssign" disabled="@(loading || projects.Count == 0)">
                <i class="fas fa-plus"></i> Assign Schedule
            </button>
        </PrimaryAction>
    </CcTemplate1>

    <BrandListTable TItem="SyncProject" Title="Schedules" Items="@Filtered" TotalCount="@Filtered.Count"
                    PageSize="@Math.Max(1, Filtered.Count)" State="@(loading ? BrandListState.Loading : loadError != null ? BrandListState.Failed : BrandListState.Ready)"
                    StateReason="@loadError" OnRetry="Reload" EmptyMessage="No sync projects to schedule yet.">
        <HeaderTemplate>
            <th scope="col">Name</th><th scope="col">Cadence</th><th scope="col">Next run</th>
            <th scope="col">Last run</th><th scope="col">State</th><th scope="col">Actions</th>
        </HeaderTemplate>
        <RowTemplate Context="p">
            <td class="nm-cell">
                <div class="fw-semibold">@p.Name</div>
                @if (!string.IsNullOrWhiteSpace(p.Description))
                {
                    <div class="icb-table-note">@p.Description</div>
                }
            </td>
            <td>
                @if (string.IsNullOrWhiteSpace(p.CronSchedule))
                {
                    <span class="text-muted">Manual only</span>
                }
                else
                {
                    @Humanize(p.CronSchedule)
                }
            </td>
            <td class="fw-semibold">@NextRunText(p)</td>
            <td>@LastRunText(p)</td>
            <td>
                @if (!p.IsEnabled)
                {
                    <BrandBadge Text="Disabled" Tone="BrandBadgeTone.Neutral" Soft="true" />
                }
                else if (p.IsRunning || CancellationRegistry.IsRunningHere(p.Id))
                {
                    <BrandBadge Text="Running" Tone="BrandBadgeTone.Info" Icon="fas fa-spinner fa-spin" Soft="true" />
                }
                else
                {
                    <BrandBadge Text="@LastStatusLabel(p.LastRunStatus)" Tone="@StatusTone(p.LastRunStatus)" Soft="true" />
                }
            </td>
            <td>
                <div class="icb-table-actions">
                    @if (p.IsEnabled && !p.IsRunning && !CancellationRegistry.IsRunningHere(p.Id))
                    {
                        <button type="button" class="icb-list-action" @onclick="() => RunNow(p)" disabled="@(busyId is not null)">
                            @if (runningRowId == p.Id)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="fas fa-play"></i>
                            }
                            Run
                        </button>
                    }
                    else if (p.IsRunning || CancellationRegistry.IsRunningHere(p.Id))
                    {
                        <button type="button" class="icb-list-action" disabled>
                            <i class="fas fa-spinner fa-spin"></i> Running…
                        </button>
                    }
                    <button type="button" class="icb-list-action" @onclick="() => OpenEdit(p)" disabled="@(busyId == p.Id)">
                        <i class="fas fa-clock"></i> Edit
                    </button>
                    @if (p.IsEnabled)
                    {
                        <button type="button" class="icb-list-action" @onclick="() => ToggleEnabled(p)" disabled="@(busyId == p.Id)">
                            <i class="fas fa-pause"></i> Disable
                        </button>
                    }
                    else
                    {
                        <button type="button" class="icb-list-action" @onclick="() => ToggleEnabled(p)" disabled="@(busyId == p.Id)">
                            <i class="fas fa-play"></i> Enable
                        </button>
                    }
                </div>
            </td>
        </RowTemplate>
    </BrandListTable>
</div>

@if (assignOpen)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-calendar-plus me-2"></i>Assign schedule</h5>
                    <button type="button" class="btn-close" @onclick="CloseAssign" disabled="@assignSaving"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">Choose the sync project that runs on this cadence. Each execution is recorded in Sync History against that project.</p>
                    <div class="mb-3">
                        <label class="icb-form-label" for="assignProjectSelect">Sync project</label>
                        <select id="assignProjectSelect" class="icb-form-select" @bind="assignProjectId">
                            <option value="">Select a sync project</option>
                            @foreach (var project in projects.OrderBy(p => p.Name))
                            {
                                <option value="@project.Id">@project.Name@(HasSchedule(project) ? " (scheduled)" : "")</option>
                            }
                        </select>
                    </div>
                    <CcScheduleEditor @bind-Value="assignCron" Error="@assignError" />
                    <div class="icb-form-check mt-3">
                        <input type="checkbox" id="enableAssignedProject" @bind="assignEnable" />
                        <label class="icb-form-check-label" for="enableAssignedProject">Enable this sync project</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="ic-btn ic-btn-ghost" @onclick="CloseAssign" disabled="@assignSaving">Cancel</button>
                    <button type="button" class="ic-btn ic-btn-primary" @onclick="SaveAssignment" disabled="@assignSaving">
                        @if (assignSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Assign schedule
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (!string.IsNullOrEmpty(toast))
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div class="toast show align-items-center @toastClass border-0">
            <div class="d-flex">
                <div class="toast-body">
                    @toast
                    @if (lastRunId is not null)
                    {
                        <a class="text-white text-decoration-underline ms-2" href="/sync-history/@lastRunId">View run</a>
                    }
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="DismissToast"></button>
            </div>
        </div>
    </div>
}

@* The shared component, like every other Conduit page. Intent replaces the raw CSS string:
   CcConfirmationModal hard-coded a Bootstrap "btn " prefix onto whatever class it was given,
   so passing shared classes through it produced mixed markup. *@
<BrandConfirmationModal @ref="runConfirm" ConfirmLabel="Run Now"
                        Intent="BrandConfirmationModal.ConfirmIntent.Success" />

@* ───────── Edit Schedule Modal (reuses shared CcScheduleEditor) ───────── *@
@if (editProject is not null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="fas fa-clock me-2"></i>Schedule: @editProject.Name
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit" disabled="@editSaving"></button>
                </div>
                <div class="modal-body">
                    <CcScheduleEditor @bind-Value="editCron" Error="@editError" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="ic-btn ic-btn-ghost" @onclick="CloseEdit" disabled="@editSaving">Cancel</button>
                    <button type="button" class="ic-btn ic-btn-primary" @onclick="SaveSchedule" disabled="@editSaving">
                        @if (editSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save Schedule
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<SyncProject> projects = new();
    private bool loading = true;
    private string? loadError;
    private string? toast;
    private Guid? busyId;

    private string activeTab = "all";

    // Assign-modal state. Schedules are intentionally stored on sync projects;
    // runs remain immutable executions linked to the project that created them.
    private bool assignOpen;
    private string assignProjectId = string.Empty;
    private string? assignCron;
    private string? assignError;
    private bool assignEnable = true;
    private bool assignSaving;

    private static readonly IReadOnlyList<CcFilterTabs.Tab> _tabs = new List<CcFilterTabs.Tab>
    {
        new("all", "All", null, "fas fa-list"),
        new("scheduled", "Scheduled", null, "fas fa-clock"),
        new("manual", "Manual", null, "fas fa-hand-pointer"),
        new("disabled", "Disabled", null, "fas fa-ban"),
    };

    // Edit-modal state.
    private SyncProject? editProject;
    private string? editCron;
    private string? editError;
    private bool editSaving;

    // Run-now state. runningRowId marks the row whose run is being STARTED (the
    // brief window between Confirm and the navigate-away). toastClass + lastRunId
    // are retained for the enable/disable/save toasts on this page.
    private BrandConfirmationModal? runConfirm;
    private Guid? runningRowId;
    private string toastClass = "text-bg-success";
    private Guid? lastRunId;

    protected override async Task OnInitializedAsync() => await Reload();

    private void DismissToast()
    {
        toast = null;
        lastRunId = null;
    }

    // ─── Run Now (manual, ignores schedule) ───────────────────────────────────
    // Identical fire-and-forget pattern to SyncProjects.RunNowConfirmed: this page
    // used to AWAIT SyncProjectOrchestrator.ExecuteAsync inline, so the Run-Now
    // button spun for the whole (minutes-long) pass with no progress. Now we
    // pre-claim the single-run flag (atomic IsRunning 0→1 CAS), start the run in a
    // BACKGROUND task that owns its OWN DI scope (the circuit's scoped orchestrator
    // / DB connections would be disposed out from under it), and navigate the
    // operator to the project's live Sync History so they watch progress.
    //
    // Double-trigger is guarded three ways: the disabled Run-Now button while
    // busyId is set, the persisted IsRunning CAS below (a lost CAS = another run
    // started, so we do NOT fire a second), and the in-process IsRunningHere check.
    private async Task RunNow(SyncProject row)
    {
        if (runConfirm is null) return;
        if (!row.IsEnabled) return;
        if (row.IsRunning || CancellationRegistry.IsRunningHere(row.Id)) return;

        var ok = await runConfirm.ShowAsync(
            $"Run '{row.Name}' now?",
            "This starts a manual sync run immediately, regardless of the schedule.",
            "It reads from the source, applies the project's mappings, and writes to the sink.");
        if (!ok) return;

        var projectId = row.Id;
        var projectName = row.Name;

        runningRowId = projectId;
        busyId = projectId;
        lastRunId = null;

        // Claim a unique run owner before dispatch; a concurrent winner is refused.
        var ownerRunId = Guid.NewGuid();
        SyncAdmissionOutcome admission;
        try
        {
            admission = await ProjectRepo.TryAdmitRunAsync(projectId, ownerRunId, requireActiveConnections: true);
        }
        catch (Exception ex)
        {
            runningRowId = null;
            busyId = null;
            toastClass = "text-bg-danger";
            toast = $"Could not start '{projectName}': {ex.Message}";
            await Reload();
            return;
        }
        if (admission != SyncAdmissionOutcome.Admitted)
        {
            runningRowId = null;
            busyId = null;
            // A deactivated Connected System is a configuration problem the operator must fix, not
            // the transient "come back later" that a warning implies.
            toastClass = admission == SyncAdmissionOutcome.RefusedAlreadyRunning
                ? "text-bg-warning"
                : "text-bg-danger";
            toast = SyncAdmissionRefusal.Describe(admission, projectName);
            await Reload();
            return;
        }

        // The CAS persisted IsRunning=1 authoritatively; the run row + per-step
        // counts appear in Sync History the instant the orchestrator stamps them.
        _ = Task.Run(async () =>
        {
            try
            {
                using var scope = ScopeFactory.CreateScope();
                var orchestrator = scope.ServiceProvider.GetRequiredService<SyncProjectOrchestrator>();
                // preClaimed: this page won the CAS above; the orchestrator owns the
                // release from here on every exit path.
                await orchestrator.ExecuteAsync(projectId, "Manual", CancellationToken.None, claimedRunId: ownerRunId);
            }
            catch (Exception ex)
            {
                // The orchestrator stamps the SyncRun Failed and releases IsRunning
                // on every exit path; this is best-effort logging only. The page has
                // navigated away — do NOT touch circuit-scoped UI state here.
                Logger.LogError(ex, "Background Run-Now failed for project {ProjectId} ({ProjectName})", projectId, projectName);

                // Defense in depth for the pre-claim: free the project if the
                // orchestrator threw before its own release could run.
                try
                {
                    using var cleanupScope = ScopeFactory.CreateScope();
                    await cleanupScope.ServiceProvider.GetRequiredService<SyncProjectRepository>()
                        .ClearRunningAsync(projectId, ownerRunId);
                }
                catch (Exception clearEx)
                {
                    Logger.LogError(clearEx, "Failed to release IsRunning for project {ProjectId} after a failed Run-Now", projectId);
                }
            }
        });

        // Take the operator to the project's live run history — the Running run row
        // (and its per-step counts) updates there, same destination Sync Projects uses.
        Navigation.NavigateTo($"/sync-history?project={projectId}");
    }

    private async Task Reload()
    {
        loading = true;
        loadError = null;
        try
        {
            projects = await ProjectRepo.GetAllAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Failed to load schedules: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private bool HasSchedule(SyncProject p) => !string.IsNullOrWhiteSpace(p.CronSchedule);

    private List<SyncProject> Filtered => activeTab switch
    {
        "scheduled" => projects.Where(p => p.IsEnabled && HasSchedule(p)).ToList(),
        "manual"    => projects.Where(p => p.IsEnabled && !HasSchedule(p)).ToList(),
        "disabled"  => projects.Where(p => !p.IsEnabled).ToList(),
        _           => projects,
    };

    private IReadOnlyList<CcStatRow.StatItem> StatItems => new List<CcStatRow.StatItem>
    {
        new("Projects", projects.Count.ToString("N0")),
        new("Scheduled", projects.Count(p => p.IsEnabled && HasSchedule(p)).ToString("N0"), "text-info"),
        new("Manual only", projects.Count(p => p.IsEnabled && !HasSchedule(p)).ToString("N0")),
        new("Disabled", projects.Count(p => !p.IsEnabled).ToString("N0"), "text-warning"),
    };

    private void HandleTabChanged(string key) => activeTab = key;

    private void OpenAssign()
    {
        assignOpen = true;
        assignProjectId = string.Empty;
        assignCron = string.Empty;
        assignError = null;
        assignEnable = true;
    }

    private void CloseAssign()
    {
        if (assignSaving) return;
        assignOpen = false;
        assignError = null;
    }

    private async Task SaveAssignment()
    {
        if (!Guid.TryParse(assignProjectId, out var projectId))
        {
            assignError = "Select a sync project.";
            return;
        }
        if (!ScheduledSyncRunnerJob.TryValidate(assignCron, out var validationError))
        {
            assignError = validationError ?? "Invalid schedule.";
            return;
        }
        if (string.IsNullOrWhiteSpace(assignCron))
        {
            assignError = "Choose a cadence. Use Edit on an existing row to make a project manual-only.";
            return;
        }

        assignSaving = true;
        assignError = null;
        try
        {
            var project = await ProjectRepo.GetByIdAsync(projectId);
            if (project is null)
            {
                assignError = "Project no longer exists.";
                return;
            }
            project.CronSchedule = assignCron.Trim();
            project.IsEnabled = assignEnable;
            await ProjectRepo.UpdateAsync(project);
            assignOpen = false;
            toastClass = "text-bg-success";
            toast = $"Schedule assigned to '{project.Name}'.";
            await Reload();
        }
        catch (Exception ex)
        {
            assignError = $"Save failed: {ex.Message}";
        }
        finally
        {
            assignSaving = false;
        }
    }

    // ─── Inline enable / disable ──────────────────────────────────────────────
    // Loads the FULL project row before mutating so UpdateAsync (which writes
    // every column) doesn't null out credential names / SkipUnchanged. Only
    // IsEnabled is changed.
    private async Task ToggleEnabled(SyncProject row)
    {
        busyId = row.Id;
        toastClass = "text-bg-success";
        lastRunId = null;
        try
        {
            var full = await ProjectRepo.GetByIdAsync(row.Id);
            if (full is null)
            {
                toast = "Project no longer exists.";
                await Reload();
                return;
            }
            full.IsEnabled = !full.IsEnabled;
            await ProjectRepo.UpdateAsync(full);
            var verb = full.IsEnabled ? "enabled" : "disabled";
            toast = $"'{full.Name}' {verb}.";
            await Reload();
        }
        catch (Exception ex)
        {
            toast = $"Update failed: {ex.Message}";
        }
        finally
        {
            busyId = null;
        }
    }

    // ─── Edit schedule modal ──────────────────────────────────────────────────
    private void OpenEdit(SyncProject p)
    {
        editProject = p;
        editCron = p.CronSchedule ?? string.Empty;
        editError = null;
    }

    private void CloseEdit()
    {
        if (editSaving) return;
        editProject = null;
        editError = null;
    }

    private async Task SaveSchedule()
    {
        if (editProject is null) return;
        if (!ScheduledSyncRunnerJob.TryValidate(editCron, out var err))
        {
            editError = err ?? "Invalid schedule.";
            return;
        }
        editSaving = true;
        editError = null;
        toastClass = "text-bg-success";
        lastRunId = null;
        try
        {
            var full = await ProjectRepo.GetByIdAsync(editProject.Id);
            if (full is null)
            {
                editError = "Project no longer exists.";
                return;
            }
            full.CronSchedule = string.IsNullOrWhiteSpace(editCron) ? null : editCron.Trim();
            await ProjectRepo.UpdateAsync(full);
            var savedName = full.Name;
            editProject = null;
            toast = $"Schedule saved for '{savedName}'.";
            await Reload();
        }
        catch (Exception ex)
        {
            editError = $"Save failed: {ex.Message}";
        }
        finally
        {
            editSaving = false;
        }
    }

    // ─── Display helpers ──────────────────────────────────────────────────────

    // Status vocabulary matches the orchestrator's emitted statuses and the way
    // Processing Center / Sync History (slices 5-6) render them: PartialSuccess and
    // Cancelled are both real rolled-up statuses shown amber. Kept in lock-step so
    // the same run never shows green here and amber there.
    private static string LastStatusClass(string? status) => status switch
    {
        "Succeeded"      => "active",
        "Failed"         => "tone-danger",
        "Running"        => "active",
        "PartialSuccess" => "review",
        "Cancelled"      => "review",
        _                 => string.Empty,
    };

    // Projects whose last scheduled run failed (drives the header subtitle).
    private int FailingCount => projects.Count(p => p.LastRunStatus == "Failed");

    // Redesign state-pill colour by last run status.
    private static BrandBadgeTone StatusTone(string? status) => status switch
    {
        "Succeeded"      => BrandBadgeTone.Success,
        "Failed"         => BrandBadgeTone.Danger,
        "PartialSuccess" => BrandBadgeTone.Warning,
        "Cancelled"      => BrandBadgeTone.Warning,
        _                => BrandBadgeTone.Neutral,
    };

    // "PartialSuccess" is a raw enum from the orchestrator; show the friendly label
    // (same wording as Processing Center / Sync History) so it doesn't read as code.
    private static string LastStatusLabel(string? status) => status switch
    {
        "PartialSuccess" => "Partial Success",
        null             => "Idle",
        _                => status,
    };

    private static string LastRunText(SyncProject p)
    {
        if (!p.LastRunAt.HasValue) return "Never";
        return p.LastRunAt.Value.ToLocalTime().ToString("g");
    }

    // Next run for cron-style schedules via NCrontab, anchored at LastRunAt (or
    // now if never run) — same anchor the scheduler uses. Legacy @hourly /
    // @every:Nm shorthand and unparseable expressions fall back to a label.
    private static string NextRunText(SyncProject p)
    {
        if (!p.IsEnabled) return "—";
        var cron = p.CronSchedule;
        if (string.IsNullOrWhiteSpace(cron)) return "—";
        var s = cron.Trim();

        if (s.StartsWith("@", StringComparison.Ordinal))
        {
            // Legacy interval shorthand — interval from last run, not a wall-clock instant.
            return "On interval";
        }

        try
        {
            var schedule = CrontabSchedule.Parse(s);
            var anchor = p.LastRunAt ?? DateTime.UtcNow;
            var next = schedule.GetNextOccurrence(anchor);
            if (next < DateTime.UtcNow) next = schedule.GetNextOccurrence(DateTime.UtcNow);
            return next.ToLocalTime().ToString("g");
        }
        catch
        {
            return "Invalid";
        }
    }

    private string NextScheduledRunText
    {
        get
        {
            var next = projects
                .Where(p => p.IsEnabled && HasSchedule(p))
                .Select(TryGetNextRun)
                .Where(value => value.HasValue)
                .Select(value => value!.Value)
                .OrderBy(value => value)
                .FirstOrDefault();
            return next == default ? "None" : next.ToLocalTime().ToString("g");
        }
    }

    private static DateTime? TryGetNextRun(SyncProject project)
    {
        var cron = project.CronSchedule?.Trim();
        if (string.IsNullOrWhiteSpace(cron) || cron.StartsWith("@", StringComparison.Ordinal)) return null;
        try
        {
            var schedule = CrontabSchedule.Parse(cron);
            var anchor = project.LastRunAt ?? DateTime.UtcNow;
            var next = schedule.GetNextOccurrence(anchor);
            return next < DateTime.UtcNow ? schedule.GetNextOccurrence(DateTime.UtcNow) : next;
        }
        catch
        {
            return null;
        }
    }

    // Human-readable rendering for the common presets + a generic field-breakdown
    // fallback. Kept intentionally simple — the raw cron is shown alongside.
    private static string Humanize(string? cron)
    {
        if (string.IsNullOrWhiteSpace(cron)) return "Manual only";
        var s = cron.Trim();
        switch (s)
        {
            case "@hourly":        return "Every hour";
            case "*/15 * * * *":   return "Every 15 minutes";
            case "0 * * * *":      return "Every hour";
            case "0 */6 * * *":    return "Every 6 hours";
            case "0 2 * * *":      return "Daily at 02:00";
            case "0 2 * * 0":      return "Weekly, Sunday 02:00";
            case "0 2 1 * *":      return "Monthly, 1st at 02:00";
        }
        if (s.StartsWith("@every:", StringComparison.OrdinalIgnoreCase))
        {
            var rest = s["@every:".Length..];
            return $"Every {rest}";
        }
        return "Custom cron";
    }
}
